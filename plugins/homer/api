#!/bin/sh
# Сторож умного дома Хомер. Зовётся detour-plugin как `api <op>`: watch — раз в минуту из cron,
# card — карточка и секция, wake / test — кнопки. Ответ — JSON в stdout.
#
# Зачем на роутере: хаб тревог Хомера живёт на том же компьютере, что и дом. Умер компьютер —
# молчит и хаб, сказать об этом может только тот, кто снаружи.

S="$PLUGIN_DATA"
API_BIN=/www/cgi-bin/detour-api
VPN_PORT=19486

setting() {
    v=$(jsonfilter -i "$PLUGIN_SETTINGS" -e "@.$1" 2>/dev/null)
    printf '%s' "${v:-$2}"
}

json_str() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '; }

now() { date +%s; }

get() { cat "$S/$1" 2>/dev/null; }
put() { printf '%s' "$2" > "$S/$1"; }

host_of() { printf '%s' "$1" | sed -n 's#^[a-z]*://\([^:/]*\).*#\1#p'; }

pings() { [ -n "$1" ] && ping -c 1 -W 2 "$1" >/dev/null 2>&1; }

minutes() { echo $(( ($(now) - $1) / 60 )); }

# Telegram: напрямую, а если закрыт — через временный экземпляр движка Detour на активной
# цепочке (так же ходят подписки: трафик самого роутера мимо VPN).
tg_post() {
    curl -s -m 12 ${3:+-x "$3"} "https://api.telegram.org/bot$1/sendMessage" \
        --data-urlencode "chat_id=$(setting tg_chat)" --data-urlencode "text=$2" 2>/dev/null | grep -q '"ok":true'
}

tg_send() {
    token=$(setting tg_token)
    [ -n "$token" ] && [ -n "$(setting tg_chat)" ] || return 1
    if tg_post "$token" "$1"; then put tg_last "ok $(now)"; return 0; fi
    conf=/tmp/homer-vpn.json; data=/tmp/homer-vpn
    ok=1
    if "$API_BIN" render-mixed '' "$VPN_PORT" > "$conf" 2>/dev/null &&
        "$API_BIN" engine-check "$conf" "$data" >/dev/null 2>&1; then
        "$API_BIN" engine-run "$conf" "$data" >/dev/null 2>&1 &
        pid=$!
        # Движку нужно 2–4 с на подъём: ждём, пока откроется порт, а не наугад.
        i=0
        while [ $i -lt 8 ] && ! netstat -lnt 2>/dev/null | grep -q "127.0.0.1:$VPN_PORT "; do sleep 1; i=$((i + 1)); done
        tg_post "$token" "$1" "socks5h://127.0.0.1:$VPN_PORT" && ok=0
        kill "$pid" 2>/dev/null; sleep 1; kill -9 "$pid" 2>/dev/null
    fi
    rm -rf "$conf" "$data"
    put tg_last "$([ $ok = 0 ] && echo ok || echo fail) $(now)"
    return $ok
}

pc_mac() {
    m=$(setting pc_mac)
    [ -n "$m" ] || m=$(ip -4 neigh show "$(setting pc_ip)" 2>/dev/null | sed -n 's/.*lladdr \([0-9a-f:]*\).*/\1/p' | head -1)
    [ -n "$m" ] && put pc_mac_seen "$m"
    [ -n "$m" ] || m=$(get pc_mac_seen)
    printf '%s' "$m"
}

wake_pc() {
    mac=$(pc_mac)
    [ -n "$mac" ] || return 1
    lua - "$mac" <<'EOF'
local mac = arg[1]:gsub("[:-]", "")
if #mac ~= 12 then os.exit(1) end
local bin = mac:gsub("..", function(h) return string.char(tonumber(h, 16)) end)
local socket = require("socket")
local u = socket.udp()
u:setoption("broadcast", true)
local pkt = string.rep("\255", 6) .. string.rep(bin, 16)
for _, addr in ipairs({ "255.255.255.255", "192.168.8.255" }) do u:sendto(pkt, addr, 9) end
u:close()
EOF
}

watch() {
    url=$(setting sidecar_url http://192.168.8.240:8730)
    after=$(( $(setting down_after 3) * 60 ))
    h=$(curl -s -m 6 "$url/v1/health" 2>/dev/null)
    if [ "$(jsonfilter -s "$h" -e '@.ok' 2>/dev/null)" = true ]; then
        put health "$h"; put last_ok "$(now)"
        since=$(get down_since)
        if [ -n "$since" ] && [ "$(get alerted)" = 1 ]; then
            tg_send "🟢 Хомер снова отвечает — молчал $(minutes "$since") мин."
        fi
        rm -f "$S/down_since" "$S/alerted"
    else
        [ -n "$(get down_since)" ] || put down_since "$(now)"
        since=$(get down_since)
        if [ $(( $(now) - since )) -ge "$after" ] && [ "$(get alerted)" != 1 ]; then
            host=$(host_of "$url")
            if pings "$host"; then why="компьютер дома ($host) в сети — упал сам сайдкар или Docker"
            else why="компьютер дома ($host) не отвечает и на ping — выключен или завис"; fi
            # Не дошло — попробуем на следующем обходе.
            tg_send "⚫ Хомер молчит $(minutes "$since") мин: $why. Хаб тревог на нём же, поэтому пишет роутер." && put alerted 1
        fi
    fi
    pc=$(setting pc_ip)
    if [ -n "$pc" ]; then
        if pings "$pc"; then rm -f "$S/pc_down"; else [ -n "$(get pc_down)" ] || put pc_down "$(now)"; fi
        down=$(get pc_down)
        last=$(get wol_last); last=${last:-0}
        if [ "$(setting auto_wol false)" = true ] && [ -n "$down" ] && [ $(( $(now) - down )) -ge "$after" ] &&
            [ $(( $(now) - last )) -ge 1800 ]; then
            wake_pc && put wol_last "$(now)"
        fi
    fi
}

card() {
    h=$(get health)
    since=$(get down_since)
    if [ -n "$since" ]; then
        status="молчит $(minutes "$since") мин"; tone=bad
    elif [ -n "$h" ]; then
        status="отвечает"; tone=ok
    else
        status="ещё не проверяли"; tone=warn
    fi
    ha=$(jsonfilter -s "$h" -e '@.ha.connected' 2>/dev/null)
    nodes=$(jsonfilter -s "$h" -e '@.nodesOnline' 2>/dev/null)
    up=$(jsonfilter -s "$h" -e '@.uptimeSec' 2>/dev/null)
    pc=$(setting pc_ip)
    if [ -z "$pc" ]; then pcs="не следим"; pct=ok
    elif [ -n "$(get pc_down)" ]; then pcs="не отвечает $(minutes "$(get pc_down)") мин"; pct=warn
    else pcs="в сети"; pct=ok; fi
    tg=$(get tg_last)
    if [ -z "$(setting tg_token)" ]; then tgs="не настроен"; tgt=warn
    elif [ "${tg%% *}" = fail ]; then tgs="не доставлено"; tgt=bad
    else tgs="настроен"; tgt=ok; fi
    printf '{"ok":true,"status":{"text":"%s","tone":"%s"},' "$status" "$tone"
    printf '"lead":"%s",' "$(json_str "дом Хомера: $(setting sidecar_url http://192.168.8.240:8730)")"
    printf '"metrics":['
    printf '{"label":"Home Assistant","value":"%s","tone":"%s"},' \
        "$([ "$ha" = true ] && echo на связи || echo нет)" "$([ "$ha" = true ] && echo ok || echo bad)"
    printf '{"label":"Узлов на связи","value":"%s"},' "${nodes:-—}"
    printf '{"label":"Сайдкар работает","value":"%s"},' "$([ -n "$up" ] && echo "$((up / 3600)) ч $((up % 3600 / 60)) мин" || echo —)"
    printf '{"label":"ПК","value":"%s","tone":"%s"},' "$pcs" "$pct"
    printf '{"label":"Telegram","value":"%s","tone":"%s"}' "$tgs" "$tgt"
    printf ']}\n'
}

case "$1" in
    watch)
        watch
        [ "$PLUGIN_METHOD" = CLI ] && exit 0
        card
        ;;
    card)
        card
        ;;
    wake)
        [ "$PLUGIN_METHOD" = POST ] || { echo '{"ok":false,"error":"POST required"}'; exit 0; }
        if wake_pc; then put wol_last "$(now)"; echo '{"ok":true,"message":"Пакет Wake-on-LAN отправлен"}'
        else echo '{"ok":false,"error":"не знаю MAC ПК: впишите IP или MAC в настройках"}'; fi
        ;;
    test)
        [ "$PLUGIN_METHOD" = POST ] || { echo '{"ok":false,"error":"POST required"}'; exit 0; }
        if tg_send "🧪 Сторож Хомера на роутере: проверка связи."; then echo '{"ok":true,"message":"Отправлено"}'
        else echo '{"ok":false,"error":"Telegram не ответил ни напрямую, ни через VPN (или нет токена и чата)"}'; fi
        ;;
    install)
        mkdir -p "$S"
        ;;
    settings)
        echo '{"ok":true,"message":"Сторож Хомера: настройки сохранены"}'
        ;;
    remove|enable|disable)
        ;;
    *)
        printf '{"ok":false,"error":"неизвестное действие: %s"}\n' "$(json_str "$1")"
        ;;
esac
