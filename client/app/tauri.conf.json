{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Detour",
  "version": "2.1.0",
  "identifier": "io.github.varyen.detour",
  "build": {
    "frontendDist": "../../panel/dist-client",
    "devUrl": "http://localhost:5199/",
    "beforeDevCommand": "npm --prefix ../panel run dev:client",
    "beforeBuildCommand": "npm --prefix ../panel run build:client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Detour",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
