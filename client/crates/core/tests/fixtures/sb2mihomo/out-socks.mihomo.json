{
 "allow-lan": true,
 "dns": {
  "enable": false
 },
 "ipv6": true,
 "listeners": [
  {
   "listen": "127.0.0.1",
   "name": "mixed-in",
   "port": 19482,
   "type": "mixed",
   "udp": true
  }
 ],
 "log-level": "error",
 "mode": "rule",
 "profile": {
  "store-fake-ip": false,
  "store-selected": false
 },
 "proxies": [
  {
   "name": "proxy",
   "password": "p",
   "port": 1080,
   "server": "proxy.example.com",
   "type": "socks5",
   "udp": true,
   "username": "u"
  }
 ],
 "rules": [
  "MATCH,proxy"
 ],
 "tcp-concurrent": false,
 "unified-delay": true
}