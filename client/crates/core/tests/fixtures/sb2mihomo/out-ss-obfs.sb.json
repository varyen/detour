{
 "log": {
  "level": "error"
 },
 "inbounds": [
  {
   "type": "mixed",
   "tag": "mixed-in",
   "listen": "127.0.0.1",
   "listen_port": 19482
  }
 ],
 "outbounds": [
  {
   "type": "shadowsocks",
   "server": "vpn.example.com",
   "server_port": 8388,
   "method": "aes-256-gcm",
   "password": "pw",
   "plugin": "obfs-local",
   "plugin_opts": "obfs=tls;obfs-host=www.example.com",
   "tag": "proxy"
  },
  {
   "type": "direct",
   "tag": "direct"
  }
 ],
 "route": {
  "final": "proxy"
 }
}