{
 "allow-lan": true,
 "dns": {
  "enable": false
 },
 "ipv6": true,
 "listeners": [
  {
   "listen": "127.0.0.1",
   "name": "mixed-in",
   "port": 19482,
   "type": "mixed",
   "udp": true
  }
 ],
 "log-level": "error",
 "mode": "rule",
 "profile": {
  "store-fake-ip": false,
  "store-selected": false
 },
 "proxies": [
  {
   "client-fingerprint": "chrome",
   "name": "proxy",
   "network": "xhttp",
   "port": 8443,
   "reality-opts": {
    "public-key": "BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc",
    "short-id": "0123abcd"
   },
   "server": "vpn.example.com",
   "servername": "www.example.com",
   "tls": true,
   "type": "vless",
   "udp": true,
   "uuid": "00000000-0000-4000-8000-000000000001",
   "xhttp-opts": {
    "headers": {
     "X-Test": "1"
    },
    "host": "cdn.example.com",
    "mode": "stream-one",
    "no-grpc-header": true,
    "path": "/xhttp",
    "sc-max-each-post-bytes": 1000000,
    "sc-min-posts-interval-ms": 30,
    "x-padding-bytes": "100-1000"
   }
  }
 ],
 "rules": [
  "MATCH,proxy"
 ],
 "tcp-concurrent": false,
 "unified-delay": true
}