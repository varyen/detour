{
 "allow-lan": true,
 "dns": {
  "enable": false
 },
 "ipv6": true,
 "listeners": [
  {
   "listen": "127.0.0.1",
   "name": "mixed-in",
   "port": 19482,
   "type": "mixed",
   "udp": true
  }
 ],
 "log-level": "error",
 "mode": "rule",
 "profile": {
  "store-fake-ip": false,
  "store-selected": false
 },
 "proxies": [
  {
   "alpn": [
    "h2",
    "http/1.1"
   ],
   "client-fingerprint": "firefox",
   "name": "proxy",
   "network": "ws",
   "port": 443,
   "server": "vpn.example.com",
   "servername": "vpn.example.com",
   "skip-cert-verify": true,
   "tls": true,
   "type": "vless",
   "udp": true,
   "uuid": "00000000-0000-4000-8000-000000000001",
   "ws-opts": {
    "early-data-header-name": "Sec-WebSocket-Protocol",
    "headers": {
     "Host": "cdn.example.com"
    },
    "max-early-data": 2048,
    "path": "/ws"
   }
  }
 ],
 "rules": [
  "MATCH,proxy"
 ],
 "tcp-concurrent": false,
 "unified-delay": true
}