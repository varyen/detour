#!/bin/sh
# Точка входа контейнера Detour: подготовить OpenWrt к жизни в Docker и отдать
# управление procd.
#
# Штатный конфиг OpenWrt забирает eth0 в br-lan с 192.168.1.1 — netifd снёс бы
# адрес, который выдал Docker, и контейнер остался бы без сети. Адрес и шлюз
# читаются с eth0 здесь, до init, а применяются скриптом в /etc/uci-defaults:
# на первой загрузке /etc/config/network ещё нет, его создаёт config_generate
# уже в процессе загрузки, и uci-правка отсюда была бы затёрта. uci-defaults
# выполняются после него. LAN-моста в контейнере нет (клиенты приходят через
# VPN-сервер), br-lan остаётся пустым на служебной сети.
#
# Переменные окружения (их задаёт install.sh):
#   DETOUR_SERVER_PORT   UDP-порт VPN-сервера — тот, что опубликован на хосте
#   DETOUR_ENDPOINT      внешний адрес хоста (IP или домен) для конфигов клиентов
#   DETOUR_PANEL_WAN=1   пускать в панель всех; иначе — только сам хост

ip4=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{ print $4; exit }')
gw=$(ip -4 route show default 2>/dev/null | awk '{ print $3; exit }')

mkdir -p /etc/uci-defaults
cat > /etc/uci-defaults/99-detour-box <<EOF
#!/bin/sh
if [ -n "$ip4" ] && [ -n "$gw" ]; then
    uci -q delete network.@device[0].ports
    uci set network.lan.ipaddr='192.168.177.1/24'
    uci set network.wan=interface
    uci set network.wan.device='eth0'
    uci set network.wan.proto='static'
    uci set network.wan.ipaddr='$ip4'
    uci set network.wan.gateway='$gw'
    uci -q delete network.wan.dns
    uci add_list network.wan.dns='1.1.1.1'
    uci add_list network.wan.dns='9.9.9.9'
    uci -q delete network.wan6
    uci commit network
fi
# Панель отдаёт основной uhttpd на :80 (/detour/). Для контейнера всё снаружи —
# это wan, включая сам хост: docker-proxy приходит с адреса шлюза.
uci set firewall.detour_panel=rule
uci set firewall.detour_panel.name='detour-panel'
uci set firewall.detour_panel.src='wan'
uci set firewall.detour_panel.proto='tcp'
uci set firewall.detour_panel.dest_port='80'
uci set firewall.detour_panel.target='ACCEPT'
uci -q delete firewall.detour_panel.src_ip
if [ "${DETOUR_PANEL_WAN:-0}" != 1 ] && [ -n "$gw" ]; then
    uci set firewall.detour_panel.src_ip='$gw'
fi
uci commit firewall
exit 0
EOF
chmod 755 /etc/uci-defaults/99-detour-box

# Одиночные файлы состояния вне томов (учётка панели, стратегия zapret): том
# на файл не смонтировать, поэтому их копия живёт в томе /etc/detour/.box —
# при старте восстанавливается, раз в минуту обновляется из cron.
PERSIST="/etc/detour.auth /etc/zapret-tpws.conf"
mkdir -p /etc/detour/.box
for f in $PERSIST; do
    b=/etc/detour/.box/$(basename "$f")
    [ -s "$b" ] && cp -p "$b" "$f"
done
sync_cmd="for f in $PERSIST; do [ -s \$f ] && cp -p \$f /etc/detour/.box/; done"
mkdir -p /etc/crontabs
grep -v 'detour/.box' /etc/crontabs/root 2>/dev/null > /etc/crontabs/root.new
echo "* * * * * $sync_cmd" >> /etc/crontabs/root.new
mv /etc/crontabs/root.new /etc/crontabs/root

mkdir -p /etc/detour/server
{
    [ -n "${DETOUR_SERVER_PORT:-}" ] && echo "DEF_PORT=$DETOUR_SERVER_PORT"
    [ -n "${DETOUR_ENDPOINT:-}" ] && echo "DEF_ENDPOINT=$DETOUR_ENDPOINT"
} > /etc/detour/server/defaults

exec /sbin/init
