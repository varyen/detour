#!/bin/sh
# Точка входа контейнера Detour: подготовить OpenWrt к жизни в Docker и отдать
# управление procd.
#
# Штатный конфиг OpenWrt забирает eth0 в br-lan с 192.168.1.1 — netifd снёс бы
# адрес, который выдал Docker, и контейнер остался бы без сети. Адрес и шлюз
# читаются с eth0 здесь, до init, а применяются скриптом в /etc/uci-defaults:
# на первой загрузке /etc/config/network ещё нет, его создаёт config_generate
# уже в процессе загрузки, и uci-правка отсюда была бы затёрта. uci-defaults
# выполняются после него. LAN-моста в контейнере нет (клиенты приходят через
# VPN-сервер), br-lan остаётся пустым на служебной сети.
#
# Переменные окружения (их задаёт install.sh):
#   DETOUR_SERVER_PORT   UDP-порт VPN-сервера — тот, что опубликован на хосте
#   DETOUR_ENDPOINT      внешний адрес хоста (IP или домен) для конфигов клиентов
#   DETOUR_SUB_PORT      TCP-порт подписок клиентов, опубликованный на хосте
#   DETOUR_TLS_PORT      TCP-порт входа VLESS+TLS, опубликованный на хосте
#   DETOUR_WS_PORT       TCP-порт входа VLESS WebSocket (на 127.0.0.1 хоста)
#   DETOUR_XHTTP_PORT    TCP-порт входа VLESS xhttp (на 127.0.0.1 хоста)
#   DETOUR_HTTPS_PORT    порт панели по HTTPS внутри контейнера (опубликован тем же)
#   DETOUR_ACME=1        80-й порт хоста проброшен на ACME_PORT — сертификат
#                        выпускается из панели (HTTP-01)
#   DETOUR_PANEL_WAN=1   пускать в панель всех; иначе — только сам хост

ip4=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{ print $4; exit }')
gw=$(ip -4 route show default 2>/dev/null | awk '{ print $3; exit }')

ACME_PORT=8088
ACME_WWW=/etc/detour/.acme-www
mkdir -p "$ACME_WWW"
# Признак Linux-сервера для detour-cert и detour-api: порты, под которыми
# контейнер опубликован на хосте.
{
    echo "BOX=1"
    echo "BOX_ACME=${DETOUR_ACME:-0}"
    echo "BOX_ACME_PORT=$ACME_PORT"
    echo "BOX_ACME_WWW=$ACME_WWW"
    echo "BOX_HTTPS_PORT=${DETOUR_HTTPS_PORT:-}"
} > /etc/detour/box.conf

mkdir -p /etc/uci-defaults
cat > /etc/uci-defaults/99-detour-box <<EOF
#!/bin/sh
if [ -n "$ip4" ] && [ -n "$gw" ]; then
    uci -q delete network.@device[0].ports
    uci set network.lan.ipaddr='192.168.177.1/24'
    uci set network.wan=interface
    uci set network.wan.device='eth0'
    uci set network.wan.proto='static'
    uci set network.wan.ipaddr='$ip4'
    uci set network.wan.gateway='$gw'
    uci -q delete network.wan.dns
    uci add_list network.wan.dns='1.1.1.1'
    uci add_list network.wan.dns='9.9.9.9'
    uci -q delete network.wan6
    uci commit network
fi
# Панель отдаёт основной uhttpd на :80 (/detour/). Для контейнера всё снаружи —
# это wan, включая сам хост: docker-proxy приходит с адреса шлюза.
uci set firewall.detour_panel=rule
uci set firewall.detour_panel.name='detour-panel'
uci set firewall.detour_panel.src='wan'
uci set firewall.detour_panel.proto='tcp'
uci set firewall.detour_panel.dest_port='80'
uci set firewall.detour_panel.target='ACCEPT'
uci -q delete firewall.detour_panel.src_ip
if [ "${DETOUR_PANEL_WAN:-0}" != 1 ] && [ -n "$gw" ]; then
    uci set firewall.detour_panel.src_ip='$gw'
fi
# Выпуск сертификата из панели: 80-й порт хоста приходит сюда, на отдельный
# uhttpd, который отдаёт только каталог проверок ACME — панель за ним не видна.
if [ "${DETOUR_ACME:-0}" = 1 ]; then
    uci set uhttpd.acme=uhttpd
    uci -q delete uhttpd.acme.listen_http
    uci add_list uhttpd.acme.listen_http='0.0.0.0:$ACME_PORT'
    uci set uhttpd.acme.home='$ACME_WWW'
    uci set uhttpd.acme.rfc1918_filter='0'
    uci set uhttpd.acme.no_dirlists='1'
    uci commit uhttpd
    uci set firewall.detour_acme=rule
    uci set firewall.detour_acme.name='detour-acme'
    uci set firewall.detour_acme.src='wan'
    uci set firewall.detour_acme.proto='tcp'
    uci set firewall.detour_acme.dest_port='$ACME_PORT'
    uci set firewall.detour_acme.target='ACCEPT'
else
    uci -q delete uhttpd.acme && uci commit uhttpd
    uci -q delete firewall.detour_acme
fi
# Панель по HTTPS (после выпуска сертификата) — снаружи, под паролем панели.
# Фильтр RFC1918 uhttpd отбивал бы запросы с белых адресов на серый адрес
# контейнера; порт 80 по-прежнему пускает только хост (правило выше).
if [ -n "${DETOUR_HTTPS_PORT:-}" ]; then
    uci set uhttpd.main.rfc1918_filter='0'
    uci commit uhttpd
    uci set firewall.detour_panel_tls=rule
    uci set firewall.detour_panel_tls.name='detour-panel-https'
    uci set firewall.detour_panel_tls.src='wan'
    uci set firewall.detour_panel_tls.proto='tcp'
    uci set firewall.detour_panel_tls.dest_port='${DETOUR_HTTPS_PORT:-}'
    uci set firewall.detour_panel_tls.target='ACCEPT'
else
    uci -q delete firewall.detour_panel_tls
fi
uci commit firewall
exit 0
EOF
chmod 755 /etc/uci-defaults/99-detour-box

# Одиночные файлы состояния вне томов (учётка панели, стратегия zapret): том
# на файл не смонтировать, поэтому их копия живёт в томе /etc/detour/.box —
# при старте восстанавливается, раз в минуту обновляется из cron.
PERSIST="/etc/detour.auth /etc/zapret-tpws.conf"
mkdir -p /etc/detour/.box
for f in $PERSIST; do
    b=/etc/detour/.box/$(basename "$f")
    [ -s "$b" ] && cp -p "$b" "$f"
done
sync_cmd="for f in $PERSIST; do [ -s \$f ] && cp -p \$f /etc/detour/.box/; done"
mkdir -p /etc/crontabs
grep -v 'detour/.box' /etc/crontabs/root 2>/dev/null > /etc/crontabs/root.new
echo "* * * * * $sync_cmd" >> /etc/crontabs/root.new
mv /etc/crontabs/root.new /etc/crontabs/root

# /etc/detour — том, и /etc/detour/version в нём остаётся от прежнего образа:
# пакет в новом образе свежее, а панель и detour-update видели старую версию
# (обновление «ставилось», но проверка после установки падала). Версия — из
# базы apk этого образа.
v=$(apk info -v 2>/dev/null | sed -n 's/^detour-\([0-9][0-9.]*\)-r[0-9]*$/\1/p' | head -1)
[ -n "$v" ] && echo "$v" > /etc/detour/version

mkdir -p /etc/detour/server
{
    [ -n "${DETOUR_SERVER_PORT:-}" ] && echo "DEF_PORT=$DETOUR_SERVER_PORT"
    [ -n "${DETOUR_VLESS_PORT:-}" ] && echo "DEF_VPORT=$DETOUR_VLESS_PORT"
    [ -n "${DETOUR_ENDPOINT:-}" ] && echo "DEF_ENDPOINT=$DETOUR_ENDPOINT"
    [ -n "${DETOUR_SUB_PORT:-}" ] && echo "DEF_SPORT=$DETOUR_SUB_PORT"
    [ -n "${DETOUR_TLS_PORT:-}" ] && echo "DEF_TPORT=$DETOUR_TLS_PORT"
    [ -n "${DETOUR_WS_PORT:-}" ] && echo "DEF_WSPORT=$DETOUR_WS_PORT"
    [ -n "${DETOUR_XHTTP_PORT:-}" ] && echo "DEF_XHPORT=$DETOUR_XHTTP_PORT"
} > /etc/detour/server/defaults

exec /sbin/init
