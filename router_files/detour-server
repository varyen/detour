JMIN=$JMIN
JMAX=$JMAX
S1=$S1
S2=$S2
H1=$H1
H2=$H2
H3=$H3
H4=$H4
AWG=$AWG
VLESS=$VLESS
VPORT=$VPORT
VNET=$VNET
VSNI=$VSNI
VPRIV=$VPRIV
VPUB=$VPUB
VSID=$VSID
NDMIF=$NDMIF
UPLINK=$UPLINK
SUB=$SUB
SPORT=$SPORT
SUBURL=$SUBURL
VTLS=$VTLS
TPORT=$TPORT
TDOMAIN=$TDOMAIN
