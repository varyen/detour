#!/bin/sh
# Detour — свой VPN-сервер на роутере: AmneziaWG, клиенты получают маршруты роутера.
#
#   detour-server status                 — JSON: поддержка, состояние, клиенты
#   detour-server start | stop | apply   — поднять / погасить / пересобрать
#   detour-server set КЛЮЧ=ЗНАЧ…         — enabled port net endpoint dns mtu
#   detour-server client-add <имя> [full|lan]
#   detour-server client-set <id> КЛЮЧ=ЗНАЧ…   — name mode enabled route
#   detour-server client-del <id>
#   detour-server client-conf <id>       — .conf для приложения AmneziaWG/AmneziaVPN
#   detour-server regen-obf              — новые параметры обфускации (все клиенты
#                                          должны заново импортировать конфиг)
#   detour-server client-link <id>       — ссылка vless:// (VLESS-Reality)
#   detour-server down                   — снять всё (удаление пакета)
#
# Два входа, один набор клиентов: AmneziaWG (UDP, интерфейс $IFACE) и
# VLESS-Reality (TCP). VLESS принимает отдельный sing-box в своём сетевом
# пространстве $NS: его исходящий трафик выходит в роутер через veth $VIF и
# попадает под те же правила перехвата, что AWG-клиенты и LAN (zapret,
# «Отдельные маршруты», торренты, режим VPN) — отдельный стек правил для VLESS
# не нужен. Каждый клиент выходит со своего адреса $VNET.<octet>: по нему
# считается его трафик (цепочки mangle $ACCT_IN/$ACCT_OUT). Вход с WAN —
# DNAT на $VNET.254:$VPORT (uci redirect), адрес клиента сохраняется.
#
# Маршрутизация. Интерфейс сервера ($IFACE) кладётся в "vpn_redirect_ifaces"
# settings.json — тот же механизм, что и для WG-сервера GL: sing-box, zapret,
# «Отдельные маршруты», запрет торрентов вешают на него те же правила, что на
# br-lan. Из списка он больше не убирается: правила на несуществующий интерфейс
# ничего не ловят, а снятие потребовало бы снимать их до правки списка (стоп
# sing-box перебирает ТЕКУЩИЙ список).
#
# Ядро. На GL.iNet kmod-amneziawg + amneziawg-tools лежат в штатном фиде
# прошивки (AWG 2.0). На чистой OpenWrt — userspace detour-awg-go из фида Detour.
# На Keenetic — встроенный WireGuard KeeneticOS с обфускацией ASC (компонент
# «WireGuard VPN»): интерфейс WireguardN (в ядре nwgN) собирается командами CLI
# через RCI на localhost:79, а без компонента — тот же userspace detour-awg-go
# (на MT7621 замерено ~30 Мбит/с против ~80 у встроенного). Файрвол Keenetic —
# свои правила (`fw`), их же переставляет netfilter-хук после перестроек NDM.
#
# Хранение: $DIR/server.conf (shell KEY=VAL) и $DIR/clients.list:
#   id|enabled|name|octet|pubkey|privkey|psk|mode|created|uuid|route
# (pubkey пуст, пока на платформе нет AWG; uuid — пользователь VLESS; route —
# пусто = правила роутера, direct = мимо VPN, vpn:<профиль|цепочка>. Маршрут
# исполняет механизм «Правила → Устройства»: detour-api добавляет клиента в
# devices.map по его адресам $NET.N и $VNET.N.)
# Приватный ключ клиента хранится, чтобы конфиг/QR можно было показать повторно
# (так же делает GL). Каталог 0700, под /etc/detour → keeplist sysupgrade.

IFACE=dsrv0
ZONE=detour_srv
NS=detour-srv
VIF=dsrv1
VPEER=dsrv1p
VIF2=dsrv2
VPEER2=dsrv2p
LINKNET=169.254.67
NS_TABLE=166
ACCT_IN=DSRV_VIN
ACCT_OUT=DSRV_VOUT
CLASH=127.0.0.1:9095
RULE_PREF=11990

if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    KEENETIC=1
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    DIR=/opt/etc/detour/server
    SETTINGS=/opt/etc/sing-box/settings.json
    RUN=/opt/var/run
    LOG=/opt/var/log/detour-server.log
    LAN_IF=br0
    WANPIN_BIN=/opt/sbin/detour-wanpin
    CERT_CONF=/opt/etc/detour/cert.conf
    RCI=http://localhost:79/rci/
    KIP=/opt/sbin/ip
    HOOK=/opt/etc/ndm/netfilter.d/50-detour.sh
else
    KEENETIC=0
    DIR=/etc/detour/server
    SETTINGS=/etc/sing-box/settings.json
    RUN=/var/run
    LOG=/var/log/detour-server.log
    LAN_IF=br-lan
    WANPIN_BIN=/usr/sbin/detour-wanpin
    CERT_CONF=/etc/detour/cert.conf
fi
# Нет утилиты awg (чистая OpenWrt с userspace-пакетом detour-awg-go) — её
# подмножество встроено в наш amneziawg-go.
if ! command -v awg >/dev/null 2>&1 && command -v amneziawg-go >/dev/null 2>&1 && \
        amneziawg-go awg genpsk 2>/dev/null | grep -qE '^[A-Za-z0-9+/]{43}=$'; then
    awg() { amneziawg-go awg "$@"; }
fi

CONF="$DIR/server.conf"
CLIENTS="$DIR/clients.list"
RENDER="$RUN/detour-server.conf"
LOCK="$RUN/detour-server.lock"
# Статистика. Рабочая копия — в RAM (tick раз в минуту), на флеш — раз в
# $FLUSH_MIN минут и на каждом событии сессии, чтобы не изнашивать флеш.
#   traffic: id|lrx|ltx|trx|ttx|mon|mrx|mtx|day|drx|dtx|online|sstart|srx|stx|seen|remote|vlrx|vltx
#   (lrx/ltx — последние показания счётчиков AWG, vlrx/vltx — VLESS; rx — от
#   клиента, tx — к клиенту)
#   sessions.log: id|start|end|rx|tx|remote — последние $SESS_KEEP сессий
TRAFFIC="$DIR/traffic"
SESSIONS="$DIR/sessions.log"
STATS_RAM="$RUN/detour-server.traffic"
VRENDER="$RUN/detour-vless.json"
VPID="$RUN/detour-vless.pid"
VLOG="$RUN/detour-vless.log"
VACT="$RUN/detour-server.vact"
VACCT_SIG="$RUN/detour-server.vacct"
ONLINE_SEC=180
FLUSH_MIN=30
SESS_KEEP=500

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

json_esc() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'
}

err() { printf '{"ok":false,"error":"%s"}\n' "$(json_esc "$1")"; exit 0; }

lock() {
    mkdir -p "$RUN"
    i=0
    while ! mkdir "$LOCK" 2>/dev/null; do
        i=$((i + 1))
        # Брошенный замок (процесс убит) — не вечная блокировка.
        [ "$i" -ge 30 ] && { rm -rf "$LOCK"; continue; }
        sleep 1
    done
    trap 'rm -rf "$LOCK"' EXIT INT TERM
}

# ---------- поддержка платформы ----------

# Пустой вывод = поддерживается; иначе причина.
unsupported_reason() {
    if [ "$KEENETIC" = 0 ]; then
        command -v awg >/dev/null 2>&1 || { echo "not_installed"; return; }
    fi
    [ -n "$(backend)" ] || echo "not_installed"
}

# kernel — модуль amneziawg (GL.iNet); ndm — встроенный WireGuard KeeneticOS;
# userspace — amneziawg-go на /dev/net/tun (чистая OpenWrt, Detour в контейнере
# на Linux-сервере, Keenetic без компонента WireGuard).
backend() {
    if [ "$KEENETIC" = 1 ]; then
        if ndm_wg; then echo ndm; return; fi
    elif lsmod 2>/dev/null | grep -q '^amneziawg ' || modprobe amneziawg 2>/dev/null; then
        echo kernel; return
    fi
    if command -v amneziawg-go >/dev/null 2>&1 && [ -c /dev/net/tun ]; then
        echo userspace
    fi
}

# Есть ли пакеты в доступных фидах (для кнопки «Установить»).
installable() {
    if [ "$KEENETIC" = 1 ]; then
        # detour-awg-go лежит в mipsel-фиде Detour; ставит detour-update curl'ом.
        [ -c /dev/net/tun ]
        return
    fi
    if [ -f /etc/apk/world ] && command -v apk >/dev/null 2>&1; then
        apk search -e kmod-amneziawg 2>/dev/null | grep -q . && return 0
    else
        opkg list kmod-amneziawg 2>/dev/null | grep -q . && return 0
    fi
    # Модуля в фиде прошивки нет — detour-update поставит userspace
    # detour-awg-go из фида Detour; ему нужен только TUN.
    [ -c /dev/net/tun ] || modprobe tun 2>/dev/null
}

awg_ok() { [ -z "$(unsupported_reason)" ]; }

# VLESS: нужен sing-box и ip с netns (ip-full; у busybox ip его нет).
# Пустой вывод = поддерживается; netns — не хватает ip-full.
vless_reason() {
    sb=$(vless_sb)
    [ -n "$sb" ] || { echo "sing-box не установлен"; return; }
    # Reality-сервер sing-box 1.13.x отвергает всех клиентов («processed
    # invalid connection», проверено и на upstream 1.13.21), 1.14 — работает.
    # Родной фид OpenWrt 25.12 пока даёт 1.13.x.
    v=$("$sb" version 2>/dev/null | sed -n '1s/.*version \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
    set -- $v
    if [ -n "$2" ] && [ "$1" -eq 1 ] && [ "$2" -lt 14 ]; then
        echo "Для VLESS-Reality нужен sing-box 1.14 или новее, здесь $1.$2"
        return
    fi
    # Keenetic: сетевых пространств в ядре нет — вход живёт в общем, а нужны
    # veth, onlink и `ip rule … iif lo` из ip-full (у busybox ip их нет).
    if [ "$KEENETIC" = 1 ]; then
        [ -x "$KIP" ] || echo netns
        return
    fi
    ip netns list >/dev/null 2>&1 || echo netns
}

# Бинарник входа VLESS: отдельный sing-box-vless (образ Linux-сервера кладёт
# upstream 1.14, не трогая пакет прошивки), иначе общий.
vless_sb() {
    command -v sing-box-vless 2>/dev/null || command -v sing-box 2>/dev/null
}

vless_ok() { [ -z "$(vless_reason)" ]; }

ipfull_installable() {
    [ "$KEENETIC" = 1 ] && return 0
    if [ -f /etc/apk/world ] && command -v apk >/dev/null 2>&1; then
        apk search -e ip-full 2>/dev/null | grep -q .
    else
        opkg list ip-full 2>/dev/null | grep -q .
    fi
}

# Ключи WireGuard: awg, а без него (встроенный WireGuard Keenetic) — sing-box.
# Результат — в KP_PRIV/KP_PUB.
wg_keypair() {
    KP_PRIV=""; KP_PUB=""
    if command -v awg >/dev/null 2>&1; then
        KP_PRIV=$(awg genkey) && KP_PUB=$(printf '%s' "$KP_PRIV" | awg pubkey)
    else
        kp=$(sing-box generate wg-keypair 2>/dev/null)
        KP_PRIV=$(printf '%s\n' "$kp" | sed -n 's/^PrivateKey: *//p')
        KP_PUB=$(printf '%s\n' "$kp" | sed -n 's/^PublicKey: *//p')
    fi
    [ -n "$KP_PRIV" ] && [ -n "$KP_PUB" ]
}

wg_psk() {
    if command -v awg >/dev/null 2>&1; then awg genpsk
    else sing-box generate rand 32 --base64 2>/dev/null
    fi
}

# ---------- конфиг ----------

rand_u32() {
    hexdump -n 4 -v -e '/4 "%u"' /dev/urandom 2>/dev/null || \
        od -An -N4 -tu4 /dev/urandom | tr -d ' '
}

rand_range() {  # $1 min $2 max
    r=$(rand_u32)
    echo $(( $1 + r % ($2 - $1 + 1) ))
}

port_busy() {
    netstat -lnu 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" { f = 1 } END { exit !f }'
}

# TCP-порт VLESS: DNAT с WAN перекрыл бы снаружи любой слушающий его сервис
# роутера (nginx на 443 и т. п.) и любой чужой проброс того же порта.
tcp_port_busy() {
    netstat -lnt 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" { f = 1 } END { exit !f }' && return 0
    command -v uci >/dev/null 2>&1 || return 1
    uci -q show firewall 2>/dev/null | grep -v "^firewall\.${ZONE}_vin\." | \
        grep -qE "\.(src_dport|dest_port)='$1'$"
}

gen_obf() {
    JC=$(rand_range 4 10)
    JMIN=$(rand_range 40 80)
    JMAX=$(rand_range 300 800)
    S1=$(rand_range 15 120)
    # S1 + 56 == S2 делает init и response одной длины — запрещено протоколом.
    while :; do
        S2=$(rand_range 15 120)
        [ $((S1 + 56)) -ne "$S2" ] && [ "$S1" -ne "$S2" ] && break
    done
    # H1..H4 различны и не попадают в 1..4 (типы сообщений обычного WireGuard).
    H1=$(rand_range 5 2147483647)
    while :; do H2=$(rand_range 5 2147483647); [ "$H2" != "$H1" ] && break; done
    while :; do H3=$(rand_range 5 2147483647); [ "$H3" != "$H1" ] && [ "$H3" != "$H2" ] && break; done
    while :; do H4=$(rand_range 5 2147483647); [ "$H4" != "$H1" ] && [ "$H4" != "$H2" ] && [ "$H4" != "$H3" ] && break; done
}

save_conf() {
    umask 077
    cat > "$CONF.tmp" <<EOF
ENABLED=$ENABLED
PORT=$PORT
NET=$NET
ENDPOINT=$ENDPOINT
DNS=$DNS
MTU=$MTU
PRIVKEY=$PRIVKEY
PUBKEY=$PUBKEY
JC=$JC
JMIN=$JMIN
JMAX=$JMAX
S1=$S1
S2=$S2
H1=$H1
H2=$H2
H3=$H3
H4=$H4
AWG=$AWG
VLESS=$VLESS
VPORT=$VPORT
VNET=$VNET
VSNI=$VSNI
VPRIV=$VPRIV
VPUB=$VPUB
VSID=$VSID
NDMIF=$NDMIF
EOF
    mv "$CONF.tmp" "$CONF"
}

# Свободная /24 из 10.66–10.99, не пересекающаяся с маршрутами роутера.
pick_net() {  # $1 — подсеть, которую тоже обходить
    for b in 66 67 68 69 77 88 99; do
        [ "10.$b.0" = "$1" ] && continue
        ip -4 route 2>/dev/null | grep -q "^10\.$b\." && continue
        ip -4 addr 2>/dev/null | grep -q "inet 10\.$b\." && continue
        echo "10.$b.0"; return
    done
    echo "10.66.0"
}

load_conf() {
    ENABLED=0; PORT=""; NET=""; ENDPOINT=""; DNS=""; MTU=""
    PRIVKEY=""; PUBKEY=""
    AWG=1; VLESS=0; VPORT=""; VNET=""; VSNI=""; VPRIV=""; VPUB=""; VSID=""; NDMIF=""
    [ -f "$CONF" ] && . "$CONF"
    set_iface
}

load_defaults() {
    # Detour в контейнере (linux/): порты обязаны совпасть с опубликованными, а
    # адрес — быть внешним адресом хоста. Их кладёт стартовый скрипт контейнера.
    DEF_PORT=""; DEF_VPORT=""; DEF_ENDPOINT=""
    [ -f "$DIR/defaults" ] && . "$DIR/defaults"
    case "$DEF_PORT" in ''|*[!0-9]*) DEF_PORT="" ;; esac
    case "$DEF_VPORT" in ''|*[!0-9]*) DEF_VPORT="" ;; esac
}

# Первичная инициализация: порт, подсеть, обфускация, затем ключи того входа,
# который на этой платформе доступен (AWG и VLESS независимы: на OpenWrt без
# kmod-amneziawg работает один VLESS).
ensure_conf() {
    load_conf
    ar=$(unsupported_reason)
    if [ -n "$ar" ] && ! vless_ok; then
        case "$ar" in
            not_installed) err "AmneziaWG не установлен — сначала установите его в панели" ;;
            *) err "$ar" ;;
        esac
    fi
    mkdir -p "$DIR"; chmod 700 "$DIR"
    load_defaults
    changed=0
    if [ -z "$PORT" ]; then
        if [ -n "$DEF_PORT" ]; then
            PORT=$DEF_PORT
        else
            while :; do
                PORT=$(rand_range 20000 60000)
                port_busy "$PORT" || break
            done
        fi
        valid_ipv4_host "$DEF_ENDPOINT" && ENDPOINT=$DEF_ENDPOINT
        NET=$(pick_net)
        MTU=1376
        gen_obf
        ENABLED=0
        [ -f "$CLIENTS" ] || { : > "$CLIENTS"; chmod 600 "$CLIENTS"; }
        changed=1
        log "init: port=$PORT net=$NET.0/24"
    fi
    if [ -z "$ar" ] && [ -z "$PRIVKEY" ]; then
        wg_keypair || err "не удалось сгенерировать ключ сервера"
        PRIVKEY=$KP_PRIV; PUBKEY=$KP_PUB
        changed=1
    fi
    if vless_ok && [ -z "$VPRIV" ]; then
        kp=$("$(vless_sb)" generate reality-keypair 2>/dev/null)
        VPRIV=$(printf '%s\n' "$kp" | sed -n 's/^PrivateKey: *//p')
        VPUB=$(printf '%s\n' "$kp" | sed -n 's/^PublicKey: *//p')
        [ -n "$VPRIV" ] && [ -n "$VPUB" ] || err "sing-box generate reality-keypair не сработал"
        VSID=$("$(vless_sb)" generate rand 8 --hex 2>/dev/null | tr -cd '0-9a-f')
        [ -n "$VSID" ] || VSID=$(new_id)$(new_id)
        VSNI=${VSNI:-www.microsoft.com}
        VNET=$(pick_net "$NET")
        if [ -n "$DEF_VPORT" ]; then
            VPORT=$DEF_VPORT
        elif ! tcp_port_busy 443; then
            VPORT=443
        else
            while :; do
                VPORT=$(rand_range 20000 60000)
                tcp_port_busy "$VPORT" || break
            done
        fi
        changed=1
        log "init vless: port=$VPORT net=$VNET.0/24"
    fi
    [ "$changed" = 1 ] && save_conf
    fill_clients
}

# Ключи AWG и uuid VLESS у клиентов, заведённых, пока соответствующий вход был
# недоступен (или до версии с VLESS).
fill_clients() {
    [ -s "$CLIENTS" ] || return 0
    need_awg=0; awg_ok && need_awg=1
    awk -F'|' -v a="$need_awg" '(a == 1 && $5 == "") || $10 == "" { f = 1 } END { exit !f }' "$CLIENTS" || return 0
    umask 077
    : > "$CLIENTS.tmp"
    while IFS='|' read -r id en name octet pub priv psk mode created uuid route; do
        [ -n "$id" ] || continue
        if [ "$need_awg" = 1 ] && [ -z "$pub" ] && wg_keypair; then
            priv=$KP_PRIV; pub=$KP_PUB; psk=$(wg_psk)
        fi
        [ -n "$uuid" ] || uuid=$(new_uuid)
        printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$id" "$en" "$name" "$octet" "$pub" "$priv" "$psk" "$mode" "$created" "$uuid" "$route" >> "$CLIENTS.tmp"
    done < "$CLIENTS"
    mv "$CLIENTS.tmp" "$CLIENTS"
}

new_uuid() { cat /proc/sys/kernel/random/uuid; }

server_ip() { echo "$NET.1"; }

lan_cidr() {
    ip -4 -o addr show "$LAN_IF" 2>/dev/null | awk '{ print $4; exit }' | \
        awk -F'[./]' 'NF == 5 {
            m = $5; n = ($1 * 16777216) + ($2 * 65536) + ($3 * 256) + $4
            s = 2 ^ (32 - m); n = int(n / s) * s
            printf "%d.%d.%d.%d/%d\n", int(n / 16777216) % 256, int(n / 65536) % 256, int(n / 256) % 256, n % 256, m
        }'
}

wan_ip() {
    _ip=$([ -x "$WANPIN_BIN" ] && "$WANPIN_BIN" public-ip 2>/dev/null)
    case "$_ip" in ''|*[!0-9.]*) _ip="" ;; esac
    [ -n "$_ip" ] || _ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p' | head -1)
    printf '%s' "$_ip"
}

# Серый адрес — снаружи до него не достучаться (нужен белый IP или проброс).
ip_private() {
    case "$1" in
        10.*|192.168.*|127.*|169.254.*) return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
        100.*)
            o=$(echo "$1" | cut -d. -f2)
            [ "$o" -ge 64 ] && [ "$o" -le 127 ] && return 0 ;;
    esac
    return 1
}

panel_domain() {
    [ -f "$CERT_CONF" ] && ( . "$CERT_CONF" 2>/dev/null; printf '%s' "${DOMAIN#\*.}" )
}

endpoint_host() {
    if [ -n "$ENDPOINT" ]; then printf '%s' "$ENDPOINT"; else wan_ip; fi
}

# ---------- клиенты ----------

new_id() {
    hexdump -n 4 -v -e '/1 "%02x"' /dev/urandom 2>/dev/null || \
        od -An -N4 -tx1 /dev/urandom | tr -d ' \n'
}

clean_name() {
    printf '%s' "$1" | tr -d '|"\\\000-\037' | cut -c1-48
}

free_octet() {
    o=2
    while [ "$o" -le 254 ]; do
        awk -F'|' -v o="$o" '$4 == o { f = 1 } END { exit !f }' "$CLIENTS" 2>/dev/null || { echo "$o"; return; }
        o=$((o + 1))
    done
}

client_line() { awk -F'|' -v id="$1" '$1 == id' "$CLIENTS" 2>/dev/null | head -1; }

# ---------- применение ----------

render() {
    umask 077
    {
        printf '[Interface]\nPrivateKey = %s\nListenPort = %s\n' "$PRIVKEY" "$PORT"
        printf 'Jc = %s\nJmin = %s\nJmax = %s\nS1 = %s\nS2 = %s\n' "$JC" "$JMIN" "$JMAX" "$S1" "$S2"
        printf 'H1 = %s\nH2 = %s\nH3 = %s\nH4 = %s\n' "$H1" "$H2" "$H3" "$H4"
        awk -F'|' -v net="$NET" '$2 == 1 && $5 != "" {
            printf "\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s.%s/32\n", $5, $7, net, $4
        }' "$CLIENTS" 2>/dev/null
    } > "$RENDER"
}

redirect_ifaces_cur() {
    sed -n 's/.*"vpn_redirect_ifaces"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SETTINGS" 2>/dev/null | head -1
}

redirect_has_iface() {  # $1 — интерфейс (по умолчанию AWG)
    redirect_ifaces_cur | tr ', ' '\n\n' | grep -qx "${1:-$IFACE}"
}

# Добавить интерфейсы в vpn_redirect_ifaces и перевесить правила перехвата
# (одним reconfigure на все).
redirect_attach() {
    [ -f "$SETTINGS" ] || return 0
    add=""
    for i in "$@"; do redirect_has_iface "$i" || add="$add $i"; done
    [ -n "$add" ] || return 0
    if grep -q '"vpn_redirect_ifaces"' "$SETTINGS"; then
        new=$(echo "$(redirect_ifaces_cur) $add" | tr ',' ' ' | awk '{ $1 = $1; print }')
        sed -i "s/\(\"vpn_redirect_ifaces\"[[:space:]]*:[[:space:]]*\"\)[^\"]*\"/\1$new\"/" "$SETTINGS"
    else
        new=$(echo "$add" | awk '{ $1 = $1; print }')
        awk -v i="$new" '!d && /\{/ { sub(/\{/, "{\n  \"vpn_redirect_ifaces\": \"" i "\","); d = 1 } { print }' \
            "$SETTINGS" > "$SETTINGS.tmp" && mv "$SETTINGS.tmp" "$SETTINGS"
    fi
    for i in $add; do
        redirect_has_iface "$i" || { log "не удалось вписать $i в $SETTINGS"; return 1; }
    done
    log "vpn_redirect_ifaces +=$add, перевешиваю перехват"
    if [ "$KEENETIC" = 1 ]; then
        [ -x "$HOOK" ] && "$HOOK" iptables nat >/dev/null 2>&1
        return 0
    fi
    # reconfigure — отказоустойчивый перезапуск (правила LAN не снимаются).
    if [ -x /etc/init.d/sing-box ] && /etc/init.d/sing-box running >/dev/null 2>&1; then
        /etc/init.d/sing-box reconfigure >/dev/null 2>&1
    fi
    if [ -x /usr/sbin/detour-bypass ]; then
        m=$(/usr/sbin/detour-bypass mode 2>/dev/null)
        [ -n "$m" ] && [ "$m" != off ] && /usr/sbin/detour-bypass set "$m" >/dev/null 2>&1
    fi
    return 0
}

awg_on() { [ "$ENABLED" = 1 ] && [ "$AWG" = 1 ] && [ -n "$PRIVKEY" ]; }
vless_on() { [ "$ENABLED" = 1 ] && [ "$VLESS" = 1 ] && [ -n "$VPRIV" ] && [ -n "$VPORT" ]; }

# Зона файрвола + вход с WAN (UDP AWG, DNAT TCP на VLESS). Пишем uci только при
# расхождении, чтобы не дёргать reload firewall на каждом apply.
fw_apply() {
    [ "$KEENETIC" = 1 ] && { keen_fw; return 0; }
    changed=0
    want() {  # $1 key  $2 value
        [ "$(uci -q get "firewall.$1")" = "$2" ] && return
        uci -q set "firewall.$1=$2"; changed=1
    }
    want "$ZONE" zone
    want "$ZONE.name" "$ZONE"
    if [ "$(uci -q get "firewall.$ZONE.device")" != "$IFACE $VIF $VIF2" ]; then
        uci -q delete "firewall.$ZONE.device"
        uci -q add_list "firewall.$ZONE.device=$IFACE"
        uci -q add_list "firewall.$ZONE.device=$VIF"
        uci -q add_list "firewall.$ZONE.device=$VIF2"
        changed=1
    fi
    want "$ZONE.input" ACCEPT
    want "$ZONE.output" ACCEPT
    want "$ZONE.forward" REJECT
    want "$ZONE.mtu_fix" 1
    want "${ZONE}_wan" forwarding
    want "${ZONE}_wan.src" "$ZONE"
    want "${ZONE}_wan.dest" wan
    want "${ZONE}_lan" forwarding
    want "${ZONE}_lan.src" "$ZONE"
    want "${ZONE}_lan.dest" lan
    want "${ZONE}_in" rule
    want "${ZONE}_in.name" detour-server
    want "${ZONE}_in.src" wan
    want "${ZONE}_in.proto" udp
    want "${ZONE}_in.dest_port" "$PORT"
    want "${ZONE}_in.target" ACCEPT
    want "${ZONE}_in.enabled" "$(awg_on && echo 1 || echo 0)"
    if [ -n "$VPORT" ] && [ -n "$VNET" ]; then
        want "${ZONE}_vin" redirect
        want "${ZONE}_vin.name" detour-server-vless
        want "${ZONE}_vin.src" wan
        want "${ZONE}_vin.proto" tcp
        want "${ZONE}_vin.src_dport" "$VPORT"
        want "${ZONE}_vin.dest" "$ZONE"
        want "${ZONE}_vin.dest_ip" "$VNET.254"
        want "${ZONE}_vin.dest_port" "$VPORT"
        want "${ZONE}_vin.target" DNAT
        want "${ZONE}_vin.enabled" "$(vless_on && echo 1 || echo 0)"
    fi
    if [ "$changed" = 1 ]; then
        uci commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1
        log "firewall: зона $ZONE обновлена (awg $PORT, vless ${VPORT:-—}, enabled=$ENABLED)"
    fi
}

fw_remove() {
    [ "$KEENETIC" = 1 ] && { ENABLED=0; keen_fw; return 0; }
    uci -q get "firewall.$ZONE" >/dev/null || return 0
    for s in "$ZONE" "${ZONE}_wan" "${ZONE}_lan" "${ZONE}_in" "${ZONE}_vin"; do
        uci -q delete "firewall.$s"
    done
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1
}

iface_up() { ip link show "$IFACE" >/dev/null 2>&1; }

awg_down() {
    if [ "$KEENETIC" = 1 ] && [ -n "$NDMIF" ] && ndm_wg; then
        ndm_cli "no interface $NDMIF" >/dev/null 2>&1
    fi
    ip link show dsrv0 >/dev/null 2>&1 && ip link del dsrv0 2>/dev/null
    rm -f "$RENDER"
}

awg_up() {
    r=$(unsupported_reason)
    [ -z "$r" ] || { log "apply: $r"; return 1; }
    if [ "$(backend)" = ndm ]; then
        ndm_up
        return
    fi
    render
    if ! iface_up; then
        if [ "$(backend)" = kernel ]; then
            ip link add "$IFACE" type amneziawg || { log "ip link add $IFACE не удался"; return 1; }
        else
            mkdir -p /var/run/amneziawg
            # Демонизируется сам; интерфейс удалили — процесс выходит.
            amneziawg-go "$IFACE" >>"$LOG" 2>&1 || { log "amneziawg-go не запустился"; return 1; }
            i=0
            while [ ! -S "/var/run/amneziawg/$IFACE.sock" ] && [ "$i" -lt 30 ]; do sleep 0.2 2>/dev/null || sleep 1; i=$((i + 1)); done
        fi
        awg setconf "$IFACE" "$RENDER" || { log "awg setconf не удался"; ip link del "$IFACE"; return 1; }
    else
        # syncconf не рвёт сессии подключённых клиентов.
        awg syncconf "$IFACE" "$RENDER" 2>/dev/null || awg setconf "$IFACE" "$RENDER" || return 1
    fi
    # У busybox ip (Keenetic) нет replace.
    ip addr replace "$(server_ip)/24" dev "$IFACE" 2>/dev/null || \
        ip addr add "$(server_ip)/24" dev "$IFACE" 2>/dev/null
    ip link set "$IFACE" mtu "${MTU:-1376}" up
}

# ---------- Keenetic: встроенный WireGuard через RCI ----------

# Интерфейс AWG: встроенный WireGuard KeeneticOS зовёт WireguardN в ядре nwgN.
set_iface() {
    IFACE=dsrv0
    [ "$KEENETIC" = 1 ] || return 0
    # Здесь, в основной оболочке, заполняется кэш NDM_COMP: дальше backend()
    # зовётся из $(…), и без него каждый вызов шёл бы в RCI заново.
    ndm_wg && [ -n "$NDMIF" ] && IFACE="nwg${NDMIF#Wireguard}"
    return 0
}

rci() {  # $1 — тело запроса (JSON)
    wget -q -T 20 -O - --header 'Content-Type: application/json' --post-data "$1" "$RCI" 2>/dev/null
}

# Установлен ли компонент «WireGuard VPN» (ответ кэшируется на вызов скрипта).
ndm_wg() {
    [ "$KEENETIC" = 1 ] || return 1
    [ -n "$NDM_COMP" ] || NDM_COMP=",$(wget -q -T 10 -O - "${RCI}show/version" 2>/dev/null | \
        sed -n 's/.*"components": *"\([^"]*\)".*/\1/p' | head -1),"
    case "$NDM_COMP" in *,wireguard,*) return 0 ;; esac
    return 1
}

# ndm_cli <команда CLI>… — одним запросом; код 1, если роутер ответил ошибкой
# хотя бы на одну (тексты ошибок — в лог).
ndm_cli() {
    body=""
    for c in "$@"; do body="$body${body:+,}{\"parse\":\"$(json_esc "$c")\"}"; done
    r=$(rci "[$body]")
    [ -n "$r" ] || { log "ndm: RCI на localhost:79 не ответил"; return 1; }
    if printf '%s' "$r" | grep -q '"status": *"error"'; then
        log "ndm: $(printf '%s' "$r" | grep -A3 '"status": *"error"' | sed -n 's/.*"message": *"\([^"]*\)".*/\1/p' | head -3 | tr '\n' ';')"
        return 1
    fi
}

# Свободное имя WireguardN (верхние номера — чтобы не путаться с туннелями,
# которые владелец заводит в веб-интерфейсе с нуля).
ndm_pick_if() {
    for n in 7 8 9 6 5 4 3 2; do
        r=$(rci "{\"parse\":\"show interface Wireguard$n\"}")
        [ -n "$r" ] || return
        printf '%s' "$r" | grep -q '"status": *"error"' && { echo "Wireguard$n"; return; }
    done
}

# Пиры интерфейса строками `awg show dump` (без первой): ключ, psk, адрес,
# allowed, рукопожатие (unix-время), rx, tx. KeeneticOS отдаёт рукопожатие как
# «секунд назад»; имена полей ищем по всему ответу, а не по фиксированному пути.
ndm_dump() {
    [ -n "$NDMIF" ] || return 0
    rci "{\"parse\":\"show interface $NDMIF\"}" | SRVPUB="$PUBKEY" lua -e '
        local ok, c = pcall(require, "cjson.safe"); if not ok then ok, c = pcall(require, "cjson") end
        if not ok then return end
        local t = c.decode(io.read("*a")); if type(t) ~= "table" then return end
        local now, srv = os.time(), os.getenv("SRVPUB") or ""
        local function iskey(v) return type(v) == "string" and #v == 44 and v:match("^[%w+/]+=$") end
        local function key(o)
            for _, k in ipairs({"public-key", "key", "peer"}) do if iskey(o[k]) then return o[k] end end
            for _, v in pairs(o) do if iskey(v) then return v end end
        end
        local function ep(o)
            local e = o.endpoint or o.remote
            if type(e) == "table" then
                local a = e.address or e.ip or e.host
                if a then return a .. (e.port and (":" .. e.port) or "") end
            elseif type(e) == "string" then return e end
            return ""
        end
        local function walk(o)
            if type(o) ~= "table" then return end
            local k = o.rxbytes ~= nil and key(o)
            if k and k ~= srv then
                local h = tonumber(o["last-handshake"]) or 0
                local hs = (h > 0 and h < 315360000) and (now - h) or 0
                io.write(k, "\t\t", ep(o), "\t\t", hs, "\t", string.format("%.0f", tonumber(o.rxbytes) or 0),
                    "\t", string.format("%.0f", tonumber(o.txbytes) or 0), "\n")
                return
            end
            for _, v in pairs(o) do walk(v) end
        end
        walk(t)'
}

ndm_up() {
    if [ -z "$NDMIF" ]; then
        NDMIF=$(ndm_pick_if)
        [ -n "$NDMIF" ] || { log "ndm: нет свободного WireguardN (или RCI не отвечает)"; return 1; }
        save_conf; set_iface
        log "ndm: интерфейс сервера — $NDMIF ($IFACE)"
    fi
    # Остался userspace-интерфейс от времени до установки компонента.
    ip link show dsrv0 >/dev/null 2>&1 && ip link del dsrv0 2>/dev/null
    # Лишний пир (клиента выключили или удалили) снимается пересозданием
    # интерфейса: так не зависим от синтаксиса удаления пира в CLI.
    want=$(awk -F'|' '$2 == 1 && $5 != "" { print $5 }' "$CLIENTS" 2>/dev/null)
    if iface_up; then
        for k in $(ndm_dump | cut -f1); do
            printf '%s\n' "$want" | grep -qxF "$k" && continue
            log "ndm: пир $(printf '%.8s' "$k")… больше не нужен — пересоздаю $NDMIF"
            ndm_cli "no interface $NDMIF"
            break
        done
    fi
    i="interface $NDMIF"
    set -- "$i" "$i description detour-server" "$i security-level private" \
        "$i ip address $NET.1 255.255.255.0" "$i ip mtu ${MTU:-1376}" \
        "$i wireguard listen-port $PORT" "$i wireguard private-key $PRIVKEY" \
        "$i wireguard asc $JC $JMIN $JMAX $S1 $S2 $H1 $H2 $H3 $H4"
    # Свои имена: id/pub/… — глобальные у вызывающих (client-add печатает id
    # после do_apply).
    while IFS='|' read -r _id _en _nm _oc _pub _pv _psk _rest; do
        [ "$_en" = 1 ] && [ -n "$_pub" ] || continue
        set -- "$@" "$i wireguard peer $_pub" "$i wireguard peer $_pub preshared-key $_psk" \
            "$i wireguard peer $_pub allow-ips $NET.$_oc 255.255.255.255"
    done < "$CLIENTS"
    set -- "$@" "$i up"
    ndm_cli "$@" || { log "ndm: $NDMIF не собран"; return 1; }
    ndm_cli "$i ip tcp adjust-mss pmtu" || :
    n=0; while ! iface_up && [ "$n" -lt 10 ]; do sleep 1; n=$((n + 1)); done
    iface_up || { log "ndm: $NDMIF создан, но $IFACE в ядре не появился"; return 1; }
}

# Файрвол Keenetic. INPUT у NDM по умолчанию DROP, NAT для чужого интерфейса он
# не делает: открываем порт сервера, пускаем клиентов к службам роутера (DNS,
# перехват sing-box/zapret) и наружу. Применённые правила — в $FWSTATE, чтобы
# снять ровно их. NDM при перестройке сносит всё — хук 50-detour.sh зовёт `fw`.
FWSTATE="$RUN/detour-server.fw"
keen_fw_add() {  # $1 таблица $2 цепочка, дальше правило
    t=$1; ch=$2; shift 2
    iptables -t "$t" -C "$ch" "$@" 2>/dev/null || iptables -t "$t" -I "$ch" 1 "$@" 2>/dev/null || \
        { log "fw: не удалось добавить $t $ch $*"; return 1; }
    echo "$t $ch $*" >> "$FWSTATE"
}

keen_fw() {
    mkdir -p "$RUN"
    if [ -f "$FWSTATE" ]; then
        while read -r t ch rule; do
            [ -n "$ch" ] || continue
            while iptables -t "$t" -C "$ch" $rule 2>/dev/null; do iptables -t "$t" -D "$ch" $rule; done
        done < "$FWSTATE"
    fi
    : > "$FWSTATE"
    if awg_on && [ -n "$PORT" ] && [ -n "$NET" ]; then
        keen_fw_add filter INPUT -p udp --dport "$PORT" -j ACCEPT
        keen_fw_add filter INPUT -i "$IFACE" -j ACCEPT
        keen_fw_add filter FORWARD -i "$IFACE" -j ACCEPT
        keen_fw_add filter FORWARD -o "$IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT
        keen_fw_add nat POSTROUTING -s "$NET.0/24" ! -o "$IFACE" -j MASQUERADE
    fi
    if vless_on && [ -n "$VNET" ]; then
        keen_fw_add filter INPUT -p tcp --dport "$VPORT" -j ACCEPT
        keen_fw_add filter INPUT -i "$VIF" -j ACCEPT
        keen_fw_add filter FORWARD -i "$VIF" -j ACCEPT
        keen_fw_add raw OUTPUT -o "$VPEER" -j NOTRACK 2>/dev/null || \
            keen_fw_add raw OUTPUT -o "$VPEER" -j CT --notrack
        keen_fw_add nat POSTROUTING -s "$VNET.0/24" ! -o "$VIF" -j MASQUERADE
        vless_acct_up
    fi
}

# ---------- VLESS-Reality ----------

vless_pid() {
    [ -f "$VPID" ] || return 1
    p=$(cat "$VPID" 2>/dev/null)
    [ -n "$p" ] && [ -d "/proc/$p" ] && grep -q sing-box "/proc/$p/cmdline" 2>/dev/null && echo "$p"
}

vless_running() { [ -n "$(vless_pid)" ]; }

vless_dns() { echo "${DNS:-$VNET.1}"; }

# Конфиг sing-box сервера. Пользователь = id клиента; у каждого свой direct-
# выход с адреса $VNET.<octet> (по нему роутер считает трафик и узнаёт клиента).
# DNS клиентов перехватывается и уходит в dnsmasq роутера — так наполняются
# ipset'ы доменных маршрутов, как у устройств LAN.
vless_render() {  # $1 — 1 = с clash API (онлайн/адрес клиента)
    lan=$(lan_cidr)
    {
        printf '{"log":{"level":"warn","timestamp":true},'
        if [ "$KEENETIC" = 1 ]; then
            # Свой трафик входа в PREROUTING не попадает — DNS сразу в dnsmasq
            # Detour (он наполняет наборы маршрутов), без него — в DNS KeeneticOS.
            if [ -f /opt/etc/detour/dns.enabled ]; then
                printf '"dns":{"servers":[{"type":"udp","tag":"r","server":"127.0.0.1","server_port":%s}]},' "${DETOUR_DNS_PORT:-5354}"
            else
                printf '"dns":{"servers":[{"type":"udp","tag":"r","server":"127.0.0.1"}]},'
            fi
        else
            printf '"dns":{"servers":[{"type":"udp","tag":"r","server":"%s"}]},' "$(vless_dns)"
        fi
        printf '"inbounds":[{"type":"vless","tag":"in","listen":"0.0.0.0","listen_port":%s,"users":[' "$VPORT"
        awk -F'|' '$2 == 1 && $10 != "" {
            printf "%s{\"name\":\"%s\",\"uuid\":\"%s\",\"flow\":\"xtls-rprx-vision\"}", (n++ ? "," : ""), $1, $10
        }' "$CLIENTS"
        printf '],"tls":{"enabled":true,"server_name":"%s","reality":{"enabled":true,' "$VSNI"
        printf '"handshake":{"server":"%s","server_port":443},"private_key":"%s","short_id":["%s"]}}}],' "$VSNI" "$VPRIV" "$VSID"
        printf '"outbounds":[{"type":"direct","tag":"d"}'
        awk -F'|' -v vnet="$VNET" '$2 == 1 && $10 != "" {
            printf ",{\"type\":\"direct\",\"tag\":\"u-%s\",\"inet4_bind_address\":\"%s.%s\"}", $1, vnet, $4
        }' "$CLIENTS"
        printf '],"route":{"rules":[{"action":"sniff"},{"protocol":"dns","action":"hijack-dns"}'
        # «Только сеть дома»: всё, кроме LAN и подсетей сервера, — отказ.
        awk -F'|' -v net="$NET" -v vnet="$VNET" -v lan="$lan" '$2 == 1 && $10 != "" {
            if ($8 == "lan") {
                c = "\"" net ".0/24\",\"" vnet ".0/24\""
                if (lan != "") c = c ",\"" lan "\""
                printf ",{\"auth_user\":[\"%s\"],\"ip_cidr\":[%s],\"outbound\":\"u-%s\"}", $1, c, $1
                printf ",{\"auth_user\":[\"%s\"],\"action\":\"reject\"}", $1
            } else {
                printf ",{\"auth_user\":[\"%s\"],\"outbound\":\"u-%s\"}", $1, $1
            }
        }' "$CLIENTS"
        printf '],"final":"d","default_domain_resolver":"r"}'
        [ "$1" = 1 ] && printf ',"experimental":{"clash_api":{"external_controller":"%s"}}' "$CLASH"
        printf '}\n'
    }
}

# Keenetic: сетевых пространств нет. Пара veth в общем пространстве: исходящие
# клиентов (адреса $VNET.N на $VPEER) правилом `from $VNET.0/24 iif lo`
# уходят в $VPEER и возвращаются в роутер через $VIF — он в vpn_redirect_ifaces,
# там их ловит обычный перехват. Пакет с собственным адресом источника ядро
# принимает с accept_local; conntrack на выходе в $VPEER выключен (NOTRACK в
# keen_fw), иначе вернувшийся пакет считался бы уже известным соединением и
# REDIRECT на $VIF не срабатывал бы. Шлюз — несуществующий $VNET.254 со
# статической записью соседа на MAC $VIF (свой адрес шлюзом ядро не берёт).
# Свой трафик входа (Reality-маска, DNS) идёт без привязки — мимо всего этого.
# Проверено на Linux-стенде; на ядре 4.9-ndm — нет.
vless_net_up_keen() {
    modprobe veth 2>/dev/null || insmod "/lib/modules/$(uname -r)/veth.ko" 2>/dev/null
    if ! $KIP link show "$VIF" >/dev/null 2>&1; then
        $KIP link del "$VPEER" 2>/dev/null
        $KIP link add "$VIF" type veth peer name "$VPEER" || { log "veth $VIF не создан"; return 1; }
    fi
    echo 1 > "/proc/sys/net/ipv4/conf/$VIF/accept_local"
    echo 0 > "/proc/sys/net/ipv4/conf/$VIF/rp_filter"
    # rp_filter берётся как максимум all и интерфейса: строгий all сам по себе
    # отбросил бы пакет с локальным источником — ослабляем до loose.
    if [ "$(cat /proc/sys/net/ipv4/conf/all/rp_filter 2>/dev/null)" = 1 ]; then
        echo 2 > /proc/sys/net/ipv4/conf/all/rp_filter
        log "vless: rp_filter all 1 → 2"
    fi
    $KIP addr replace "$VNET.1/24" dev "$VIF"
    $KIP link set "$VIF" up
    $KIP link set "$VPEER" up
    want=$(awk -F'|' -v vnet="$VNET" '$10 != "" { print vnet "." $4 "/32" }' "$CLIENTS")
    have=$($KIP -4 -o addr show dev "$VPEER" 2>/dev/null | awk '{ print $4 }')
    for a in $want; do
        printf '%s\n' "$have" | grep -qx "$a" || $KIP addr add "$a" dev "$VPEER"
    done
    for a in $have; do
        printf '%s\n' "$want" | grep -qx "$a" || $KIP addr del "$a" dev "$VPEER"
    done
    $KIP neigh replace "$VNET.254" lladdr "$(cat "/sys/class/net/$VIF/address")" dev "$VPEER" nud permanent
    $KIP route replace default via "$VNET.254" dev "$VPEER" onlink table "$NS_TABLE"
    $KIP rule del from "$VNET.0/24" iif lo lookup "$NS_TABLE" 2>/dev/null
    $KIP rule add from "$VNET.0/24" iif lo lookup "$NS_TABLE" pref "$RULE_PREF"
}

vless_net_up() {
    [ "$KEENETIC" = 1 ] && { vless_net_up_keen; return; }
    ip netns list 2>/dev/null | grep -qw "^$NS" || ip netns add "$NS" || { log "ip netns add $NS не удался"; return 1; }
    if ! ip link show "$VIF" >/dev/null 2>&1; then
        ip -n "$NS" link del "$VPEER" 2>/dev/null
        ip link add "$VIF" type veth peer name "$VPEER" || { log "veth $VIF не создан"; return 1; }
        ip link set "$VPEER" netns "$NS" || { log "veth $VPEER не перенесён в $NS"; ip link del "$VIF"; return 1; }
    fi
    ip addr replace "$VNET.1/24" dev "$VIF"
    ip link set "$VIF" up
    # Мульти-WAN GL (kmwan) метит входящее с WAN и по метке шлёт в таблицу,
    # где есть только default через этот WAN: DNAT на $VNET.254 уходил обратно
    # в интернет. Подсеть сервера — всегда по main, раньше правил по меткам.
    ip -4 rule del to "$VNET.0/24" lookup main pref "$RULE_PREF" 2>/dev/null
    ip -4 rule add to "$VNET.0/24" lookup main pref "$RULE_PREF"
    # MPTCP — своё у каждого netns, а сломанный MPTCP ядра QSDK вешает любой
    # TCP-сервер в SYN_RECV (см. 99-mptcp.conf). Выключаем и здесь.
    ip netns exec "$NS" sh -c 'f=/proc/sys/net/mptcp/enabled; [ -f $f ] && echo 0 > $f' 2>/dev/null
    ip -n "$NS" link set lo up
    ip -n "$NS" link set "$VPEER" up
    ip -n "$NS" addr replace "$VNET.254/24" dev "$VPEER"
    want=$(awk -F'|' -v vnet="$VNET" '$10 != "" { print vnet "." $4 "/32" }' "$CLIENTS")
    have=$(ip -n "$NS" -4 -o addr show dev "$VPEER" 2>/dev/null | awk '{ print $4 }' | grep '/32$')
    for a in $want; do
        printf '%s\n' "$have" | grep -qx "$a" || ip -n "$NS" addr add "$a" dev "$VPEER"
    done
    for a in $have; do
        printf '%s\n' "$want" | grep -qx "$a" || ip -n "$NS" addr del "$a" dev "$VPEER"
    done
    # Свой трафик сервера (рукопожатие Reality с сайтом-маской, DNS sing-box)
    # идёт через $VIF2 — его нет в vpn_redirect_ifaces, перехват его не
    # трогает: маска отвечает напрямую, даже если она в списке VPN или VPN
    # лежит. Клиенты (их адреса $VNET.N) — через $VIF правилом по источнику.
    if ! ip link show "$VIF2" >/dev/null 2>&1; then
        ip -n "$NS" link del "$VPEER2" 2>/dev/null
        ip link add "$VIF2" type veth peer name "$VPEER2" || { log "veth $VIF2 не создан"; return 1; }
        ip link set "$VPEER2" netns "$NS" || { log "veth $VPEER2 не перенесён в $NS"; ip link del "$VIF2"; return 1; }
    fi
    ip addr replace "$LINKNET.1/30" dev "$VIF2"
    ip link set "$VIF2" up
    ip -4 rule del to "$LINKNET.0/30" lookup main pref "$RULE_PREF" 2>/dev/null
    ip -4 rule add to "$LINKNET.0/30" lookup main pref "$RULE_PREF"
    ip -n "$NS" link set "$VPEER2" up
    ip -n "$NS" addr replace "$LINKNET.2/30" dev "$VPEER2"
    ip -n "$NS" route replace default via "$LINKNET.1" dev "$VPEER2"
    ip -n "$NS" route replace default via "$VNET.1" dev "$VPEER" table "$NS_TABLE"
    ip -n "$NS" rule del from "$VNET.0/24" lookup "$NS_TABLE" 2>/dev/null
    ip -n "$NS" rule add from "$VNET.0/24" lookup "$NS_TABLE" pref 100
}

# Счётчики по клиенту: всё, что пришло с его адреса (rx), и всё, что ушло на
# него (tx), включая ответы перехватившего соединение sing-box роутера.
# Пересобираются только при смене состава — иначе обнулялись бы на каждом apply.
# Ответы клиенту на Keenetic в $VIF не уходят: адрес клиента там локальный,
# они доставляются сразу — считаем их в INPUT.
acct_out_set() {
    if [ "$KEENETIC" = 1 ]; then set -- INPUT; else set -- POSTROUTING -o "$VIF"; fi
    ACCT_OUT_HOOK="$*"
}

vless_acct_up() {
    sig=$(awk -F'|' -v vnet="$VNET" '$10 != "" { print vnet "." $4 }' "$CLIENTS" | sort | tr '\n' ' ')
    acct_out_set
    # NDM при перестройке сносит и mangle — тогда цепочки собираются заново.
    iptables -t mangle -L "$ACCT_IN" -n >/dev/null 2>&1 || rm -f "$VACCT_SIG"
    iptables -t mangle -N "$ACCT_IN" 2>/dev/null
    iptables -t mangle -N "$ACCT_OUT" 2>/dev/null
    iptables -t mangle -C PREROUTING -i "$VIF" -j "$ACCT_IN" 2>/dev/null || \
        iptables -t mangle -I PREROUTING 1 -i "$VIF" -j "$ACCT_IN"
    set -- $ACCT_OUT_HOOK
    hook=$1; shift
    iptables -t mangle -C "$hook" "$@" -j "$ACCT_OUT" 2>/dev/null || \
        iptables -t mangle -I "$hook" 1 "$@" -j "$ACCT_OUT"
    [ "$sig" = "$(cat "$VACCT_SIG" 2>/dev/null)" ] && return 0
    iptables -t mangle -F "$ACCT_IN"
    iptables -t mangle -F "$ACCT_OUT"
    for a in $sig; do
        iptables -t mangle -A "$ACCT_IN" -s "$a" -j RETURN
        iptables -t mangle -A "$ACCT_OUT" -d "$a" -j RETURN
    done
    echo "$sig" > "$VACCT_SIG"
}

vless_acct_down() {
    iptables -t mangle -D PREROUTING -i "$VIF" -j "$ACCT_IN" 2>/dev/null
    acct_out_set
    set -- $ACCT_OUT_HOOK
    hook=$1; shift
    iptables -t mangle -D "$hook" "$@" -j "$ACCT_OUT" 2>/dev/null
    for c in "$ACCT_IN" "$ACCT_OUT"; do
        iptables -t mangle -F "$c" 2>/dev/null
        iptables -t mangle -X "$c" 2>/dev/null
    done
    rm -f "$VACCT_SIG"
}

vless_start() {
    if [ "$KEENETIC" = 1 ]; then
        if command -v setsid >/dev/null 2>&1; then
            setsid "$(vless_sb)" run -c "$VRENDER" >>"$VLOG" 2>&1 </dev/null &
        else
            "$(vless_sb)" run -c "$VRENDER" >>"$VLOG" 2>&1 </dev/null &
        fi
        echo $! > "$VPID"
        return
    fi
    # Полный путь: busybox setsid (OpenWrt 25.12) сначала ищет одноимённый
    # апплет, а у busybox ip нет netns.
    ipbin=$(command -v ip)
    case "$ipbin" in /*) ;; *) ipbin=/sbin/ip ;; esac
    # setsid — чтобы процесс не умер вместе с CGI, из которого его запустили.
    if command -v setsid >/dev/null 2>&1; then
        setsid "$ipbin" netns exec "$NS" "$(vless_sb)" run -c "$VRENDER" >>"$VLOG" 2>&1 </dev/null &
    else
        "$ipbin" netns exec "$NS" "$(vless_sb)" run -c "$VRENDER" >>"$VLOG" 2>&1 </dev/null &
    fi
    echo $! > "$VPID"
}

vless_up() {
    vless_ok || { log "vless: $(vless_reason)"; return 1; }
    vless_net_up || return 1
    vless_acct_up
    umask 077
    vless_render 1 > "$VRENDER.new"
    # clash API есть не в каждой сборке sing-box — без него теряется только
    # «онлайн» и адрес клиента.
    if ! "$(vless_sb)" check -c "$VRENDER.new" >/dev/null 2>&1; then
        vless_render 0 > "$VRENDER.new"
        if ! out=$("$(vless_sb)" check -c "$VRENDER.new" 2>&1); then
            log "vless: конфиг не прошёл проверку: $out"
            rm -f "$VRENDER.new"
            return 1
        fi
    fi
    if vless_running && cmp -s "$VRENDER.new" "$VRENDER"; then
        rm -f "$VRENDER.new"
        return 0
    fi
    mv "$VRENDER.new" "$VRENDER"
    p=$(vless_pid)
    if [ -n "$p" ]; then
        kill "$p" 2>/dev/null
        i=0; while [ -d "/proc/$p" ] && [ "$i" -lt 20 ]; do sleep 0.2 2>/dev/null || sleep 1; i=$((i + 1)); done
        kill -9 "$p" 2>/dev/null
    fi
    [ -f "$VLOG" ] && [ "$(wc -c < "$VLOG")" -gt 262144 ] && tail -c 65536 "$VLOG" > "$VLOG.tmp" && mv "$VLOG.tmp" "$VLOG"
    vless_start
    sleep 1
    vless_running || { log "vless: sing-box не запустился, см. $VLOG"; return 1; }
    log "vless: sing-box запущен (порт $VPORT)"
}

vless_down() {
    p=$(vless_pid)
    [ -n "$p" ] && kill "$p" 2>/dev/null
    rm -f "$VPID" "$VRENDER"
    vless_acct_down
    if [ "$KEENETIC" = 1 ]; then
        [ -n "$VNET" ] && $KIP rule del from "$VNET.0/24" iif lo lookup "$NS_TABLE" 2>/dev/null
        $KIP route flush table "$NS_TABLE" 2>/dev/null
        $KIP link del "$VIF" 2>/dev/null
        return 0
    fi
    [ -n "$VNET" ] && ip -4 rule del to "$VNET.0/24" lookup main pref "$RULE_PREF" 2>/dev/null
    ip -4 rule del to "$LINKNET.0/30" lookup main pref "$RULE_PREF" 2>/dev/null
    ip link del "$VIF" 2>/dev/null
    ip link del "$VIF2" 2>/dev/null
    ip netns del "$NS" 2>/dev/null
}

do_stop() {
    awg_down
    vless_down
    [ -f "$CONF" ] && { load_conf; ENABLED=0; fw_apply; }
}

do_apply() {
    load_conf
    if [ "$ENABLED" != 1 ] || { [ -z "$PRIVKEY" ] && [ -z "$VPRIV" ]; }; then
        do_stop
        return 0
    fi
    rc=0
    if awg_on; then awg_up || rc=1; else awg_down; fi
    if vless_on; then vless_up || rc=1; else vless_down; fi
    fw_apply
    set --
    awg_on && set -- "$@" "$IFACE"
    vless_on && set -- "$@" "$VIF"
    redirect_attach "$@"
    return $rc
}

# ---------- статистика ----------

# Строки в формате `awg show dump` (ключ\t\tадрес\t\tрукопожатие\trx\ttx) для
# VLESS-клиентов: ключ "v:<id>", «рукопожатие» — последняя активность (есть
# открытое соединение или сдвинулись счётчики). Состояние — $VACT в RAM.
vless_dump() {
    vless_running || return 0
    [ -n "$VNET" ] || return 0
    vnow=$(date +%s)
    touch "$VACT"
    { iptables -t mangle -L "$ACCT_IN" -nvx 2>/dev/null | awk 'NR > 2 { print "i", $8, $2 }'
      iptables -t mangle -L "$ACCT_OUT" -nvx 2>/dev/null | awk 'NR > 2 { print "o", $9, $2 }'
    } > "$RUN/detour-server.vcnt"
    if [ "$KEENETIC" = 1 ]; then
        wget -qO- -T 2 "http://$CLASH/connections" 2>/dev/null
    else
        ip netns exec "$NS" wget -qO- -T 2 "http://$CLASH/connections" 2>/dev/null
    fi | lua -e '
        local ok, c = pcall(require, "cjson"); if not ok then return end
        local ok2, t = pcall(c.decode, io.read("*a")); if not ok2 or type(t) ~= "table" then return end
        local cs = t.connections; if type(cs) ~= "table" then return end
        for _, x in ipairs(cs) do
            local m = type(x.metadata) == "table" and x.metadata or {}
            for _, o in ipairs(type(x.chains) == "table" and x.chains or {}) do
                if type(o) == "string" and o:sub(1, 2) == "u-" then
                    print(o:sub(3) .. " " .. tostring(m.sourceIP or "") .. ":" .. tostring(m.sourcePort or ""))
                    break
                end
            end
        end' > "$RUN/detour-server.vconn" 2>/dev/null
    awk -v vnet="$VNET" -v now="$vnow" -v act="$VACT.new" '
        FILENAME == ARGV[1] { if ($1 == "i") rx[$2] = $3; else tx[$2] = $3; next }
        FILENAME == ARGV[2] { if ($1 != "") { cn[$1] = 1; rem[$1] = $2 } next }
        FILENAME == ARGV[3] { prx[$1] = $2; ptx[$1] = $3; last[$1] = $4; next }
        {
            split($0, f, "|")
            if (f[10] == "") next
            id = f[1]; ip = vnet "." f[4]
            r = rx[ip] + 0; t = tx[ip] + 0; l = last[id] + 0
            if ((id in prx) && (r != prx[id] || t != ptx[id])) l = now
            if (cn[id]) l = now
            print id, r, t, l > act
            if (!(ip in rx)) next
            printf "v:%s\t\t%s\t\t%d\t%.0f\t%.0f\n", id, rem[id], l, r, t
        }' "$RUN/detour-server.vcnt" "$RUN/detour-server.vconn" "$VACT" "$CLIENTS"
    [ -f "$VACT.new" ] && mv "$VACT.new" "$VACT"
    rm -f "$RUN/detour-server.vcnt" "$RUN/detour-server.vconn"
}

# Оба входа одним потоком: AWG по ключу клиента, VLESS по "v:<id>".
server_dump() {
    if [ "$(backend)" = ndm ]; then
        iface_up && ndm_dump
    else
        iface_up && awg show "$IFACE" dump 2>/dev/null | tail -n +2
    fi
    vless_dump
}

# Снимок счётчиков → накопительный трафик и сессии. Сброс счётчиков
# (пересоздан интерфейс, перезагрузка) распознаётся по уменьшению: тогда
# дельта = текущее значение. AWG и VLESS считаются раздельно (сбрасываются
# независимо), в итог идёт сумма дельт.
stats_tick() {
    [ -f "$CLIENTS" ] || return 0
    mkdir -p "$RUN"
    [ -f "$STATS_RAM" ] || cp "$TRAFFIC" "$STATS_RAM" 2>/dev/null || : > "$STATS_RAM"
    dump="$RUN/detour-server.dump"
    server_dump > "$dump"
    now=$(date +%s)
    ev="$RUN/detour-server.events"
    : > "$ev"
    awk -F'|' -v OFS='|' -v now="$now" -v on_sec="$ONLINE_SEC" \
        -v mon="$(date +%Y%m)" -v day="$(date +%Y%m%d)" -v ev="$ev" '
        FILENAME == ARGV[1] {
            split($0, f, "\t")
            rx[f[1]] = f[6]; tx[f[1]] = f[7]; hs[f[1]] = f[5]; ep[f[1]] = f[3]
            next
        }
        FILENAME == ARGV[2] { if ($1 != "") { ids[++n] = $1; pk[$1] = $5 } next }
        { T[$1] = $0 }
        END {
            for (i = 1; i <= n; i++) {
                id = ids[i]; k = pk[id]; vk = "v:" id
                if (id in T) split(T[id], a, "|")
                else { for (j = 1; j <= 19; j++) a[j] = 0; a[1] = id; a[17] = "" }
                crx = rx[k] + 0; ctx = tx[k] + 0
                drx = (crx < a[2]) ? crx : crx - a[2]
                dtx = (ctx < a[3]) ? ctx : ctx - a[3]
                vrx = rx[vk] + 0; vtx = tx[vk] + 0
                drx += (vrx < a[18] + 0) ? vrx : vrx - a[18]
                dtx += (vtx < a[19] + 0) ? vtx : vtx - a[19]
                a[2] = crx; a[3] = ctx; a[18] = vrx; a[19] = vtx
                a[4] += drx; a[5] += dtx
                if (a[6] != mon) { a[6] = mon; a[7] = 0; a[8] = 0 }
                a[7] += drx; a[8] += dtx
                if (a[9] != day) { a[9] = day; a[10] = 0; a[11] = 0 }
                a[10] += drx; a[11] += dtx
                h = hs[k] + 0; e = ep[k]
                if (hs[vk] + 0 > h) { h = hs[vk] + 0; e = ep[vk] }
                # Handshake обновляется лишь раз в 2 минуты; клиент шлёт keepalive
                # каждые 25 с, так что рост счётчиков — точнее «последний раз в сети».
                if (h > a[16]) a[16] = h
                if (drx + dtx > 0 && now > a[16]) a[16] = now
                if (e != "" && e != "(none)") a[17] = e
                online = (h > 0 && now - h < on_sec) ? 1 : 0
                if (online) {
                    if (a[12] != 1) { a[13] = h; a[14] = 0; a[15] = 0; print "start" > ev }
                    a[14] += drx; a[15] += dtx
                } else if (a[12] == 1) {
                    print id, a[13], a[16], a[14], a[15], a[17] > ev
                    a[14] = 0; a[15] = 0
                }
                a[12] = online
                line = a[1]
                for (j = 2; j <= 19; j++) line = line "|" (a[j] == "" && j != 17 ? 0 : a[j])
                print line
            }
        }' "$dump" "$CLIENTS" "$STATS_RAM" > "$STATS_RAM.tmp" && mv "$STATS_RAM.tmp" "$STATS_RAM"
    rm -f "$dump"
    flush=0
    if grep -q '|' "$ev" 2>/dev/null; then
        grep '|' "$ev" >> "$SESSIONS"
        if [ "$(wc -l < "$SESSIONS")" -gt "$SESS_KEEP" ]; then
            tail -n "$SESS_KEEP" "$SESSIONS" > "$SESSIONS.tmp" && mv "$SESSIONS.tmp" "$SESSIONS"
        fi
        flush=1
    fi
    [ -s "$ev" ] && flush=1
    rm -f "$ev"
    [ $(( $(date +%M | sed 's/^0//') % FLUSH_MIN )) -eq 0 ] && flush=1
    [ "$flush" = 1 ] && stats_flush
    return 0
}

stats_flush() {
    [ -f "$STATS_RAM" ] || return 0
    umask 077
    cp "$STATS_RAM" "$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"
}

stats_src() { if [ -f "$STATS_RAM" ]; then echo "$STATS_RAM"; elif [ -f "$TRAFFIC" ]; then echo "$TRAFFIC"; else echo /dev/null; fi; }

sessions_json() {  # $1 — id клиента или пусто (все)
    printf '{"ok":true,"sessions":['
    [ -f "$SESSIONS" ] && awk -F'|' -v id="$1" '
        id == "" || $1 == id { l[++n] = $0 }
        END {
            for (i = n; i >= 1 && n - i < 100; i--) {
                split(l[i], a, "|")
                printf "%s{\"id\":\"%s\",\"start\":%d,\"end\":%d,\"rx\":%d,\"tx\":%d,\"remote\":\"%s\"}",
                    (i < n ? "," : ""), a[1], a[2], a[3], a[4], a[5], a[6]
            }
        }' "$SESSIONS"
    printf ']}\n'
}

# ---------- выдача ----------

client_conf() {
    line=$(client_line "$1")
    [ -n "$line" ] || return 1
    octet=$(echo "$line" | cut -d'|' -f4)
    priv=$(echo "$line" | cut -d'|' -f6)
    psk=$(echo "$line" | cut -d'|' -f7)
    mode=$(echo "$line" | cut -d'|' -f8)
    [ -n "$priv" ] && [ -n "$PUBKEY" ] || return 1
    if [ "$mode" = lan ]; then
        allowed="$NET.0/24"
        lc=$(lan_cidr); [ -n "$lc" ] && allowed="$allowed, $lc"
    else
        # ::/0 — чтобы IPv6 клиента не ушёл мимо туннеля (сервер его не везёт).
        allowed="0.0.0.0/0, ::/0"
    fi
    host=$(endpoint_host)
    printf '[Interface]\nPrivateKey = %s\nAddress = %s.%s/32\nDNS = %s\nMTU = %s\n' \
        "$priv" "$NET" "$octet" "${DNS:-$(server_ip)}" "${MTU:-1376}"
    printf 'Jc = %s\nJmin = %s\nJmax = %s\nS1 = %s\nS2 = %s\n' "$JC" "$JMIN" "$JMAX" "$S1" "$S2"
    printf 'H1 = %s\nH2 = %s\nH3 = %s\nH4 = %s\n' "$H1" "$H2" "$H3" "$H4"
    printf '\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s\nEndpoint = %s:%s\nPersistentKeepalive = 25\n' \
        "$PUBKEY" "$psk" "$allowed" "$host" "$PORT"
}

urlenc() {
    printf '%s' "$1" | hexdump -v -e '/1 "%02x\n"' | awk '
        BEGIN {
            for (i = 48; i <= 57; i++) ok[sprintf("%02x", i)] = sprintf("%c", i)
            for (i = 65; i <= 90; i++) ok[sprintf("%02x", i)] = sprintf("%c", i)
            for (i = 97; i <= 122; i++) ok[sprintf("%02x", i)] = sprintf("%c", i)
            ok["2d"] = "-"; ok["2e"] = "."; ok["5f"] = "_"
        }
        { h = tolower($1); s = s ((h in ok) ? ok[h] : "%" toupper(h)) }
        END { printf "%s", s }'
}

# Ссылка для v2rayN/v2rayNG/Hiddify/Streisand/sing-box и самого Detour.
client_link() {
    line=$(client_line "$1")
    [ -n "$line" ] || return 1
    uuid=$(echo "$line" | cut -d'|' -f10)
    [ -n "$uuid" ] && [ -n "$VPUB" ] && [ -n "$VPORT" ] || return 1
    name=$(echo "$line" | cut -d'|' -f3)
    printf 'vless://%s@%s:%s?encryption=none&flow=xtls-rprx-vision&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&type=tcp#%s\n' \
        "$uuid" "$(endpoint_host)" "$VPORT" "$VSNI" "$VPUB" "$VSID" "$(urlenc "$name")"
}

status_json() {
    load_conf
    reason=$(unsupported_reason)
    supported=true; installed=true; can_install=false
    if [ "$reason" = not_installed ]; then
        installed=false; reason=""
        if installable; then can_install=true; else
            supported=false
            reason="В фидах прошивки нет kmod-amneziawg — на этом роутере ядерный AmneziaWG недоступен"
        fi
    elif [ -n "$reason" ]; then
        supported=false; installed=false
    fi
    note=""
    if [ "$KEENETIC" = 1 ]; then
        be=$(backend)
        if [ "$be" = userspace ]; then
            note="Сервер работает на userspace AmneziaWG: скорость упирается в процессор роутера (на MT7621 около 30 Мбит/с). Поставьте компонент KeeneticOS «WireGuard VPN» (Общие настройки → Изменить набор компонентов) — сервер перейдёт на встроенный WireGuard, это в разы быстрее."
        elif [ -z "$be" ]; then
            note="Лучший вариант — компонент KeeneticOS «WireGuard VPN» (Общие настройки → Изменить набор компонентов): сервер возьмёт встроенный WireGuard с обфускацией. Без него — userspace AmneziaWG из фида Detour, он медленнее."
            [ "$can_install" = true ] || reason="Поставьте компонент KeeneticOS «WireGuard VPN» (Общие настройки → Изменить набор компонентов)"
        fi
    fi
    vr=$(vless_reason); vsup=true; vinst=false
    if [ "$vr" = netns ]; then
        vsup=false; vr="Нужен пакет ip-full"
        ipfull_installable && vinst=true
    elif [ -n "$vr" ]; then
        vsup=false
    fi
    arun=false; iface_up && arun=true
    vrun=false; vless_running && vrun=true
    running=false; { [ "$arun" = true ] || [ "$vrun" = true ]; } && running=true
    wip=$(wan_ip)
    wpriv=false; [ -n "$wip" ] && ip_private "$wip" && wpriv=true
    dom=$(panel_domain)
    redir=false; redirect_has_iface && redir=true
    printf '{"ok":true,"platform":"%s","supported":%s,"reason":"%s","installed":%s,"can_install":%s,"backend":"%s",' \
        "$([ "$KEENETIC" = 1 ] && echo keenetic || echo openwrt)" "$supported" "$(json_esc "$reason")" "$installed" "$can_install" \
        "$([ "$installed" = true ] && backend)"
    printf '"note":"%s",' "$(json_esc "$note")"
    printf '"configured":%s,"enabled":%s,"running":%s,"routed":%s,"awg_enabled":%s,"awg_running":%s,' \
        "$({ [ -n "$PRIVKEY" ] || [ -n "$VPRIV" ]; } && echo true || echo false)" "$([ "$ENABLED" = 1 ] && echo true || echo false)" \
        "$running" "$redir" "$([ "$AWG" = 1 ] && echo true || echo false)" "$arun"
    printf '"vless":{"supported":%s,"reason":"%s","can_install":%s,"enabled":%s,"running":%s,"port":%s,"sni":"%s","pubkey":"%s","short_id":"%s","net":"%s"},' \
        "$vsup" "$(json_esc "$vr")" "$vinst" "$([ "$VLESS" = 1 ] && echo true || echo false)" "$vrun" "${VPORT:-0}" \
        "$(json_esc "$VSNI")" "$VPUB" "$VSID" "${VNET:+$VNET.0/24}"
    printf '"iface":"%s","port":%s,"net":"%s","server_ip":"%s","endpoint":"%s","endpoint_effective":"%s",' \
        "$IFACE" "${PORT:-0}" "${NET:+$NET.0/24}" "${NET:+$(server_ip)}" "$(json_esc "$ENDPOINT")" "$(json_esc "$(endpoint_host)")"
    printf '"wan_ip":"%s","wan_private":%s,"panel_domain":"%s","dns":"%s","mtu":%s,"pubkey":"%s","clients":[' \
        "$wip" "$wpriv" "$(json_esc "$dom")" "$(json_esc "$DNS")" "${MTU:-1376}" "$PUBKEY"
    dump=$(server_dump)
    now=$(date +%s)
    # rx/tx — живые счётчики (AWG + VLESS; скорость панель считает по их
    # разнице между опросами); total/month/day/session — накопленное tick'ом
    # (+ ещё не учтённая дельта, чтобы цифры не отставали на минуту).
    [ -f "$CLIENTS" ] && printf '%s\n' "$dump" | awk -F'|' -v net="$NET" -v now="$now" -v on_sec="$ONLINE_SEC" \
        -v mon="$(date +%Y%m)" -v day="$(date +%Y%m%d)" '
        function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
        FILENAME == "-" {
            split($0, f, "\t")
            if (f[1] != "") { hs[f[1]] = f[5]; rx[f[1]] = f[6]; tx[f[1]] = f[7]; ep[f[1]] = f[3] }
            next
        }
        FILENAME == ARGV[2] { S[$1] = $0; next }
        {
            k = $5; vk = "v:" $1
            for (j = 1; j <= 19; j++) a[j] = 0
            a[17] = ""
            if ($1 in S) split(S[$1], a, "|")
            crx = rx[k] + 0; ctx = tx[k] + 0
            drx = (crx < a[2]) ? crx : crx - a[2]
            dtx = (ctx < a[3]) ? ctx : ctx - a[3]
            if (k == "" || !(k in rx)) { drx = 0; dtx = 0 }
            vrx = rx[vk] + 0; vtx = tx[vk] + 0
            if (vk in rx) {
                drx += (vrx < a[18] + 0) ? vrx : vrx - a[18]
                dtx += (vtx < a[19] + 0) ? vtx : vtx - a[19]
            }
            mrx = (a[6] == mon ? a[7] : 0) + drx; mtx = (a[6] == mon ? a[8] : 0) + dtx
            dyrx = (a[9] == day ? a[10] : 0) + drx; dytx = (a[9] == day ? a[11] : 0) + dtx
            h = hs[k] + 0; rem = ep[k]
            if (hs[vk] + 0 > h) { h = hs[vk] + 0; rem = ep[vk] }
            online = (h > 0 && now - h < on_sec) ? 1 : 0
            seen = (h > a[16] + 0) ? h : a[16] + 0
            sst = 0; srx = 0; stx = 0
            if (online) {
                if (a[12] == 1) { sst = a[13]; srx = a[14] + drx; stx = a[15] + dtx }
                else { sst = h; srx = drx; stx = dtx }
            }
            if (rem == "" || rem == "(none)") rem = a[17]
            printf "%s{\"id\":\"%s\",\"enabled\":%s,\"name\":\"%s\",\"ip\":\"%s.%s\",\"mode\":\"%s\",\"created\":%d,\"awg\":%s,\"vless\":%s,\"route\":\"%s\",",
                (n++ ? "," : ""), $1, ($2 == 1 ? "true" : "false"), esc($3), net, $4, ($8 == "" ? "full" : $8), $9 + 0,
                ($5 != "" ? "true" : "false"), ($10 != "" ? "true" : "false"), esc($11)
            printf "\"online\":%s,\"handshake\":%d,\"handshake_ago\":%d,\"last_seen\":%d,\"rx\":%.0f,\"tx\":%.0f,\"remote\":\"%s\",",
                (online ? "true" : "false"), h, (h > 0 ? now - h : -1), seen, crx + vrx, ctx + vtx, rem
            printf "\"session_start\":%d,\"session_rx\":%.0f,\"session_tx\":%.0f,", sst, srx, stx
            printf "\"day_rx\":%.0f,\"day_tx\":%.0f,\"month_rx\":%.0f,\"month_tx\":%.0f,\"total_rx\":%.0f,\"total_tx\":%.0f}",
                dyrx, dytx, mrx, mtx, a[4] + drx, a[5] + dtx
        }' - "$(stats_src)" "$CLIENTS"
    printf '],"now":%s}\n' "$now"
}

# ---------- команды ----------

valid_ipv4_host() {
    case "$1" in
        *[!A-Za-z0-9.-]*|'') return 1 ;;
    esac
    return 0
}

cmd_set() {
    ensure_conf
    for kv in "$@"; do
        k=${kv%%=*}; v=${kv#*=}
        case "$k" in
            enabled) case "$v" in 0|1) ENABLED=$v ;; *) err "enabled: 0 или 1" ;; esac ;;
            awg)
                case "$v" in 0|1) ;; *) err "awg: 0 или 1" ;; esac
                [ "$v" = 1 ] && ! awg_ok && err "AmneziaWG на этом роутере недоступен"
                AWG=$v ;;
            vless)
                case "$v" in 0|1) ;; *) err "vless: 0 или 1" ;; esac
                if [ "$v" = 1 ] && ! vless_ok; then
                    r=$(vless_reason); [ "$r" = netns ] && r="нужен пакет ip-full"
                    err "VLESS недоступен: $r"
                fi
                VLESS=$v ;;
            port)
                case "$v" in ''|*[!0-9]*) err "порт — число" ;; esac
                [ "$v" -ge 1024 ] && [ "$v" -le 65535 ] || err "порт 1024–65535"
                if [ "$v" != "$PORT" ] && port_busy "$v"; then err "UDP-порт $v уже занят"; fi
                PORT=$v ;;
            vport)
                case "$v" in ''|*[!0-9]*) err "порт — число" ;; esac
                [ "$v" -ge 1 ] && [ "$v" -le 65535 ] || err "порт 1–65535"
                if [ "$v" != "$VPORT" ] && tcp_port_busy "$v"; then err "TCP-порт $v уже занят на роутере"; fi
                VPORT=$v ;;
            sni)
                valid_ipv4_host "$v" && echo "$v" | grep -q '[A-Za-z]' && echo "$v" | grep -q '\.' || \
                    err "маскировочный сайт: домен, например www.microsoft.com"
                VSNI=$v ;;
            net)
                v=${v%.0/24}; v=${v%.0}
                echo "$v" | grep -qE '^10\.[0-9]{1,3}\.[0-9]{1,3}$|^192\.168\.[0-9]{1,3}$|^172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}$' || \
                    err "подсеть: частная /24, например 10.66.0.0/24"
                [ "$v" = "$VNET" ] && err "подсеть $v.0/24 занята входом VLESS"
                if [ "$v" != "$NET" ] && ip -4 route | grep -q "^$v\.0/"; then err "подсеть $v.0/24 уже занята"; fi
                NET=$v ;;
            endpoint)
                [ -z "$v" ] || valid_ipv4_host "$v" || err "адрес: домен или IPv4"
                ENDPOINT=$v ;;
            dns)
                [ -z "$v" ] || echo "$v" | grep -qE '^[0-9.]+$' || err "DNS: IPv4-адрес"
                DNS=$v ;;
            mtu)
                case "$v" in ''|*[!0-9]*) err "MTU — число" ;; esac
                [ "$v" -ge 1200 ] && [ "$v" -le 1500 ] || err "MTU 1200–1500"
                MTU=$v ;;
            *) err "неизвестный параметр: $k" ;;
        esac
    done
    oldnet=$(sed -n 's/^NET=//p' "$CONF")
    save_conf
    # Смена подсети требует нового адреса на интерфейсе — проще пересоздать.
    [ "$oldnet" != "$NET" ] && iface_up && awg_down
    do_apply || err "не удалось применить, см. $LOG"
    log "set: $*"
    echo '{"ok":true}'
}

cmd_client_add() {
    ensure_conf
    name=$(clean_name "$1"); [ -n "$name" ] || err "нужно имя клиента"
    mode=${2:-full}; case "$mode" in full|lan) ;; *) err "режим: full или lan" ;; esac
    octet=$(free_octet); [ -n "$octet" ] || err "в подсети нет свободных адресов"
    id=$(new_id)
    priv=""; pub=""; psk=""
    if awg_ok; then
        wg_keypair || err "не удалось сгенерировать ключи"
        priv=$KP_PRIV; pub=$KP_PUB; psk=$(wg_psk)
        [ -n "$psk" ] || err "не удалось сгенерировать ключи"
    fi
    uuid=$(new_uuid); [ -n "$uuid" ] || err "не удалось получить uuid"
    umask 077
    printf '%s|1|%s|%s|%s|%s|%s|%s|%s|%s|\n' "$id" "$name" "$octet" "$pub" "$priv" "$psk" "$mode" "$(date +%s)" "$uuid" >> "$CLIENTS"
    do_apply
    log "client-add $id ($name) $NET.$octet $mode"
    printf '{"ok":true,"id":"%s"}\n' "$id"
}

rewrite_client() {  # $1 id, остальное — awk-программа над полями
    id=$1; prog=$2; shift 2
    umask 077
    awk -F'|' -v OFS='|' -v id="$id" "$@" "$prog" "$CLIENTS" > "$CLIENTS.tmp" && mv "$CLIENTS.tmp" "$CLIENTS"
}

cmd_client_set() {
    load_conf
    id=$1; shift
    [ -n "$(client_line "$id")" ] || err "клиент не найден"
    for kv in "$@"; do
        k=${kv%%=*}; v=${kv#*=}
        case "$k" in
            name)
                v=$(clean_name "$v"); [ -n "$v" ] || err "пустое имя"
                rewrite_client "$id" '$1 == id { $3 = v } { print }' -v v="$v" ;;
            mode)
                case "$v" in full|lan) ;; *) err "режим: full или lan" ;; esac
                rewrite_client "$id" '$1 == id { $8 = v } { print }' -v v="$v" ;;
            enabled)
                case "$v" in 0|1) ;; *) err "enabled: 0 или 1" ;; esac
                rewrite_client "$id" '$1 == id { $2 = v } { print }' -v v="$v" ;;
            route)
                case "$v" in
                    ''|direct) ;;
                    vpn:*) case "${v#vpn:}" in ''|*[!A-Za-z0-9_.-]*) err "маршрут: id профиля или цепочки" ;; esac ;;
                    *) err "маршрут: пусто, direct или vpn:<id>" ;;
                esac
                rewrite_client "$id" '$1 == id { $11 = v } { print }' -v v="$v" ;;
            *) err "неизвестный параметр: $k" ;;
        esac
    done
    do_apply
    log "client-set $id $*"
    echo '{"ok":true}'
}

cmd_client_del() {
    load_conf
    [ -n "$(client_line "$1")" ] || err "клиент не найден"
    rewrite_client "$1" '$1 != id { print }'
    do_apply
    log "client-del $1"
    echo '{"ok":true}'
}

attach_all() {
    set --
    awg_on && set -- "$@" "$IFACE"
    vless_on && set -- "$@" "$VIF"
    redirect_attach "$@"
}

case "$1" in
    status) status_json ;;
    sessions) sessions_json "$2" ;;
    tick)
        # Сервер ни разу не настраивался — cron стоит на всех роутерах, выходим сразу.
        [ -f "$CLIENTS" ] || exit 0
        lock; load_conf
        # Самолечение: интерфейс или процесс пропал (упал amneziawg-go или
        # sing-box, кто-то удалил) — поднимаем заново, иначе клиенты молча
        # остались бы без сервера.
        if awg_on && ! iface_up; then
            log "tick: $IFACE нет при включённом сервере — поднимаю"
            do_apply
        elif vless_on && ! vless_running; then
            log "tick: sing-box VLESS не запущен при включённом сервере — поднимаю"
            do_apply
        fi
        # settings.json появился позже сервера (свежая установка) или его
        # переписали без нашего интерфейса — без этого клиенты шли бы мимо
        # маршрутов роутера.
        [ "$ENABLED" = 1 ] && attach_all
        # Keenetic: NDM при переподключениях WAN может снести наши ip rule/neigh.
        [ "$KEENETIC" = 1 ] && vless_on && vless_running && vless_net_up >/dev/null 2>&1
        stats_tick ;;
    start|apply)
        lock; [ -f "$CONF" ] && ensure_conf >/dev/null
        do_apply
        [ "$1" = apply ] && echo '{"ok":true}'
        exit 0 ;;
    stop) lock; load_conf; stats_tick; stats_flush; do_stop ;;
    down)
        # Удаление пакета: снять всё, файрвол чистит вызывающий (на Keenetic
        # своих правил у NDM нет — снимаем сами).
        load_conf; stats_tick; stats_flush; awg_down; vless_down
        if [ "$KEENETIC" = 1 ]; then
            fw_remove
            [ -n "$NDMIF" ] && ndm_wg && ndm_cli "system configuration save" >/dev/null 2>&1
        fi ;;
    fw)
        # Keenetic: правила сервера заново после перестройки iptables NDM
        # (зовёт netfilter-хук 50-detour.sh).
        [ "$KEENETIC" = 1 ] || exit 0
        [ -f "$CONF" ] || exit 0
        load_conf; keen_fw ;;
    set) shift; lock; cmd_set "$@" ;;
    client-add) shift; lock; cmd_client_add "$@" ;;
    client-set) shift; lock; cmd_client_set "$@" ;;
    client-del) lock; cmd_client_del "$2" ;;
    client-conf)
        load_conf
        client_conf "$2" || { echo "клиент не найден или у него нет ключей AmneziaWG" >&2; exit 1; } ;;
    client-link)
        load_conf
        client_link "$2" || { echo "клиент не найден или VLESS не настроен" >&2; exit 1; } ;;
    regen-obf)
        lock; ensure_conf; gen_obf; save_conf
        # Параметры интерфейса syncconf не меняет надёжно — пересоздаём.
        iface_up && awg_down
        do_apply
        log "regen-obf"
        echo '{"ok":true}' ;;
    *)
        echo "usage: $0 {status|start|stop|down|apply|set k=v…|client-add <name> [full|lan]|client-set <id> k=v…|client-del <id>|client-conf <id>|client-link <id>|regen-obf}" >&2
        exit 2 ;;
esac
