    umask 077
    cat > "$CONF.tmp" <<EOF
ENABLED=$ENABLED
PORT=$PORT
NET=$NET
ENDPOINT=$ENDPOINT
DNS=$DNS
MTU=$MTU
PRIVKEY=$PRIVKEY
PUBKEY=$PUBKEY
