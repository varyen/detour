#!/bin/sh
# Detour — свой VPN-сервер на роутере: AmneziaWG, клиенты получают маршруты роутера.
#
#   detour-server status                 — JSON: поддержка, состояние, клиенты
#   detour-server start | stop | apply   — поднять / погасить / пересобрать
#   detour-server set КЛЮЧ=ЗНАЧ…         — enabled port net endpoint dns mtu uplink
#   detour-server client-add <имя> [full|lan]
#   detour-server client-set <id> КЛЮЧ=ЗНАЧ…   — name mode enabled route
#   detour-server client-del <id>
#   detour-server client-conf <id>       — .conf для приложения AmneziaWG/AmneziaVPN
#   detour-server regen-obf              — новые параметры обфускации (все клиенты
#                                          должны заново импортировать конфиг)
#   detour-server client-link <id>       — ссылка vless:// (VLESS-Reality)
#   detour-server down                   — снять всё (удаление пакета)
#
# Два входа, один набор клиентов: AmneziaWG (UDP, интерфейс $IFACE) и
# VLESS-Reality (TCP). VLESS принимает отдельный sing-box в своём сетевом
# пространстве $NS: его исходящий трафик выходит в роутер через veth $VIF и
# попадает под те же правила перехвата, что AWG-клиенты и LAN (zapret,
# «Отдельные маршруты», торренты, режим VPN) — отдельный стек правил для VLESS
# не нужен. Каждый клиент выходит со своего адреса $VNET.<octet>: по нему
# считается его трафик (цепочки mangle $ACCT_IN/$ACCT_OUT). Вход с WAN —
# DNAT на $VNET.254:$VPORT (uci redirect), адрес клиента сохраняется.
#
# Маршрутизация. Интерфейс сервера ($IFACE) кладётся в "vpn_redirect_ifaces"
# settings.json — тот же механизм, что и для WG-сервера GL: sing-box, zapret,
# «Отдельные маршруты», запрет торрентов вешают на него те же правила, что на
# br-lan. Из списка он больше не убирается: правила на несуществующий интерфейс
# ничего не ловят, а снятие потребовало бы снимать их до правки списка (стоп
# sing-box перебирает ТЕКУЩИЙ список).
#
# Ядро. На GL.iNet kmod-amneziawg + amneziawg-tools лежат в штатном фиде
# прошивки (AWG 2.0). На чистой OpenWrt — userspace detour-awg-go из фида Detour.
# На Keenetic — встроенный WireGuard KeeneticOS с обфускацией ASC (компонент
# «WireGuard VPN»): интерфейс WireguardN (в ядре nwgN) собирается командами CLI
# через RCI на localhost:79, а без компонента — тот же userspace detour-awg-go
# (на MT7621 замерено ~30 Мбит/с против ~80 у встроенного). Файрвол Keenetic —
# свои правила (`fw`), их же переставляет netfilter-хук после перестроек NDM.
#
# Хранение: $DIR/server.conf (shell KEY=VAL) и $DIR/clients.list:
#   id|enabled|name|octet|pubkey|privkey|psk|mode|created|uuid|route|token|owner
# (pubkey пуст, пока на платформе нет AWG; uuid — пользователь VLESS; route —
# пусто = правила роутера, direct = мимо VPN, vpn:<профиль|цепочка>. Маршрут
# исполняет механизм «Правила → Устройства»: detour-api добавляет клиента в
# devices.map по его адресам $NET.N и $VNET.N; token — секрет URL подписки;
# owner — логин админа панели, который завёл клиента (пусто — главный админ).)
# Приватный ключ клиента хранится, чтобы конфиг/QR можно было показать повторно
# (так же делает GL). Каталог 0700, под /etc/detour → keeplist sysupgrade.

IFACE=dsrv0
ZONE=detour_srv
NS=detour-srv
VIF=dsrv1
VPEER=dsrv1p
VIF2=dsrv2
VPEER2=dsrv2p
LINKNET=169.254.67
NS_TABLE=166
ACCT_IN=DSRV_VIN
ACCT_OUT=DSRV_VOUT
CLASH=127.0.0.1:9095
RULE_PREF=11990

if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    KEENETIC=1
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    DIR=/opt/etc/detour/server
    SETTINGS=/opt/etc/sing-box/settings.json
    RUN=/opt/var/run
    LOG=/opt/var/log/detour-server.log
    LAN_IF=br0
    WANPIN_BIN=/opt/sbin/detour-wanpin
    CERT_CONF=/opt/etc/detour/cert.conf
    SUB_HOME=/opt/share/detour/sub-www
    RCI=http://localhost:79/rci/
    KIP=/opt/sbin/ip
    HOOK=/opt/etc/ndm/netfilter.d/50-detour.sh
    IPT_BIN=$(command -v iptables)
else
    KEENETIC=0
    DIR=/etc/detour/server
    SETTINGS=/etc/sing-box/settings.json
    RUN=/var/run
    LOG=/var/log/detour-server.log
    LAN_IF=br-lan
    WANPIN_BIN=/usr/sbin/detour-wanpin
    CERT_CONF=/etc/detour/cert.conf
    SUB_HOME=/usr/share/detour/sub-www
fi
# Нет утилиты awg (чистая OpenWrt с userspace-пакетом detour-awg-go) — её
# подмножество встроено в наш amneziawg-go.
if ! command -v awg >/dev/null 2>&1 && command -v amneziawg-go >/dev/null 2>&1 && \
        amneziawg-go awg genpsk 2>/dev/null | grep -qE '^[A-Za-z0-9+/]{43}=$'; then
    awg() { amneziawg-go awg "$@"; }
fi

CONF="$DIR/server.conf"
CLIENTS="$DIR/clients.list"
RENDER="$RUN/detour-server.conf"
LOCK="$RUN/detour-server.lock"
# Статистика. Рабочая копия — в RAM (tick раз в минуту), на флеш — раз в
# $FLUSH_MIN минут и на каждом событии сессии, чтобы не изнашивать флеш.
#   traffic: id|lrx|ltx|trx|ttx|mon|mrx|mtx|day|drx|dtx|online|sstart|srx|stx|seen|remote|vlrx|vltx
#   (lrx/ltx — последние показания счётчиков AWG, vlrx/vltx — VLESS; rx — от
#   клиента, tx — к клиенту)
#   sessions.log: id|start|end|rx|tx|remote — последние $SESS_KEEP сессий
TRAFFIC="$DIR/traffic"
SESSIONS="$DIR/sessions.log"
STATS_RAM="$RUN/detour-server.traffic"
VRENDER="$RUN/detour-vless.json"
VPID="$RUN/detour-vless.pid"
XRENDER="$RUN/detour-xhttp.json"
XPID="$RUN/detour-xhttp.pid"
XLOG="$RUN/detour-xhttp.log"
# xray узнаёт формат по расширению — «.json.new» он не принимает.
XNEW="$RUN/detour-xhttp.new.json"
VLOG="$RUN/detour-vless.log"
VACT="$RUN/detour-server.vact"
VACCT_SIG="$RUN/detour-server.vacct"
SUBPID="$RUN/detour-sub.pid"
SUBSIG="$RUN/detour-sub.sig"
SUBLCONF="$RUN/detour-sub.lighttpd.conf"
ONLINE_SEC=180
FLUSH_MIN=30
SESS_KEEP=500

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

# Keenetic: iptables из Entware на ядре 4.9-ndm умеет зависнуть навсегда с
# 100% CPU (на KN-1810 — любой вызов к таблице raw) — и держать за собой
# CGI, cron и postinst вместе с замком opkg. Каждый вызов — со сторожем.

# run_limited <сек> <команда>… — код команды; зависшая снимается kill -9 (код 137).
run_limited() {
    _rl=$1; shift
    "$@" &
    _ip=$!
    # Сторож гасит и свой sleep, иначе на каждый вызов оставался бы сирота;
    # вывод — мимо stdout, иначе висящий sleep держал бы ответ CGI.
    (
        trap 'kill "$_s" 2>/dev/null; exit 0' TERM
        sleep "$_rl" & _s=$!
        wait "$_s" && kill -9 "$_ip" 2>/dev/null
    ) </dev/null >/dev/null 2>&1 &
    _iw=$!
    wait "$_ip"
    _irc=$?
    kill "$_iw" 2>/dev/null
    return "$_irc"
}

if [ "$KEENETIC" = 1 ]; then
    iptables() {
        if [ "$1" = -t ] && [ "$2" = raw ]; then
            raw_ok || return 1
            _ib=$RAW_IPT
        else
            _ib=$IPT_BIN
        fi
        # NDM перестраивает таблицы параллельно с хуком: без -w вызов в этот
        # момент сразу падает «xtables lock», и правило молча не встаёт.
        [ -n "$IPT_W" ] || { "$IPT_BIN" --help 2>&1 | grep -q -- '--wait' && IPT_W=-w || IPT_W=none; }
        if [ "$IPT_W" = -w ] && [ "$_ib" = "$IPT_BIN" ]; then
            run_limited 10 "$_ib" -w "$@"
        else
            run_limited 10 "$_ib" "$@"
        fi
        _irc=$?
        [ "$_irc" = 137 ] && log "iptables $* завис — снят через 10 с"
        return "$_irc"
    }
fi

# Отвечает ли таблица raw (на неё опирается NOTRACK входа VLESS). Проба — раз
# за загрузку: сначала iptables Entware, затем системный NDM.
raw_ok() {
    [ "$KEENETIC" = 1 ] || return 0
    if [ -z "$RAW_STATE" ]; then
        f="$RUN/detour-server.raw"
        boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
        [ -f "$f" ] && [ "$(sed -n 1p "$f")" = "$boot" ] && RAW_STATE=$(sed -n 2p "$f")
        if [ -z "$RAW_STATE" ]; then
            RAW_STATE=bad
            for b in "$IPT_BIN" /usr/sbin/iptables; do
                [ -x "$b" ] || continue
                if run_limited 5 "$b" -t raw -S OUTPUT >/dev/null 2>&1; then RAW_STATE=$b; break; fi
            done
            [ "$RAW_STATE" = bad ] && log "таблица raw не отвечает ни в одном iptables — VLESS недоступен"
            mkdir -p "$RUN" && printf '%s\n%s\n' "$boot" "$RAW_STATE" > "$f"
        fi
    fi
    [ "$RAW_STATE" = bad ] && return 1
    RAW_IPT=$RAW_STATE
}

# Снять iptables, которые висят дольше минуты (остались от прошлых версий или
# ушли в цикл на ядре): живой вызов столько не работает.
kill_stuck_ipt() {
    [ "$KEENETIC" = 1 ] || return 0
    up=$(cut -d. -f1 /proc/uptime)
    for d in /proc/[0-9]*; do
        [ "$(cat "$d/comm" 2>/dev/null)" = iptables ] || continue
        st=$(awk '{ print int($22 / 100) }' "$d/stat" 2>/dev/null)
        [ -n "$st" ] && [ $((up - st)) -gt 60 ] || continue
        log "снят зависший iptables (pid ${d#/proc/}, $((up - st)) с): $(tr '\000' ' ' < "$d/cmdline" 2>/dev/null)"
        kill -9 "${d#/proc/}" 2>/dev/null
    done
}

json_esc() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'
}

err() { printf '{"ok":false,"error":"%s"}\n' "$(json_esc "$1")"; exit 0; }

lock() {
    mkdir -p "$RUN"
    i=0
    while ! mkdir "$LOCK" 2>/dev/null; do
        i=$((i + 1))
        # Брошенный замок (процесс убит) — не вечная блокировка.
        [ "$i" -ge 30 ] && { rm -rf "$LOCK"; continue; }
        sleep 1
    done
    trap 'rm -rf "$LOCK"' EXIT INT TERM
}

# ---------- поддержка платформы ----------

# Пустой вывод = поддерживается; иначе причина.
unsupported_reason() {
    if [ "$KEENETIC" = 0 ]; then
        command -v awg >/dev/null 2>&1 || { echo "not_installed"; return; }
    fi
    [ -n "$(backend)" ] || echo "not_installed"
}

# kernel — модуль amneziawg (GL.iNet); ndm — встроенный WireGuard KeeneticOS;
# userspace — amneziawg-go на /dev/net/tun (чистая OpenWrt, Detour в контейнере
# на Linux-сервере, Keenetic без компонента WireGuard).
backend() {
    if [ "$KEENETIC" = 1 ]; then
        if ndm_wg; then echo ndm; return; fi
    elif lsmod 2>/dev/null | grep -q '^amneziawg ' || modprobe amneziawg 2>/dev/null; then
        echo kernel; return
    fi
    if command -v amneziawg-go >/dev/null 2>&1 && [ -c /dev/net/tun ]; then
        echo userspace
    fi
}

# Есть ли пакеты в доступных фидах (для кнопки «Установить»).
installable() {
    if [ "$KEENETIC" = 1 ]; then
        # detour-awg-go лежит в mipsel-фиде Detour; ставит detour-update curl'ом.
        [ -c /dev/net/tun ]
        return
    fi
    if [ -f /etc/apk/world ] && command -v apk >/dev/null 2>&1; then
        apk search -e kmod-amneziawg 2>/dev/null | grep -q . && return 0
    else
        opkg list kmod-amneziawg 2>/dev/null | grep -q . && return 0
    fi
    # Модуля в фиде прошивки нет — detour-update поставит userspace
    # detour-awg-go из фида Detour; ему нужен только TUN.
    [ -c /dev/net/tun ] || modprobe tun 2>/dev/null
}

awg_ok() { [ -z "$(unsupported_reason)" ]; }

# VLESS: нужен sing-box и ip с netns (ip-full; у busybox ip его нет).
# Пустой вывод = поддерживается; netns — не хватает ip-full.
vless_reason() {
    sb=$(vless_sb)
    [ -n "$sb" ] || { echo "sing-box не установлен"; return; }
    # Reality-сервер sing-box 1.13.x отвергает всех клиентов («processed
    # invalid connection», проверено и на upstream 1.13.21), 1.14 — работает.
    # Родной фид OpenWrt 25.12 пока даёт 1.13.x.
    # Запуск sing-box ради версии на MT7621 — секунды, а status зовёт это на
    # каждый опрос панели: кэш по пути и времени изменения бинарника.
    vc="$RUN/detour-server.sbver"
    key="$sb $(date -r "$sb" +%s 2>/dev/null)"
    v=""
    [ -f "$vc" ] && [ "$(sed -n 1p "$vc")" = "$key" ] && v=$(sed -n 2p "$vc")
    if [ -z "$v" ]; then
        v=$("$sb" version 2>/dev/null | sed -n '1s/.*version \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
        [ -n "$v" ] && mkdir -p "$RUN" && printf '%s\n%s\n' "$key" "$v" > "$vc"
    fi
    set -- $v
    if [ -n "$2" ] && [ "$1" -eq 1 ] && [ "$2" -lt 14 ]; then
        echo "Для VLESS-Reality нужен sing-box 1.14 или новее, здесь $1.$2"
        return
    fi
    # Keenetic: сетевых пространств в ядре нет — вход живёт в общем, а нужны
    # veth, onlink и `ip rule … iif lo` из ip-full (у busybox ip их нет).
    if [ "$KEENETIC" = 1 ]; then
        [ -x "$KIP" ] || { echo netns; return; }
        raw_ok || echo "Таблица raw iptables на этой прошивке не отвечает — без неё вход VLESS не принимает трафик"
        return
    fi
    ip netns list >/dev/null 2>&1 || echo netns
}

# Бинарник входа VLESS: отдельный sing-box-vless (образ Linux-сервера кладёт
# upstream 1.14, не трогая пакет прошивки), иначе общий.
vless_sb() {
    command -v sing-box-vless 2>/dev/null || command -v sing-box 2>/dev/null
}

vless_ok() { [ -z "$(vless_reason)" ]; }

ipfull_installable() {
    [ "$KEENETIC" = 1 ] && return 0
    if [ -f /etc/apk/world ] && command -v apk >/dev/null 2>&1; then
        apk search -e ip-full 2>/dev/null | grep -q .
    else
        opkg list ip-full 2>/dev/null | grep -q .
    fi
}

# Ключи WireGuard: awg, а без него (встроенный WireGuard Keenetic) — sing-box.
# Результат — в KP_PRIV/KP_PUB.
wg_keypair() {
    KP_PRIV=""; KP_PUB=""
    if command -v awg >/dev/null 2>&1; then
        KP_PRIV=$(awg genkey) && KP_PUB=$(printf '%s' "$KP_PRIV" | awg pubkey)
    else
        kp=$(sing-box generate wg-keypair 2>/dev/null)
        KP_PRIV=$(printf '%s\n' "$kp" | sed -n 's/^PrivateKey: *//p')
        KP_PUB=$(printf '%s\n' "$kp" | sed -n 's/^PublicKey: *//p')
    fi
    [ -n "$KP_PRIV" ] && [ -n "$KP_PUB" ]
}

wg_psk() {
    if command -v awg >/dev/null 2>&1; then awg genpsk
    else sing-box generate rand 32 --base64 2>/dev/null
    fi
}

# ---------- конфиг ----------

rand_u32() {
    hexdump -n 4 -v -e '/4 "%u"' /dev/urandom 2>/dev/null || \
        od -An -N4 -tu4 /dev/urandom | tr -d ' '
}

rand_range() {  # $1 min $2 max
    r=$(rand_u32)
    echo $(( $1 + r % ($2 - $1 + 1) ))
}

port_busy() {
    netstat -lnu 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" { f = 1 } END { exit !f }'
}

# TCP-порт VLESS: DNAT с WAN перекрыл бы снаружи любой слушающий его сервис
# роутера (nginx на 443 и т. п.) и любой чужой проброс того же порта.
tcp_port_busy() {
    netstat -lnt 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" { f = 1 } END { exit !f }' && return 0
    command -v uci >/dev/null 2>&1 || return 1
    uci -q show firewall 2>/dev/null | grep -v -e "^firewall\.${ZONE}_vin\." -e "^firewall\.${ZONE}_tin\." -e "^firewall\.${ZONE}_win\." -e "^firewall\.${ZONE}_xin\." | \
        grep -qE "\.(src_dport|dest_port)='$1'$"
}

gen_obf() {
    JC=$(rand_range 4 10)
    JMIN=$(rand_range 40 80)
    JMAX=$(rand_range 300 800)
    S1=$(rand_range 15 120)
    # S1 + 56 == S2 делает init и response одной длины — запрещено протоколом.
    while :; do
        S2=$(rand_range 15 120)
        [ $((S1 + 56)) -ne "$S2" ] && [ "$S1" -ne "$S2" ] && break
    done
    # H1..H4 различны и не попадают в 1..4 (типы сообщений обычного WireGuard).
    H1=$(rand_range 5 2147483647)
    while :; do H2=$(rand_range 5 2147483647); [ "$H2" != "$H1" ] && break; done
    while :; do H3=$(rand_range 5 2147483647); [ "$H3" != "$H1" ] && [ "$H3" != "$H2" ] && break; done
    while :; do H4=$(rand_range 5 2147483647); [ "$H4" != "$H1" ] && [ "$H4" != "$H2" ] && [ "$H4" != "$H3" ] && break; done
}

