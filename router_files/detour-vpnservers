#!/bin/sh
# Detour — набор singbox_vpnservers: адреса VPN-серверов ВСЕХ профилей.
#
# Зачем. Мимо перехвата раньше шли только серверы активной цепочки
# (upstream_ips). Устройство в сети со своим VPN-клиентом (клиент Detour, другое
# приложение с теми же профилями) ходит на сервер НЕактивного профиля — и роутер
# заворачивал это подключение в активный VPN: туннель в туннеле, который у
# провайдеров обычно не открывается («open connection … context deadline
# exceeded»). Правила перехвата (TCP-цепочки, UDP_VPN, устройства, «Все через
# VPN») делают по этому набору RETURN, то есть такие подключения идут напрямую.
#
# Источники: кэш detour-geo (geo.db — там уже разрешённые адреса всех профилей,
# включая wireguard-пиров) плюс IP-литералы "server" из самих профилей — на
# случай, когда geo.db ещё не собран. Домены здесь не резолвим: на 80+ профилей
# это минуты, а detour-geo делает это сам в фоне.
#
#   detour-vpnservers load   — пересобрать набор (атомарно, через ipset swap)
#   detour-vpnservers list   — напечатать пары «ip,протокол:порт»

SET=singbox_vpnservers
if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    GEO_DB=/opt/etc/detour/geo.db
    PROFILES=/opt/etc/sing-box/profiles
else
    GEO_DB=/etc/detour/geo.db
    PROFILES=/etc/sing-box/profiles
fi

# «ip,tcp:порт» и «ip,udp:порт» для каждого профиля. Именно пара адрес+порт, а
# не весь адрес: у CDN-профилей (VLESS/WS за Cloudflare) сервер — общий IP
# CDN, и пустить его мимо VPN целиком значило бы пустить мимо и чужие сайты на
# нём. Профиль без порта пропускаем.
addrs() {
    for f in "$PROFILES"/*.json; do
        [ -f "$f" ] || continue
        id=${f##*/}; id=${id%.json}
        flat=$(tr ',{}[]' '\n\n\n\n\n' < "$f")
        ports=$(printf '%s\n' "$flat" | sed -n 's/.*"\(server_port\|port\)"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\2/p' | sort -u)
        [ -n "$ports" ] || continue
        {
            [ -f "$GEO_DB" ] && awk -F'\t' -v id="$id" '$1 == id { print $2 }' "$GEO_DB"
            printf '%s\n' "$flat" | sed -n 's/.*"\(server\|address\)"[[:space:]]*:[[:space:]]*"\([0-9.]*\)".*/\2/p'
        } | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | \
            grep -vE '^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.|0\.)' | \
        while read -r ip; do
            for p in $ports; do
                echo "$ip,tcp:$p"
                echo "$ip,udp:$p"
            done
        done
    done | awk '!seen[$0]++'
}

load() {
    ipset create "$SET" hash:ip,port -exist 2>/dev/null || return 1
    tmp="${SET}_new"
    ipset destroy "$tmp" 2>/dev/null
    ipset create "$tmp" hash:ip,port 2>/dev/null || return 1
    addrs | sed "s/^/add $tmp /" | ipset restore -exist 2>/dev/null
    ipset swap "$tmp" "$SET" && ipset destroy "$tmp"
}

case "$1" in
    load) load ;;
    list) addrs ;;
    *) echo "usage: $0 {load|list}"; exit 1 ;;
esac
