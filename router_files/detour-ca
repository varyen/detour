# Проверка — только для AdGuard. Шаг 1: служебный http://local.adguard.org/cert.cer
# отвечает (с CORS «*») лишь через сам фильтр — значит, устройство в фильтре.
# Шаг 2: обычный HTTPS-сайт, который фильтр вскрывает своим сертификатом:
# открылся — сертификату доверяют. Сам https://local.adguard.org для этого не
# годится: sing-box отдаёт прокси CONNECT на IP, и AdGuard пропускает такое
# соединение насквозь к настоящему адресу, который по HTTPS не отвечает.
if [ "$FROM" = adguard ]; then
cat <<'HTML'
<div class="card">
<h2>Проверить</h2>
<p class="dim">После установки нажмите — устройство попробует открыть служебную страницу фильтра.</p>
<button class="btn sec" id="check" type="button">Проверить сертификат</button>
<p class="res" id="res"></p>
</div>
<script>
(function () {
  var res = document.getElementById("res");
  function probe(url, opts) {
    var ctl = "AbortController" in window ? new AbortController() : null;
    var t = setTimeout(function () { if (ctl) ctl.abort(); }, 6000);
    opts.cache = "no-store";
    if (ctl) opts.signal = ctl.signal;
    return fetch(url + (url.indexOf("?") < 0 ? "?" : "&") + "t=" + Date.now(), opts)
      .then(function (r) { clearTimeout(t); return r; }, function (e) { clearTimeout(t); throw e; });
  }
  function say(ok, text) { res.className = "res " + (ok ? "ok" : "bad"); res.textContent = text; }
  document.getElementById("check").onclick = function () {
    res.className = "res"; res.textContent = "Проверяю…";
    var viaFilter = location.protocol === "https:"
      ? Promise.resolve(null)
      : probe("http://local.adguard.org/cert.cer", {}).then(function (r) { return r.ok; }, function () { return false; });
    viaFilter.then(function (through) {
      if (through === false) {
        say(false, "Это устройство идёт мимо фильтра: в панели Detour для него не включён «Фильтр HTTPS» или фильтр сейчас недоступен.");
        return;
      }
      probe("https://www.gstatic.com/generate_204", { mode: "no-cors" }).then(function () {
        say(true, "Готово: сертификат установлен, сайты идут через фильтр.");
      }, function () {
        say(false, "Сертификат ещё не доверен. Пройдите шаги выше до конца — на iPhone не забудьте «Доверие сертификатам».");
      });
    });
  };
})();
</script>
HTML
fi

