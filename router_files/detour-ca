#!/bin/sh
# detour-ca — страница установки корневого сертификата «Фильтра HTTPS» для
# устройств в сети. Без входа в панель, нарочно: сертификат публичный (его и
# так раздаёт сам фильтр), а ставить его будут на телефонах, у владельцев
# которых учётки панели нет. Ничего из запроса в ответ не попадает.
#
#   /cgi-bin/detour-ca                    страница: шаги под систему устройства, проверка
#   /cgi-bin/detour-ca?f=crt              DER  (Android, Windows)
#   /cgi-bin/detour-ca?f=pem              PEM  (Linux, Firefox)
#   /cgi-bin/detour-ca?f=mobileconfig     профиль iOS, iPadOS, macOS

FILTER_BIN=/usr/sbin/detour-filter
if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    FILTER_BIN=/opt/sbin/detour-filter
fi

F=$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/^\(.*&\)\{0,1\}f=\([a-z]*\).*/\2/p')

file_out() { # $1 тип, $2 имя файла, $3 команда detour-filter
    local tmp="/tmp/detour-ca.$$"
    if ! "$FILTER_BIN" "$3" > "$tmp" 2>/dev/null || [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        printf 'Status: 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nСертификата фильтра пока нет.\n'
        exit 0
    fi
    printf 'Content-Type: %s\r\nContent-Disposition: attachment; filename="%s"\r\nContent-Length: %s\r\nCache-Control: no-store\r\n\r\n' \
        "$1" "$2" "$(wc -c < "$tmp" | tr -d ' ')"
    cat "$tmp"
    rm -f "$tmp"
    exit 0
}

case "$F" in
    crt) file_out application/x-x509-ca-cert detour-filter-ca.crt ca-der ;;
    pem) file_out application/x-pem-file detour-filter-ca.pem ca-pem ;;
    mobileconfig) file_out application/x-apple-aspen-config detour-filter-ca.mobileconfig ca-mobileconfig ;;
esac

INFO='{"present":false}'
[ -x "$FILTER_BIN" ] && INFO=$("$FILTER_BIN" ca-info 2>/dev/null)
val() { printf '%s' "$INFO" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
PRESENT=false
case "$INFO" in *'"present":true'*) PRESENT=true ;; esac
SHA=$(val sha256); SUBJ=$(val subject); UNTIL=$(val not_after); FROM=$(val from)
SUBJ_CN=$(printf '%s' "$SUBJ" | sed -n 's/.*CN *= *\([^,]*\).*/\1/p')
[ -n "$SUBJ_CN" ] || SUBJ_CN=$SUBJ
UNTIL_HTML=""
UNTIL=$(printf '%s' "$UNTIL" | awk -F- 'NF == 3 { print $3 "." $2 "." $1 }')
[ -n "$UNTIL" ] && UNTIL_HTML=" <span class=\"dim\">· действует до $UNTIL</span>"

printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
cat <<'HTML'
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Сертификат фильтра HTTPS</title>
<style>
:root { --bg: #f6f7f9; --card: #fff; --ink: #15181d; --dim: #5b6470; --line: #dde1e6; --accent: #1b7f9e; --ok: #1f8a5b; --bad: #c0392b; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #0f1216; --card: #171b21; --ink: #e8ebef; --dim: #9aa3ad; --line: #2a3038; --accent: #4cc3e0; --ok: #4ec98a; --bad: #ef6b5c; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 640px; margin: 0 auto; padding: 20px 16px 40px; }
h1 { font-size: 22px; margin: 4px 0 8px; }
h2 { font-size: 17px; margin: 0 0 8px; }
p { margin: 0 0 10px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin: 14px 0; }
.dim { color: var(--dim); font-size: 14px; }
.fp { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12.5px; word-break: break-all; color: var(--dim); }
.btn { display: inline-block; background: var(--accent); color: #fff; text-decoration: none; border: 0; border-radius: 10px; padding: 12px 18px; font: inherit; font-weight: 600; min-height: 46px; cursor: pointer; }
.btn.sec { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
ol { margin: 10px 0 0; padding-left: 22px; }
li { margin: 6px 0; }
details { margin-top: 8px; }
summary { cursor: pointer; font-weight: 600; padding: 6px 0; }
.os { display: none; }
.os.on { display: block; }
.res { margin-top: 10px; font-weight: 600; }
