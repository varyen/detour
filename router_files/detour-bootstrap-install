#!/bin/sh
# detour-bootstrap-install — first-install helper for feed + runtime binaries.
#
# The panel package itself is intentionally installable without pre-seeding our
# opkg feed. After the panel lands, this helper uses the just-installed
# detour-update logic to add the correct feed and install/upgrade sing-box and
# tpws-zapret in the background.
#
# ⚠ ФАЙЛ ОБЯЗАН ЛЕЖАТЬ С LF. Он уже один раз уехал в релиз с CRLF: ядро берёт
# путь интерпретатора из шебанга дословно до перевода строки, `#!/bin/sh\r` не
# резолвится, а зовут отсюда в фоне с выводом в /dev/null — поэтому первичная
# установка sing-box/tpws просто не происходила и никто этого не видел. Теперь
# это ловят .gitattributes и проверка в build_release.py.

set +e

PLATFORM=openwrt
UPDATE_BIN=/usr/sbin/detour-update
FEED_CONF=/etc/opkg/customfeeds.conf
FEED_NAME=detour
LOG=/var/log/detour-bootstrap.log
SINGBOX_BIN=/usr/bin/sing-box
TPWS_BIN=/usr/bin/tpws-zapret

if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    PLATFORM=keenetic
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    UPDATE_BIN=/opt/sbin/detour-update
    FEED_CONF=/opt/etc/opkg/customfeeds.conf
    LOG=/opt/var/log/detour-bootstrap.log
    SINGBOX_BIN=/opt/bin/sing-box
    TPWS_BIN=/opt/sbin/tpws-zapret
    mkdir -p /opt/etc/opkg /opt/var/log /opt/var/state 2>/dev/null
fi

# Пакетный менеджер. OpenWrt 25.12+ идёт с apk-tools 3 вместо opkg; детект тот
# же, что в detour-update (каталог /etc/opkg там остаётся, opkg — нет).
PKGM=opkg
if [ -f /etc/apk/world ] && command -v apk >/dev/null 2>&1; then
    PKGM=apk
    PLATFORM=openwrt-apk
    # Своего фида на apk нет: sing-box берём из родного фида дистрибутива.
    FEED_CONF=""
fi

mkdir -p "$(dirname "$LOG")" 2>/dev/null

timestamp() {
    date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown-time
}

log() {
    printf '%s [detour-bootstrap] %s\n' "$(timestamp)" "$*" >> "$LOG" 2>/dev/null
}

run_cmd() {
    log "+ $*"
    "$@" >> "$LOG" 2>&1
    rc=$?
    log "rc=$rc :: $*"
    return $rc
}

dump_file() {
    _path="$1"
    if [ -f "$_path" ]; then
        log "--- BEGIN $_path ---"
        sed 's/^/    /' "$_path" >> "$LOG" 2>&1
        log "--- END $_path ---"
    else
        log "missing file: $_path"
    fi
}

dump_runtime_state() {
    if [ "$PKGM" = apk ]; then run_cmd apk list -I; else run_cmd opkg list-installed; fi
    [ -n "$SINGBOX_BIN" ] && run_cmd ls -l "$SINGBOX_BIN"
    [ -n "$TPWS_BIN" ] && run_cmd ls -l "$TPWS_BIN"
}

pkg_installed() {
    if [ "$PKGM" = apk ]; then
        apk info -e "$1" 2>/dev/null | grep -q "^$1$"
    else
        opkg list-installed "$1" 2>/dev/null | grep -q "^$1 "
    fi
}

feed_present() {
    # На apk своего фида нет — считаем условие выполненным, иначе бутстрап
    # крутился бы вхолостую на каждой установке.
    [ -z "$FEED_CONF" ] && return 0
    grep -qs "^src/gz $FEED_NAME " "$FEED_CONF" 2>/dev/null
}

# postinst зовёт нас в фоне, пока внешний `opkg install` панели ещё держит
# блокировку. Тогда `opkg list-installed` падает (rc=255), и всё ниже решало
# «sing-box не установлен», гоняло четыре `opkg update` в ту же блокировку и
# писало «install of sing-box failed» на роутере, где всё давно стоит (home,
# обновление 2.1.3 → 2.2.0). Ждём, пока менеджер отпустит базу.
pkgm_ready() {
    if [ "$PKGM" = apk ]; then apk info >/dev/null 2>&1; else opkg list-installed >/dev/null 2>&1; fi
}
_w=0
while ! pkgm_ready; do
    _w=$((_w + 1))
    if [ "$_w" -gt 90 ]; then
        log "skip: $PKGM занят дольше 3 минут — список пакетов не прочитать, решать вслепую не будем"
        exit 0
    fi
    sleep 2
done
[ "$_w" -gt 0 ] && log "$PKGM освободился через ~$((_w * 2)) с"

# Чистая OpenWrt 22.03+ приходит без iptables (только nftables), а перехват
# трафика сделан на нём. На apk его приносит Depends пакета, на opkg — этот шаг.
need_iptables=0
[ "$PLATFORM" = keenetic ] || command -v iptables >/dev/null 2>&1 || need_iptables=1

# AmneziaWG-профили без mihomo не поднимаются, а он не зависимость панели.
# Профили уже есть при переустановке панели; решение «ставить или нет» (движок
# «singbox» AWG выключает) принимает detour-update mihomo-ensure.
PROFILES_DIR=/etc/sing-box/profiles
[ "$PLATFORM" = keenetic ] && PROFILES_DIR=/opt/etc/sing-box/profiles
need_mihomo=0
if grep -qs '"type"[[:space:]]*:[[:space:]]*"amneziawg"' "$PROFILES_DIR"/*.json    && ! pkg_installed mihomo; then
    need_mihomo=1
fi

need_bootstrap=0
feed_present || need_bootstrap=1
pkg_installed sing-box || need_bootstrap=1
pkg_installed tpws-zapret || need_bootstrap=1
[ "$need_iptables" = 1 ] && need_bootstrap=1
[ "$need_mihomo" = 1 ] && need_bootstrap=1

if [ "$need_bootstrap" != "1" ]; then
    log "bootstrap decision: feed_present=$(feed_present && echo yes || echo no) sing-box=$(pkg_installed sing-box && echo yes || echo no) tpws=$(pkg_installed tpws-zapret && echo yes || echo no)"
    log "skip: feed and runtime packages are already present"
    exit 0
fi

if [ ! -x "$UPDATE_BIN" ]; then
    log "skip: updater missing at $UPDATE_BIN"
    exit 0
fi

log "==== bootstrap start pid=$$ platform=$PLATFORM ===="
log "PATH=$PATH"
log "UPDATE_BIN=$UPDATE_BIN FEED_CONF=$FEED_CONF SINGBOX_BIN=$SINGBOX_BIN TPWS_BIN=$TPWS_BIN"
run_cmd uname -a
if [ "$PKGM" = apk ]; then
    run_cmd apk --version
    run_cmd cat /etc/apk/arch
else
    run_cmd opkg --version
    run_cmd opkg print-architecture
fi
dump_file "$FEED_CONF"
dump_runtime_state

log "starting runtime bootstrap on $PLATFORM"
if [ "$need_iptables" = 1 ]; then
    run_cmd "$UPDATE_BIN" netfilter-ensure || log "WARNING: netfilter-ensure failed — трафик пойдёт мимо VPN, пока не появится iptables"
fi
run_cmd "$UPDATE_BIN" bins-apply || log "WARNING: bins-apply failed"
dump_file "$FEED_CONF"
# На apk tpws-zapret берётся curl'ом из нашего apk-фида (feed/apk-<семейство>).
run_cmd "$UPDATE_BIN" tpws-apply || log "WARNING: tpws-apply failed"
need_restart=0
if [ "$need_mihomo" = 1 ]; then
    run_cmd "$UPDATE_BIN" mihomo-ensure || log "WARNING: mihomo-ensure failed — AmneziaWG-профили не поднимутся, пока не встанет mihomo"
    pkg_installed mihomo && need_restart=1
fi
# sing-box мог стартовать до появления iptables — тогда правила перехвата не
# встали; перезапуск их ставит. После mihomo — чтобы AWG-хоп цепочки ожил.
[ "$need_iptables" = 1 ] && command -v iptables >/dev/null 2>&1 && need_restart=1
if [ "$need_restart" = 1 ]; then
    if [ "$PLATFORM" = keenetic ]; then
        [ -x /opt/etc/init.d/S52detour-singbox ] && run_cmd /opt/etc/init.d/S52detour-singbox restart
    else
        [ -x /etc/init.d/sing-box ] && run_cmd /etc/init.d/sing-box restart
    fi
fi
dump_runtime_state

if pkg_installed sing-box && pkg_installed tpws-zapret; then
    log "runtime bootstrap complete"
else
    log "runtime bootstrap incomplete — check feed reachability and rerun detour-update bins-apply / tpws-apply"
fi

log "==== bootstrap end pid=$$ ===="

exit 0