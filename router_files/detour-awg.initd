#!/bin/sh /etc/rc.common
# Detour — сайдкар mihomo для AmneziaWG-профилей (см. /usr/sbin/detour-awg).
# Стартует, только если есть AWG-профили и установлен mihomo; иначе no-op.

START=94
STOP=10
USE_PROCD=1

PROG=/usr/sbin/detour-awg
BIN=/usr/bin/mihomo

start_service() {
    [ -x "$PROG" ] && [ -x "$BIN" ] || return 0
    "$PROG" render >/dev/null 2>&1 || return 0
    procd_open_instance
    procd_set_param command "$PROG" run
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
