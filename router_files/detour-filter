#!/bin/sh
# detour-filter — «Фильтр HTTPS» для устройств: их TCP 80/443 идёт через внешний
# фильтрующий прокси (AdGuard для Windows в режиме HTTP-прокси, Privoxy и т. п.),
# всё остальное — общим путём роутера.
#
# Перехват делает механизм устройств: detour-api пишет в devices.map строку
# «mac filter <порт> 0 <url прокси>», init заводит цепочку SINGBOX_DEV_<N> с
# REDIRECT 80/443 на вход sing-box, исходящий которого — этот прокси. Здесь —
# то, чего правилам перехвата не хватает:
#
#   QUIC   HTTP/3 идёт по UDP 443 мимо прокси, и браузер с ним фильтра не видит.
#          UDP 443 устройства режется (REJECT — браузер сразу уходит на TCP), а
#          по IPv6 режутся и TCP 80/443: перехват только IPv4, и без этого браузер
#          с IPv6 ушёл бы мимо фильтра.
#   Сторож Прокси живёт на чужой машине, которую выключают. Пока он не отвечает,
#          REDIRECT уводит HTTPS устройства в никуда. tick проверяет прокси раз в
#          10 с; после двух неудач подряд первым правилом цепочки устройства
#          встаёт RETURN, и устройство идёт общим путём (FALLBACK=direct), пока
#          прокси не ответит снова. FALLBACK=block оставляет перехват — без
#          фильтра нет и HTTPS.
#
# Правила из apply держатся на состоянии (STATE), а не на памяти процесса:
# init пересобирает цепочки устройств на каждом рестарте sing-box, KeeneticOS —
# весь netfilter на любом своём событии, и оба зовут apply заново.
#
#   detour-filter apply                 правила по devices.map и STATE
#   detour-filter clear                 снять всё (sing-box остановлен)
#   detour-filter tick                  проверки прокси (cron раз в минуту, цикл внутри)
#   detour-filter status                JSON для панели
#   detour-filter set-fallback direct|block
#
# Корневой сертификат фильтра — без него устройства видят ошибку на каждом
# сайте. AdGuard отдаёт свой CA всем, кто ходит через его прокси, по
# http://local.adguard.org/cert.cer, поэтому роутер забирает его сам (tick — пока
# сертификата нет, не чаще раза в 10 минут); для других фильтров — загрузка из
# панели. Устройствам его раздаёт CGI detour-ca без входа в панель: сертификат
# публичный, а ставить его будут на чужих телефонах.
#
#   detour-filter ca-fetch [url]        забрать у прокси (по умолчанию — у всех из карты)
#   detour-filter ca-set <файл>         свой сертификат, PEM или DER
#   detour-filter ca-clear
#   detour-filter ca-info               JSON: отпечаток, имя, срок, откуда
#   detour-filter ca-der|ca-pem|ca-mobileconfig   сам сертификат для detour-ca

DEV_MAP=/etc/sing-box/devices.map
CONF=/etc/detour/filter.conf
CA_DER=/etc/detour/filter-ca.der
CA_META=/etc/detour/filter-ca.meta
CA_URL=http://local.adguard.org/cert.cer
CA_RETRY=600
STATE=/var/state/detour-filter.state
LOCK=/var/run/detour-filter.lock
PUSH_BIN=/usr/sbin/detour-push
CHAIN=DETOUR_FILTER
GATE=detour-filter-down
PROBE_URL=http://connectivitycheck.gstatic.com/generate_204
FAILS_DOWN=2
STEP=10
BUDGET=${FILTER_LOOP_BUDGET:-50}

if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    DEV_MAP=/opt/etc/sing-box/devices.map
    CONF=/opt/etc/detour/filter.conf
    CA_DER=/opt/etc/detour/filter-ca.der
    CA_META=/opt/etc/detour/filter-ca.meta
    STATE=/opt/var/state/detour-filter.state
    LOCK=/opt/var/run/detour-filter.lock
    PUSH_BIN=/opt/sbin/detour-push
fi
mkdir -p "${STATE%/*}" "${LOCK%/*}" 2>/dev/null

fallback() {
    case "$(sed -n 's/^FALLBACK=//p' "$CONF" 2>/dev/null | tail -1)" in
        block) echo block ;;
        *) echo direct ;;
    esac
}

# «N mac url» устройств с фильтром; N — номер строки карты, он же номер цепочки
# SINGBOX_DEV_N (init нумерует все строки карты подряд).
filter_devices() {
    [ -s "$DEV_MAP" ] || return 0
    awk '$1 != "" { n++; if ($2 == "filter" && $5 != "") print n, $1, $5 }' "$DEV_MAP"
}

proxy_state() { # $1 url → up|down (нет записи — up: не наказываем до первой проверки)
    awk -v p="$1" '$1 == p { s = $2 } END { print (s == "down" ? "down" : "up") }' "$STATE" 2>/dev/null
}

# Адрес прокси без схемы и учётки — для журнала, уведомлений и панели.
shown() { local a="${1#*://}"; echo "${a##*@}"; }

match_of() { case "$1" in *.*) echo "-s $1" ;; *) echo "-m mac --mac-source $1" ;; esac; }

ensure_jump() { # $1 iptables|ip6tables
    "$1" -N "$CHAIN" 2>/dev/null
    "$1" -F "$CHAIN"
    "$1" -C FORWARD -j "$CHAIN" 2>/dev/null || "$1" -I FORWARD 1 -j "$CHAIN"
}

drop_jump() {
    local t
    for t in iptables ip6tables; do
        command -v "$t" >/dev/null 2>&1 || continue
        while "$t" -D FORWARD -j "$CHAIN" 2>/dev/null; do :; done
        "$t" -F "$CHAIN" 2>/dev/null
        "$t" -X "$CHAIN" 2>/dev/null
    done
}

gate() { # $1 номер цепочки, $2 on|off
    local c="SINGBOX_DEV_$1"
    iptables -t nat -S "$c" >/dev/null 2>&1 || return 0
    while iptables -t nat -D "$c" -m comment --comment "$GATE" -j RETURN 2>/dev/null; do :; done
    [ "$2" = on ] && iptables -t nat -I "$c" 1 -m comment --comment "$GATE" -j RETURN
}

cmd_apply() {
    local list fb n mac url m have6=""
    list=$(filter_devices)
    if [ -z "$list" ]; then drop_jump; return 0; fi
    fb=$(fallback)
    ensure_jump iptables
    command -v ip6tables >/dev/null 2>&1 && { ensure_jump ip6tables; have6=1; }
    echo "$list" | while read -r n mac url; do
        m=$(match_of "$mac")
        if [ "$(proxy_state "$url")" = down ] && [ "$fb" = direct ]; then
            gate "$n" on
            continue
        fi
        gate "$n" off
        iptables -A "$CHAIN" $m -p udp --dport 443 -j REJECT --reject-with icmp-port-unreachable
        case "$mac" in *.*) continue ;; esac
        [ -n "$have6" ] || continue
        ip6tables -A "$CHAIN" $m -p udp --dport 443 -j REJECT
        ip6tables -A "$CHAIN" $m -p tcp -m multiport --dports 80,443 -j REJECT --reject-with tcp-reset 2>/dev/null || {
            ip6tables -A "$CHAIN" $m -p tcp --dport 80 -j REJECT --reject-with tcp-reset
            ip6tables -A "$CHAIN" $m -p tcp --dport 443 -j REJECT --reject-with tcp-reset
        }
    done
}

probe() { # $1 url → 0, если прокси довёл запрос
    curl -s -o /dev/null --connect-timeout 3 -m 8 -x "$1" "$PROBE_URL" 2>/dev/null
}

push_alert() {
    [ -x "$PUSH_BIN" ] || return 0
    "$PUSH_BIN" send "$1" "$2" >/dev/null 2>&1
}

# Одна проверка всех прокси. Печатает 1, если чьё-то состояние сменилось.
check_once() {
    local urls url st fails since now new changed="" tmp
    urls=$(filter_devices | awk '{ print $3 }' | sort -u)
    [ -n "$urls" ] || return 0
    now=$(date +%s)
    tmp="$STATE.$$"
    : > "$tmp"
    for url in $urls; do
        set -- $(awk -v p="$url" '$1 == p { print $2, $3, $4 }' "$STATE" 2>/dev/null)
        st=${1:-up}; fails=${2:-0}; since=${3:-$now}
        if probe "$url"; then
            fails=0; new=up
        else
            fails=$((fails + 1))
            [ "$fails" -ge "$FAILS_DOWN" ] && new=down || new=$st
        fi
        if [ "$new" != "$st" ]; then
            since=$now; changed=1
            report "$url" "$new"
        fi
        echo "$url $new $fails $since" >> "$tmp"
    done
    mv "$tmp" "$STATE"
    [ -n "$changed" ] && echo 1
}

report() { # $1 url, $2 новое состояние
    local where
    where=$(shown "$1")
    if [ "$2" = down ]; then
        logger -t detour-filter "прокси $where не отвечает — фолбэк: $(fallback)"
        if [ "$(fallback)" = direct ]; then
            push_alert "Detour: фильтр HTTPS недоступен" "Прокси $where не отвечает. Устройства с фильтром идут без него."
        else
            push_alert "Detour: фильтр HTTPS недоступен" "Прокси $where не отвечает. У устройств с фильтром нет HTTPS, пока он не вернётся."
        fi
    else
        logger -t detour-filter "прокси $where снова отвечает"
        push_alert "Detour: фильтр HTTPS снова работает" "Прокси $where отвечает, устройства снова идут через него."
    fi
}

cmd_tick() {
    local start
    [ -n "$(filter_devices)" ] || { rm -f "$STATE"; return 0; }
    mkdir "$LOCK" 2>/dev/null || {
        # Зависший прошлый тик (снят по питанию) не должен блокировать навсегда.
        [ -n "$(find "$LOCK" -maxdepth 0 -mmin +5 2>/dev/null)" ] || return 0
        rmdir "$LOCK" 2>/dev/null; mkdir "$LOCK" 2>/dev/null || return 0
    }
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
    start=$(date +%s)
    while :; do
        [ -n "$(check_once)" ] && cmd_apply
        ca_auto
        [ $(( $(date +%s) - start + STEP )) -le "$BUDGET" ] || break
        sleep "$STEP"
    done
}

cmd_status() {
    local fb first=1 n mac url st since
    fb=$(fallback)
    printf '{"fallback":"%s","devices":[' "$fb"
    filter_devices | while read -r n mac url; do
        set -- $(awk -v p="$url" '$1 == p { print $2, $4 }' "$STATE" 2>/dev/null)
        st=${1:-unknown}; since=${2:-0}
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"mac":"%s","proxy":"%s","state":"%s","since":%s}' "$mac" "$(shown "$url")" "$st" "$since"
    done
    printf ']}\n'
}

# ---- корневой сертификат фильтра ----

# base64 силами Lua: у busybox на части прошивок нет апплета base64, а у
# Keenetic нет и openssl. $1 — enc (stdin → одна строка) или dec.
B64_LUA=$(cat <<'LUA'
local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local d = io.read("*a") or ""
local out = {}
if os.getenv("B64_MODE") == "enc" then
  for i = 1, #d, 3 do
    local a, b, c = d:byte(i, i + 2)
    local n = a * 65536 + (b or 0) * 256 + (c or 0)
    local s = ""
    for k = 3, 0, -1 do
      local v = math.floor(n / 64 ^ k) % 64
      s = s .. A:sub(v + 1, v + 1)
    end
    if not b then s = s:sub(1, 2) .. "==" elseif not c then s = s:sub(1, 3) .. "=" end
    out[#out + 1] = s
  end
  io.write(table.concat(out))
else
  local map = {}
  for i = 1, 64 do map[A:byte(i)] = i - 1 end
  local acc, bits = 0, 0
  for ch in d:gmatch(".") do
    local v = map[ch:byte()]
    if v then
      acc = acc * 64 + v; bits = bits + 6
      if bits >= 8 then
        bits = bits - 8
        local byte = math.floor(acc / 2 ^ bits)
        out[#out + 1] = string.char(byte)
        acc = acc - byte * 2 ^ bits
      end
    end
  end
  io.write(table.concat(out))
end
LUA
)
# Программа — в -e: stdin занят данными.
b64() { B64_MODE="$1" lua -e "$B64_LUA"; }

# DER X.509 начинается с SEQUENCE (0x30) и весит от сотен байт до пары КБ;
# HTML-страница или ошибка прокси сюда не пройдут.
is_der() {
    [ -s "$1" ] || return 1
    # 0x30 — это ASCII «0»: od есть не во всякой сборке busybox.
    [ "$(head -c 1 "$1")" = 0 ] || return 1
    [ "$(wc -c < "$1")" -lt 20000 ] || return 1
    command -v openssl >/dev/null 2>&1 || return 0
    openssl x509 -inform DER -in "$1" -noout 2>/dev/null
}

ca_store() { # $1 — проверенный DER, $2 — откуда, $3 — adguard|manual
    mkdir -p "${CA_DER%/*}"
    mv "$1" "$CA_DER"
    chmod 644 "$CA_DER"
    printf 'SRC=%s\nFROM=%s\nTS=%s\n' "$2" "$3" "$(date +%s)" > "$CA_META"
}

meta() { sed -n "s/^$1=//p" "$CA_META" 2>/dev/null | tail -1; }

cmd_ca_fetch() {
    local urls url tmp="$CA_DER.new"
    urls=${1:-$(filter_devices | awk '{ print $3 }' | sort -u)}
    [ -n "$urls" ] || { echo "нет устройств с фильтром — не у кого забирать сертификат" >&2; return 1; }
    mkdir -p "${CA_DER%/*}"
    for url in $urls; do
        rm -f "$tmp"
        curl -fsS --connect-timeout 3 -m 10 -x "$url" -o "$tmp" "$CA_URL" 2>/dev/null || continue
        if is_der "$tmp"; then
            ca_store "$tmp" "$(shown "$url")" adguard
            logger -t detour-filter "сертификат фильтра получен от $(shown "$url")"
            echo "ok $(shown "$url")"
            return 0
        fi
    done
    rm -f "$tmp"
    echo "прокси не отдал сертификат: это не AdGuard или он не отвечает — загрузите сертификат вручную" >&2
    return 1
}

# Сам — пока сертификата нет: AdGuard мог быть выключен в момент сохранения
# правила. Не чаще раза в CA_RETRY: у других фильтров этого адреса нет вовсе.
ca_auto() {
    local try="${STATE%/*}/detour-filter.ca-try" now last
    [ -s "$CA_DER" ] && return 0
    now=$(date +%s); last=$(cat "$try" 2>/dev/null)
    [ $((now - ${last:-0})) -ge "$CA_RETRY" ] || return 0
    echo "$now" > "$try"
    cmd_ca_fetch >/dev/null 2>&1
}

cmd_ca_set() {
    local src="$1" tmp="$CA_DER.new"
    [ -s "$src" ] || { echo "пустой файл" >&2; return 1; }
    if grep -q 'BEGIN CERTIFICATE' "$src" 2>/dev/null; then
        tr -d '\r' < "$src" | awk '/BEGIN CERTIFICATE/ { on = 1; next } /END CERTIFICATE/ { exit } on' | b64 dec > "$tmp"
    else
        cp "$src" "$tmp"
    fi
    if ! is_der "$tmp"; then
        rm -f "$tmp"
        echo "это не сертификат X.509 (нужен .crt, .cer или .pem)" >&2
        return 1
    fi
    ca_store "$tmp" "${2:-загружен вручную}" manual
    echo ok
}

ca_sha256() {
    local h
    if command -v sha256sum >/dev/null 2>&1; then
        h=$(sha256sum "$CA_DER" | cut -d' ' -f1)
    else
        h=$(openssl dgst -sha256 -r "$CA_DER" 2>/dev/null | cut -d' ' -f1)
    fi
    echo "$h" | tr a-f A-F | sed 's/../&:/g; s/:$//'
}

jesc() { sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n'; }

cmd_ca_info() {
    local subj="" until=""
    if [ ! -s "$CA_DER" ]; then
        echo '{"present":false}'
        return 0
    fi
    if command -v openssl >/dev/null 2>&1; then
        subj=$(openssl x509 -inform DER -in "$CA_DER" -noout -subject 2>/dev/null | sed 's/^subject= *//')
        until=$(openssl x509 -inform DER -in "$CA_DER" -noout -enddate 2>/dev/null | sed 's/^notAfter=//' |
            awk '{ m = index("JanFebMarAprMayJunJulAugSepOctNovDec", $1); if (m) printf "%s-%02d-%02d", $4, (m + 2) / 3, $2 }')
    fi
    printf '{"present":true,"sha256":"%s","subject":"%s","not_after":"%s","source":"%s","from":"%s","ts":%s}\n' \
        "$(ca_sha256)" "$(printf '%s' "$subj" | jesc)" "$until" \
        "$(meta SRC | jesc)" "$(meta FROM)" "$(meta TS | tr -cd 0-9)"
}

cmd_ca_pem() {
    [ -s "$CA_DER" ] || return 1
    echo "-----BEGIN CERTIFICATE-----"
    b64 enc < "$CA_DER" | awk '{ for (i = 1; i <= length($0); i += 64) print substr($0, i, 64) }'
    echo "-----END CERTIFICATE-----"
}

# Профиль конфигурации iOS/iPadOS/macOS: так сертификат ставится из Safari
# как профиль, а не теряется в «Файлах». UUID выводятся из отпечатка, чтобы
# повторная загрузка того же сертификата заменяла профиль, а не плодила копии.
cmd_ca_mobileconfig() {
    local fp u1 u2
    [ -s "$CA_DER" ] || return 1
    fp=$(ca_sha256 | tr -d ':')
    u1=$(echo "$fp" | sed 's/^\(.\{8\}\)\(.\{4\}\)\(.\{4\}\)\(.\{4\}\)\(.\{12\}\).*/\1-\2-\3-\4-\5/')
    u2=$(echo "$fp" | sed 's/^.\{32\}\(.\{8\}\)\(.\{4\}\)\(.\{4\}\)\(.\{4\}\)\(.\{12\}\).*/\1-\2-\3-\4-\5/')
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadCertificateFileName</key><string>detour-filter-ca.cer</string>
      <key>PayloadContent</key><data>$(b64 enc < "$CA_DER")</data>
      <key>PayloadDisplayName</key><string>Сертификат фильтра HTTPS</string>
      <key>PayloadIdentifier</key><string>detour.filter-ca.cert.${fp%"${fp#????????}"}</string>
      <key>PayloadType</key><string>com.apple.security.root</string>
      <key>PayloadUUID</key><string>$u2</string>
      <key>PayloadVersion</key><integer>1</integer>
    </dict>
  </array>
  <key>PayloadDescription</key><string>Корневой сертификат фильтра HTTPS из сети Detour. Нужен, чтобы сайты открывались через фильтр.</string>
  <key>PayloadDisplayName</key><string>Фильтр HTTPS (Detour)</string>
  <key>PayloadIdentifier</key><string>detour.filter-ca.${fp%"${fp#????????}"}</string>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadUUID</key><string>$u1</string>
  <key>PayloadVersion</key><integer>1</integer>
</dict>
</plist>
EOF
}

case "$1" in
    apply) cmd_apply ;;
    ca-fetch) cmd_ca_fetch "$2" ;;
    ca-set) cmd_ca_set "$2" "$3" ;;
    ca-clear) rm -f "$CA_DER" "$CA_META" "${STATE%/*}/detour-filter.ca-try" ;;
    ca-info) cmd_ca_info ;;
    ca-der) [ -s "$CA_DER" ] && cat "$CA_DER" ;;
    b64-dec) b64 dec ;;
    ca-pem) cmd_ca_pem ;;
    ca-mobileconfig) cmd_ca_mobileconfig ;;
    clear)
        drop_jump
        filter_devices | while read -r n mac url; do gate "$n" off; done ;;
    tick) cmd_tick ;;
    status) cmd_status ;;
    set-fallback)
        case "$2" in direct|block) ;; *) echo "usage: $0 set-fallback direct|block" >&2; exit 2 ;; esac
        mkdir -p "${CONF%/*}"
        echo "FALLBACK=$2" > "$CONF"
        cmd_apply ;;
    *) echo "usage: $0 apply|clear|tick|status|set-fallback direct|block|ca-fetch|ca-set|ca-clear|ca-info|ca-der|ca-pem|ca-mobileconfig" >&2; exit 2 ;;
esac
