#!/bin/sh /etc/rc.common
# Detour — VPN-сервер AmneziaWG (см. /usr/sbin/detour-server). No-op, пока
# сервер не включён в панели. «Полная остановка» Detour его не трогает.

START=60
STOP=40

PROG=/usr/sbin/detour-server

start() {
    [ -x "$PROG" ] && "$PROG" start >/dev/null 2>&1
    return 0
}

stop() {
    [ -x "$PROG" ] && "$PROG" down >/dev/null 2>&1
    ip link del dsrv0 2>/dev/null
    return 0
}
