#!/bin/sh
# detour-rtun — встречный канал: роутер за CGNAT (мобильный интернет) держит
# туннель AmneziaWG к своему VPN-серверу Detour на VPS, а сервер публикует его
# порты наружу (detour-server pub-add). Пришедшее по туннелю здесь переводится
# на устройство домашней сети.
#
#   detour-rtun status                     JSON для панели
#   detour-rtun import  < client.conf      конфиг клиента с сервера (кнопка «Конфиг»)
#   detour-rtun set enabled=0|1 transport=direct|vless
#   detour-rtun vless-set  < ссылка        vless:// клиента с того же сервера
#   detour-rtun map-add <tcp|udp|both> <порт> <ip> [порт устройства] [заметка]
#   detour-rtun map-set <id> enabled=0|1 | map-del <id>
#   detour-rtun apply | stop | tick | down | forget
#
# Маршрутов по умолчанию туннель не трогает: AllowedIPs сводится к подсети сервера,
# адрес — /24 на интерфейсе, и только эта подсеть уходит в туннель. Сервер
# подменяет источник на свой адрес в туннеле, поэтому ответ устройства сам
# возвращается сюда, а VPN и маршруты Detour на этом роутере не задеты.
#
# Порт на сервере и порт в туннеле совпадают: сервер шлёт на <адрес клиента>:N,
# здесь N переводится на <ip>:<порт устройства>.
#
# Транспорт vless — для мобильных сетей, где ТСПУ пропускает первый пакет
# AmneziaWG и режет поток: UDP туннеля уходит в локальный sing-box (direct-вход на
# 127.0.0.1:$SB_PORT) и дальше VLESS-Reality по TCP до того же сервера, а VLESS-вход
# сервера отдаёт его на собственный AmneziaWG ($NET.1:<порт>). У клиента сервера
# режим «Только дом» это разрешает.
#
# Хранение (под /etc/detour → keeplist): rtun/tunnel.conf (как выдал сервер, 0600),
# rtun/rtun.conf (ENABLED, TRANSPORT), rtun/vless.link, rtun/maps.list:
#   id|proto|port|ip|dport|enabled|note

IFACE=drtun0
ZONE=detour_rtun
if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    KEENETIC=1
    DIR=/opt/etc/detour/rtun
    RUN=/opt/var/run
    LOG=/opt/var/log/detour-rtun.log
else
    KEENETIC=0
    DIR=/etc/detour/rtun
    RUN=/var/run
    LOG=/var/log/detour-rtun.log
fi
TUNNEL="$DIR/tunnel.conf"
CONF="$DIR/rtun.conf"
MAPS="$DIR/maps.list"
RENDER="$RUN/detour-rtun.conf"
EPSTATE="$RUN/detour-rtun.ep"      # «ip ts» — последнее разрешение адреса сервера
LOCKD="$RUN/detour-rtun.lock"
VLINK="$DIR/vless.link"
SB_PORT=19491
SB_CONF="$RUN/detour-rtun-sb.json"
SB_PID="$RUN/detour-rtun-sb.pid"
SB_LOG="$RUN/detour-rtun-sb.log"

if ! command -v awg >/dev/null 2>&1 && command -v amneziawg-go >/dev/null 2>&1 && \
        amneziawg-go awg genpsk 2>/dev/null | grep -qE '^[A-Za-z0-9+/]{43}=$'; then
    awg() { amneziawg-go awg "$@"; }
fi

mkdir -p "$RUN" "$(dirname "$LOG")" 2>/dev/null
log() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }
json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r\t'; }
err() { printf '{"ok":false,"error":"%s"}\n' "$(json_esc "$1")"; exit 0; }

lock() {
    i=0
    until mkdir "$LOCKD" 2>/dev/null; do
        i=$((i + 1)); [ "$i" -gt 60 ] && { rm -rf "$LOCKD"; mkdir "$LOCKD" 2>/dev/null; break; }
        sleep 1
    done
    trap 'rm -rf "$LOCKD"' EXIT
    trap 'rm -rf "$LOCKD"; exit 1' INT TERM
}

ENABLED=0; TRANSPORT=direct
load_conf() { [ -f "$CONF" ] && . "$CONF"; [ "$TRANSPORT" = vless ] || TRANSPORT=direct; return 0; }
save_conf() { mkdir -p "$DIR"; chmod 700 "$DIR"; printf 'ENABLED=%s\nTRANSPORT=%s\n' "$ENABLED" "$TRANSPORT" > "$CONF"; }

backend() {
    if lsmod 2>/dev/null | grep -q '^amneziawg ' || modprobe amneziawg 2>/dev/null; then echo kernel; return; fi
    if command -v amneziawg-go >/dev/null 2>&1 && [ -c /dev/net/tun ]; then echo userspace; fi
}

unsupported_reason() {
    [ "$KEENETIC" = 1 ] && { echo "keenetic"; return; }
    command -v awg >/dev/null 2>&1 && [ -n "$(backend)" ] || echo "not_installed"
}

# Значение ключа из секции конфига: $1 секция (Interface|Peer)  $2 ключ.
cval() {
    awk -v sec="[$1]" -v key="$2" '
        { sub(/\r$/, "") }
        /^\[/ { in_s = ($0 == sec); next }
        in_s {
            k = $0; sub(/[[:space:]]*=.*/, "", k); gsub(/^[[:space:]]+/, "", k)
            if (tolower(k) == tolower(key)) { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); print v; exit }
        }' "$TUNNEL" 2>/dev/null
}

addr() { cval Interface Address | cut -d, -f1 | cut -d/ -f1 | tr -d ' '; }
net3() { addr | cut -d. -f1-3; }
ep_host() { e=$(cval Peer Endpoint); printf '%s' "${e%:*}"; }
ep_port() { e=$(cval Peer Endpoint); printf '%s' "${e##*:}"; }

valid_ip4() { printf '%s' "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }

resolve4() {  # $1 имя → IPv4
    valid_ip4 "$1" && { printf '%s' "$1"; return 0; }
    nslookup "$1" 2>/dev/null | awk '/^Name:/ { n = 1; next } n && /^Address/ { sub(/^Address[^:]*:[[:space:]]*/, ""); if ($1 ~ /^[0-9.]+$/) { print $1; exit } }'
}

# ---------- транспорт vless: локальный sing-box ----------

urldec() { printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"; }

# Параметр запроса ссылки: $1 ключ (ссылка — в $L).
lq() { q=${L#*\?}; q=${q%%#*}; printf '%s' "$q" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }

# vless://uuid@host:port?…  → переменные V_*. Только TCP (Reality или TLS).
vless_parse() {
    L=$(tr -d ' \r\n' < "$VLINK" 2>/dev/null)
    case "$L" in vless://*) ;; *) return 1 ;; esac
    b=${L#vless://}; b=${b%%\?*}; b=${b%%#*}
    V_UUID=${b%%@*}; hp=${b#*@}
    V_PORT=${hp##*:}; V_HOST=${hp%:*}; V_HOST=${V_HOST#[}; V_HOST=${V_HOST%]}
    V_SEC=$(lq security); V_TYPE=$(lq type); V_FLOW=$(lq flow)
    V_SNI=$(urldec "$(lq sni)"); V_FP=$(lq fp); V_PBK=$(lq pbk); V_SID=$(lq sid)
    [ -n "$V_UUID" ] && [ -n "$V_HOST" ] && [ -n "$V_PORT" ] || return 1
    case "${V_TYPE:-tcp}" in tcp|raw) ;; *) return 2 ;; esac
    case "$V_SEC" in reality) [ -n "$V_PBK" ] || return 1 ;; tls) ;; *) return 3 ;; esac
    return 0
}

sb_bin() { command -v sing-box 2>/dev/null; }

sb_render() {
    vless_parse || return 1
    ip=$(resolve4 "$V_HOST")
    [ -n "$ip" ] || { log "не удалось разрешить $V_HOST"; return 1; }
    echo "$ip $(date +%s)" > "$EPSTATE"
    tls="\"enabled\":true,\"server_name\":\"${V_SNI:-$V_HOST}\",\"utls\":{\"enabled\":true,\"fingerprint\":\"${V_FP:-chrome}\"}"
    [ "$V_SEC" = reality ] && tls="$tls,\"reality\":{\"enabled\":true,\"public_key\":\"$V_PBK\",\"short_id\":\"$V_SID\"}"
    flow=""; [ -n "$V_FLOW" ] && flow=",\"flow\":\"$V_FLOW\""
    umask 077
    printf '{"log":{"level":"warn","timestamp":true},"inbounds":[{"type":"direct","tag":"in","listen":"127.0.0.1","listen_port":%s,"network":"udp","override_address":"%s.1","override_port":%s}],' \
        "$SB_PORT" "$(net3)" "$(ep_port)" > "$SB_CONF"
    printf '"outbounds":[{"type":"vless","tag":"vl","server":"%s","server_port":%s,"uuid":"%s"%s,"packet_encoding":"xudp","tls":{%s}}],"route":{"final":"vl"}}\n' \
        "$ip" "$V_PORT" "$V_UUID" "$flow" "$tls" >> "$SB_CONF"
}

sb_running() { [ -f "$SB_PID" ] && kill -0 "$(cat "$SB_PID")" 2>/dev/null; }

sb_down() {
    sb_running && { kill "$(cat "$SB_PID")" 2>/dev/null; sleep 1; kill -9 "$(cat "$SB_PID")" 2>/dev/null; }
    rm -f "$SB_PID"
}

sb_up() {
    SBB=$(sb_bin); [ -n "$SBB" ] || { log "vless: нет sing-box"; return 1; }
    sb_render || { log "vless: ссылка не разобрана"; return 1; }
    "$SBB" check -c "$SB_CONF" >>"$LOG" 2>&1 || { log "vless: sing-box отверг конфиг"; return 1; }
    if sb_running && cmp -s "$SB_CONF" "$SB_CONF.run" 2>/dev/null; then return 0; fi
    sb_down
    cp "$SB_CONF" "$SB_CONF.run"
    "$SBB" run -c "$SB_CONF.run" >"$SB_LOG" 2>&1 &
    echo $! > "$SB_PID"
    sleep 1
    sb_running || { log "vless: sing-box упал: $(tail -2 "$SB_LOG" | tr '\n' ' ')"; return 1; }
    log "vless: sing-box на 127.0.0.1:$SB_PORT → $V_HOST:$V_PORT"
}

# Конфиг для `awg setconf`: всё из [Interface], кроме ключей wg-quick, и пир
# с AllowedIPs = подсеть сервера.
render() {
    if [ "$TRANSPORT" = vless ]; then
        sb_up || return 1
        ep="127.0.0.1:$SB_PORT"
    else
        sb_down
        ip=$(resolve4 "$(ep_host)")
        [ -n "$ip" ] || { log "не удалось разрешить $(ep_host)"; return 1; }
        echo "$ip $(date +%s)" > "$EPSTATE"
        ep="$ip:$(ep_port)"
    fi
    umask 077
    awk -v net="$(net3)" -v ep="$ep" '
        { sub(/\r$/, "") }
        /^\[Interface\]/ { s = "i"; print; next }
        /^\[Peer\]/ { s = "p"; print "\n[Peer]"; next }
        /^[[:space:]]*($|#)/ { next }
        {
            k = $0; sub(/[[:space:]]*=.*/, "", k); gsub(/^[[:space:]]+/, "", k); lk = tolower(k)
            if (s == "i" && lk !~ /^(address|dns|mtu|table|preup|postup|predown|postdown|saveconfig)$/) print
            if (s == "p") {
                if (lk == "endpoint") print "Endpoint = " ep
                else if (lk == "allowedips") print "AllowedIPs = " net ".0/24"
                else if (lk == "persistentkeepalive") print "PersistentKeepalive = 25"
                else print
            }
        }' "$TUNNEL" > "$RENDER"
    grep -qi '^PersistentKeepalive' "$RENDER" || echo "PersistentKeepalive = 25" >> "$RENDER"
}

iface_up() { ip link show "$IFACE" >/dev/null 2>&1; }

# Пакет в туннель сразу: рукопожатие не ждёт keepalive, а сервер узнаёт новый
# адрес клиента (после перезапуска sing-box он другой) без паузы до 25 с.
kick() { ( ping -c 2 -W 2 "$(net3).1" >/dev/null 2>&1 & ) ; }

tun_down() {
    iface_up && ip link del "$IFACE" 2>/dev/null
    rm -f "$RENDER"
    sb_down
}

tun_up() {
    r=$(unsupported_reason); [ -z "$r" ] || { log "apply: $r"; return 1; }
    [ -s "$TUNNEL" ] || { log "apply: нет конфига"; return 1; }
    render || return 1
    if ! iface_up; then
        if [ "$(backend)" = kernel ]; then
            ip link add "$IFACE" type amneziawg || { log "ip link add $IFACE не удался"; return 1; }
        else
            mkdir -p /var/run/amneziawg
            amneziawg-go "$IFACE" >>"$LOG" 2>&1 || { log "amneziawg-go не запустился"; return 1; }
            i=0
            while [ ! -S "/var/run/amneziawg/$IFACE.sock" ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
        fi
        awg setconf "$IFACE" "$RENDER" || { log "awg setconf не удался"; ip link del "$IFACE"; return 1; }
    else
        awg syncconf "$IFACE" "$RENDER" 2>/dev/null || awg setconf "$IFACE" "$RENDER" || return 1
    fi
    ip addr replace "$(addr)/24" dev "$IFACE" 2>/dev/null || ip addr add "$(addr)/24" dev "$IFACE" 2>/dev/null
    mtu=$(cval Interface MTU)
    ip link set "$IFACE" mtu "${mtu:-1376}" up
    rm -f "$RENDER"
    kick
    return 0
}

# ---------- файрвол (fw4/fw3 через uci) ----------

lan_ip() { uci -q get network.lan.ipaddr 2>/dev/null | awk '{ print $1 }' | cut -d/ -f1; }

fw_apply() {  # $1 — 1 = туннель включён
    on=${1:-0}
    changed=0
    want() {
        [ "$(uci -q get "firewall.$1")" = "$2" ] && return
        uci -q set "firewall.$1=$2"; changed=1
    }
    want "$ZONE" zone
    want "$ZONE.name" "$ZONE"
    want "$ZONE.device" "$IFACE"
    want "$ZONE.input" REJECT
    want "$ZONE.output" ACCEPT
    want "$ZONE.forward" REJECT
    want "$ZONE.mtu_fix" 1
    keep=" "
    lip=$(lan_ip)
    if [ -s "$MAPS" ]; then
        while IFS='|' read -r id proto port ip dport en note; do
            [ -n "$id" ] || continue
            s="${ZONE}_$id"; keep="$keep$s "
            case "$proto" in both) pp="tcp udp" ;; *) pp=$proto ;; esac
            m=0; [ "$on" = 1 ] && [ "$en" = 1 ] && m=1
            want "$s" redirect
            want "$s.name" "detour-rtun-$port"
            want "$s.src" "$ZONE"
            want "$s.proto" "$pp"
            want "$s.src_dport" "$port"
            want "$s.dest" lan
            want "$s.dest_ip" "$ip"
            want "$s.dest_port" "${dport:-$port}"
            want "$s.target" DNAT
            want "$s.enabled" "$m"
            # Сам роутер — цель: после DNAT пакет идёт во вход, а зона его режет.
            r="${ZONE}_r$id"
            if [ -n "$lip" ] && [ "$ip" = "$lip" ]; then
                keep="$keep$r "
                want "$r" rule
                want "$r.name" "detour-rtun-in-$port"
                want "$r.src" "$ZONE"
                want "$r.proto" "$pp"
                want "$r.dest_port" "${dport:-$port}"
                want "$r.target" ACCEPT
                want "$r.enabled" "$m"
            fi
        done < "$MAPS"
    fi
    for s in $(uci -q show firewall 2>/dev/null | sed -nE "s/^firewall\.(${ZONE}_r?m[0-9a-f]*)=(redirect|rule)$/\1/p"); do
        case "$keep" in *" $s "*) ;; *) uci -q delete "firewall.$s"; changed=1 ;; esac
    done
    if [ "$changed" = 1 ]; then
        uci commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1
        log "firewall: зона $ZONE обновлена"
    fi
}

fw_remove() {
    for s in "$ZONE" $(uci -q show firewall 2>/dev/null | sed -nE "s/^firewall\.(${ZONE}_r?m[0-9a-f]*)=(redirect|rule)$/\1/p"); do
        uci -q delete "firewall.$s"
    done
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1
}

do_apply() {
    load_conf
    if [ "$ENABLED" = 1 ] && [ -s "$TUNNEL" ]; then
        tun_up || { fw_apply 0; return 1; }
        fw_apply 1
    else
        tun_down
        [ "$KEENETIC" = 1 ] || { uci -q get "firewall.$ZONE" >/dev/null && fw_apply 0; }
    fi
    return 0
}

new_id() {
    hexdump -n 4 -v -e '/1 "%02x"' /dev/urandom 2>/dev/null || od -An -N4 -tx1 /dev/urandom | tr -d ' \n'
}

handshake() {
    iface_up || { echo 0; return; }
    awg show "$IFACE" latest-handshakes 2>/dev/null | awk '{ print $2; exit }'
}

status_json() {
    load_conf
    r=$(unsupported_reason)
    hs=$(handshake); hs=${hs:-0}; now=$(date +%s)
    rx=0; tx=0
    iface_up && set -- $(awg show "$IFACE" transfer 2>/dev/null | awk '{ print $2, $3; exit }') && { rx=${1:-0}; tx=${2:-0}; }
    printf '{"ok":true,"supported":%s,"reason":"%s","enabled":%s,"configured":%s,"up":%s,' \
        "$([ "$r" = keenetic ] && echo false || echo true)" "$r" \
        "$([ "$ENABLED" = 1 ] && echo true || echo false)" "$([ -s "$TUNNEL" ] && echo true || echo false)" \
        "$(iface_up && echo true || echo false)"
    vh=""; vless_parse >/dev/null 2>&1 && vh="$V_HOST:$V_PORT"
    printf '"transport":"%s","vless":"%s","vless_up":%s,' "$TRANSPORT" "$(json_esc "$vh")" "$(sb_running && echo true || echo false)"
    printf '"server":"%s","address":"%s","server_ip":"%s","lan_ip":"%s","handshake":%s,"handshake_ago":%s,"rx":%s,"tx":%s,"maps":[' \
        "$(json_esc "$(ep_host)")" "$(addr)" "$([ -n "$(net3)" ] && echo "$(net3).1")" "$(lan_ip)" \
        "$hs" "$([ "$hs" -gt 0 ] && echo $((now - hs)) || echo -1)" "$rx" "$tx"
    [ -s "$MAPS" ] && awk -F'|' '
        function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
        { printf "%s{\"id\":\"%s\",\"proto\":\"%s\",\"port\":%d,\"ip\":\"%s\",\"dport\":%d,\"enabled\":%s,\"note\":\"%s\"}",
            (n++ ? "," : ""), $1, $2, $3, $4, ($5 == "" ? $3 : $5), ($6 == 1 ? "true" : "false"), esc($7) }' "$MAPS"
    printf ']}\n'
}

check_map() {  # proto port ip dport
    case "$1" in tcp|udp|both) ;; *) err "протокол: tcp, udp или both" ;; esac
    for p in "$2" "$4"; do
        case "$p" in ''|*[!0-9]*) err "порт — число" ;; esac
        [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || err "порт от 1 до 65535"
    done
    valid_ip4 "$3" || err "адрес устройства — IPv4 домашней сети"
}

cmd_import() {
    tmp="$RUN/detour-rtun.import.$$"
    umask 077
    head -c 16384 | tr -d '\r' > "$tmp"
    for k in "Interface PrivateKey" "Interface Address" "Peer PublicKey" "Peer Endpoint"; do
        set -- $k
        v=$(TUNNEL=$tmp; cval "$1" "$2")
        [ -n "$v" ] || { rm -f "$tmp"; err "в конфиге нет $2 — нужен .conf AmneziaWG клиента с VPN-сервера Detour"; }
    done
    a=$(TUNNEL=$tmp; addr)
    valid_ip4 "$a" || { rm -f "$tmp"; err "в конфиге нет IPv4-адреса клиента"; }
    n=$(echo "$a" | cut -d. -f1-3)
    if [ "$n.0/24" = "$(ip -4 route show dev br-lan 2>/dev/null | awk '/proto kernel/ { print $1; exit }')" ]; then
        rm -f "$tmp"; err "подсеть туннеля $n.0/24 совпадает с домашней сетью"
    fi
    mkdir -p "$DIR"; chmod 700 "$DIR"
    mv "$tmp" "$TUNNEL"
    load_conf; ENABLED=1; save_conf
    log "import: адрес $a, сервер $(ep_host)"
    do_apply || err "конфиг сохранён, но туннель не поднялся — подробности в $LOG"
    echo '{"ok":true}'
}

cmd_map_add() {  # proto port ip [dport] [note]
    dport=${4:-$2}
    check_map "$1" "$2" "$3" "$dport"
    [ -s "$MAPS" ] && awk -F'|' -v p="$2" -v pr="$1" '$3 == p && ($2 == pr || $2 == "both" || pr == "both") { f = 1 } END { exit !f }' "$MAPS" && \
        err "порт $2 уже переведён"
    _mid="m$(new_id)"
    note=$(printf '%s' "$5" | tr -d '|\n\r' | cut -c1-60)
    mkdir -p "$DIR"; umask 077
    printf '%s|%s|%s|%s|%s|1|%s\n' "$_mid" "$1" "$2" "$3" "$dport" "$note" >> "$MAPS"
    do_apply
    log "map-add $_mid $1 $2 → $3:$dport"
    printf '{"ok":true,"id":"%s"}\n' "$_mid"
}

cmd_map_set() {
    id=$1; shift
    old=$(awk -F'|' -v id="$id" '$1 == id' "$MAPS" 2>/dev/null)
    [ -n "$old" ] || err "перевод не найден"
    IFS='|' read -r _i proto port ip dport en note <<EOF
$old
EOF
    for kv in "$@"; do
        case "$kv" in
            enabled=0|enabled=1) en=${kv#*=} ;;
            proto=*) proto=${kv#*=} ;;
            port=*) port=${kv#*=} ;;
            ip=*) ip=${kv#*=} ;;
            dport=*) dport=${kv#*=} ;;
            note=*) note=$(printf '%s' "${kv#*=}" | tr -d '|\n\r' | cut -c1-60) ;;
            *) err "неизвестный параметр: ${kv%%=*}" ;;
        esac
    done
    check_map "$proto" "$port" "$ip" "$dport"
    umask 077
    awk -F'|' -v OFS='|' -v id="$id" -v l="$id|$proto|$port|$ip|$dport|$en|$note" '$1 == id { print l; next } { print }' \
        "$MAPS" > "$MAPS.tmp" && mv "$MAPS.tmp" "$MAPS"
    do_apply
    echo '{"ok":true}'
}

cmd_map_del() {
    awk -F'|' -v id="$1" '$1 == id { f = 1 } END { exit !f }' "$MAPS" 2>/dev/null || err "перевод не найден"
    umask 077
    awk -F'|' -v id="$1" '$1 != id' "$MAPS" > "$MAPS.tmp" && mv "$MAPS.tmp" "$MAPS"
    do_apply
    echo '{"ok":true}'
}

case "$1" in
    status) status_json ;;
    import)
        [ "$KEENETIC" = 1 ] && err "встречный канал пока только на OpenWrt"
        lock; cmd_import ;;
    set)
        shift; lock; load_conf
        for kv in "$@"; do
            case "$kv" in
                enabled=0|enabled=1) ENABLED=${kv#*=} ;;
                transport=direct|transport=vless) TRANSPORT=${kv#*=} ;;
                *) err "неизвестный параметр: $kv" ;;
            esac
        done
        [ "$ENABLED" = 1 ] && [ ! -s "$TUNNEL" ] && err "сначала загрузите конфиг клиента с сервера"
        if [ "$TRANSPORT" = vless ]; then
            [ -s "$VLINK" ] || err "сначала вставьте ссылку VLESS этого клиента с сервера"
            [ -n "$(sb_bin)" ] || err "на роутере нет sing-box"
        fi
        save_conf
        do_apply || err "туннель не поднялся — подробности в $LOG"
        echo '{"ok":true}' ;;
    vless-set)
        [ "$KEENETIC" = 1 ] && err "встречный канал пока только на OpenWrt"
        lock; load_conf
        tmp="$RUN/detour-rtun.vlink.$$"; umask 077
        head -c 4096 | tr -d ' \r\n' > "$tmp"
        VLINK_REAL=$VLINK; VLINK=$tmp
        vless_parse; rc=$?
        VLINK=$VLINK_REAL
        case "$rc" in
            0) ;;
            2) rm -f "$tmp"; err "нужна ссылка VLESS по TCP (Reality или TLS) — WebSocket и xhttp здесь не подходят" ;;
            3) rm -f "$tmp"; err "ссылка без TLS/Reality не подходит" ;;
            *) rm -f "$tmp"; err "это не ссылка vless:// клиента" ;;
        esac
        mkdir -p "$DIR"; chmod 700 "$DIR"; mv "$tmp" "$VLINK"
        TRANSPORT=vless; save_conf
        log "vless-set: $V_HOST:$V_PORT ($V_SEC)"
        do_apply || err "ссылка сохранена, но туннель не поднялся — подробности в $LOG"
        echo '{"ok":true}' ;;
    map-add) lock; cmd_map_add "$2" "$3" "$4" "$5" "$6" ;;
    map-set) shift; lock; cmd_map_set "$@" ;;
    map-del) lock; cmd_map_del "$2" ;;
    apply|start) lock; do_apply; [ "$1" = apply ] && echo '{"ok":true}'; exit 0 ;;
    stop) lock; tun_down ;;
    tick)
        [ -f "$CONF" ] || exit 0
        load_conf
        [ "$ENABLED" = 1 ] || exit 0
        lock
        if ! iface_up; then
            log "tick: $IFACE нет — поднимаю"; do_apply; exit 0
        fi
        if [ "$TRANSPORT" = vless ] && ! sb_running; then
            log "tick: sing-box встречного канала упал — поднимаю"; do_apply; exit 0
        fi
        # Нет рукопожатия дольше 3 минут: сервер мог сменить адрес (DDNS) —
        # разрешаем имя заново, не чаще раза в 5 минут.
        hs=$(handshake); now=$(date +%s)
        set -- $(cat "$EPSTATE" 2>/dev/null)
        if [ $((now - ${hs:-0})) -gt 180 ] && [ $((now - ${2:-0})) -gt 300 ] && [ "$TRANSPORT" = vless ]; then
            # Сервер VLESS мог сменить адрес: sb_up сверит конфиг и перезапустит.
            echo "${1:-} $now" > "$EPSTATE"
            sb_up >/dev/null 2>&1
        elif [ $((now - ${hs:-0})) -gt 180 ] && [ $((now - ${2:-0})) -gt 300 ]; then
            nip=$(resolve4 "$(ep_host)")
            echo "${nip:-$1} $now" > "$EPSTATE"
            if [ -n "$nip" ]; then
                pk=$(cval Peer PublicKey)
                awg set "$IFACE" peer "$pk" endpoint "$nip:$(ep_port)" 2>/dev/null
                [ "$nip" != "$1" ] && log "tick: адрес сервера $1 → $nip"
            fi
        fi
        # Перестройка файрвола могла снести секции — fw_apply сверит.
        fw_apply 1 ;;
    down)
        tun_down
        [ "$KEENETIC" = 1 ] || fw_remove ;;
    forget)
        lock; tun_down
        [ "$KEENETIC" = 1 ] || fw_remove
        rm -rf "$DIR"
        rm -f "$SB_CONF" "$SB_CONF.run"
        log "forget"
        echo '{"ok":true}' ;;
    *)
        echo "usage: $0 {status|import|set enabled=0|1|map-add|map-set|map-del|apply|stop|tick|down|forget}" >&2
        exit 2 ;;
esac
