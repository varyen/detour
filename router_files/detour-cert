#!/bin/sh
# detour-cert — obtain / install / renew a Let's Encrypt cert (via acme.sh, HTTP-01
# webroot) for an A-record domain, so the Detour panel can be served over HTTPS.
# Web Push (the panel's push alerts) only works in a secure context, i.e. HTTPS.
#
# WHY acme.sh + webroot: the device has no `socat` (BusyBox), so acme.sh standalone
# mode is impossible — webroot (write the challenge file, let the :80 web server
# serve it) is the only viable HTTP-01 method here. DNS-01 could be a later add.
#
# UNIVERSAL install target (autodetected):
#   nginx present  → cert into /etc/nginx/ssl/<domain>/, reload nginx. We also install
#                    a managed, name-based :443 routing vhost (zz-detour-panel-tls.conf)
#                    so SNI=<domain> serves ITS cert and proxies to the panel — without
#                    it a default :443 server (e.g. GL.iNet's) answers <domain> with the
#                    wrong cert and the panel is unreachable over HTTPS even though the
#                    LE cert is valid. Challenge served via a managed conf.d snippet.
#   else OpenWrt   → uhttpd: cert into /etc/detour/ssl, point uhttpd at it + listen
#                    :443, restart. Panel then live at https://<domain>/detour/.
#   else Keenetic  → lighttpd: combined pem + an ssl include, restart the panel.
#
# Subcommands: detect | issue <domain> <email> | renew | status | _lighttpd-pem
#
# acme.sh runs its OWN renewal (we install its cronjob on OpenWrt; Keenetic drives
# `detour-cert renew` from detour-cron). On renewal acme.sh re-runs --install-cert,
# which re-copies the cert into the target dir and runs the stored reloadcmd.

DETOUR_DIR=/etc/detour
CERT_CONF="$DETOUR_DIR/cert.conf"          # persisted: DOMAIN/EMAIL/TARGET_MODE/CERT_DIR/RELOAD_CMD
STATE=/var/state/detour-cert.json          # panel-facing status
LOG=/var/log/detour-cert.log
ACME_WEBROOT=/var/detour-acme              # HTTP-01 challenge docroot (nginx mode)
NGINX_CONFD=/etc/nginx/conf.d
# HTTP-01 challenge vhost. The `zz-` prefix is load-bearing for the SAME reason as the
# panel vhost below, but on :80 the consequence is worse: nginx picks the FIRST server
# block declared for a listen address as that address's default_server unless one is
# marked explicitly, and GL.iNet's stock gl.conf marks neither :80 nor :443. Under the
# old name (detour-acme.conf) this file sorted BEFORE gl.conf, so it became the :80
# default and every request to the router by IP — the whole native GL admin UI, /rpc
# and /ws included — landed here, matched no location, fell through to the http-level
# `root /www` and 404'd (`open() "/www/rpc" failed`). See NGINX_SNIPPET_LEGACY below.
NGINX_SNIPPET=/etc/nginx/conf.d/zz-detour-acme.conf
NGINX_SNIPPET_LEGACY=/etc/nginx/conf.d/detour-acme.conf
# Managed panel-routing vhost. The `zz-` prefix makes it sort LAST in conf.d so the
# router's own default :443 server (e.g. GL.iNet gl.conf) stays the default_server —
# IP / unknown-SNI is unaffected; this named block wins for <domain> by SNI. A
# standalone file survives re-renders of other configs (e.g. lan-proxy).
NGINX_PANEL_VHOST=/etc/nginx/conf.d/zz-detour-panel-tls.conf
NGINX_SSL=/etc/nginx/ssl
DETOUR_SSL="$DETOUR_DIR/ssl"               # uhttpd/lighttpd mode cert dir
LIGHTTPD_DOCROOT=/opt/share/www
LIGHTTPD_SSL_CONF=/opt/etc/lighttpd/conf.d/detour-ssl.conf
LIGHTTPD_CONF=/opt/etc/lighttpd/detour.conf
LIGHTTPD_PORT=8080        # the Detour panel's lighttpd HTTP port (challenge is served here;
                          # reached externally via a WAN :80 → :LIGHTTPD_PORT port-forward)
PLATFORM=openwrt

# Keenetic/Entware platform shim (mirrors detour-health / detour-push).
if [ -d /opt/etc/ndm ] || [ -f /opt/etc/detour/platform ]; then
    export PATH="/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    PLATFORM=keenetic
    DETOUR_DIR=/opt/etc/detour
    CERT_CONF="$DETOUR_DIR/cert.conf"
    STATE=/opt/var/state/detour-cert.json
    LOG=/opt/var/log/detour-cert.log
    ACME_WEBROOT=/opt/var/detour-acme
    DETOUR_SSL="$DETOUR_DIR/ssl"
    mkdir -p /opt/var/state /opt/var/log 2>/dev/null
    # The panel's lighttpd port (challenge is served here, reached via a WAN :80 forward).
    _lp=$(sed -n 's/.*server\.port[^0-9]*\([0-9][0-9]*\).*/\1/p' "$LIGHTTPD_CONF" 2>/dev/null | head -1)
    [ -n "$_lp" ] && LIGHTTPD_PORT="$_lp"
fi

# LE staging (no rate limits, fake cert) — for safe end-to-end testing.
LE_STAGING=""
[ "$DETOUR_CERT_STAGING" = "1" ] && LE_STAGING="--staging"

log() { echo "[$(date 2>/dev/null)] $*" >> "$LOG" 2>/dev/null; }
NOW=$(date +%s 2>/dev/null); [ -z "$NOW" ] && NOW=0

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r\t')"; }

# ---- acme.sh location / install -------------------------------------------------
find_acme() {
    for p in /root/.acme.sh/acme.sh "$HOME/.acme.sh/acme.sh" /opt/.acme.sh/acme.sh \
             /opt/root/.acme.sh/acme.sh /usr/lib/acme/acme.sh; do
        [ -x "$p" ] && { echo "$p"; return 0; }
    done
    _c=$(command -v acme.sh 2>/dev/null) && [ -n "$_c" ] && { echo "$_c"; return 0; }
    return 1
}

# The webroot acme.sh recorded for a domain (Le_Webroot in its per-domain conf), or
# empty. Derived from the acme.sh location so it follows find_acme's search order.
# EC certs live in "<domain>_ecc"; plain RSA in "<domain>" — check both.
acme_webroot() {  # $1 domain → echoes the recorded webroot, or nothing
    _ah=$(find_acme) || return 0
    _ah=$(dirname "$_ah")
    for _dd in "$_ah/$1_ecc" "$_ah/$1"; do
        [ -f "$_dd/$1.conf" ] || continue
        sed -n "s/^Le_Webroot='\([^']*\)'.*/\1/p" "$_dd/$1.conf" 2>/dev/null | head -1
        return 0
    done
    return 0
}

# The reload hook acme.sh will replay on renewal. acme stores it either verbatim or
# wrapped in its __ACME_BASE64__ markers, so handle both. Echoes it, or nothing.
acme_reloadcmd() {  # $1 domain
    _ah=$(find_acme) || return 0
    _ah=$(dirname "$_ah")
    for _dd in "$_ah/$1_ecc" "$_ah/$1"; do
        [ -f "$_dd/$1.conf" ] || continue
        _rc=$(sed -n "s/^Le_ReloadCmd='\([^']*\)'.*/\1/p" "$_dd/$1.conf" 2>/dev/null | head -1)
        case "$_rc" in
            __ACME_BASE64__START_*)
                _rc=${_rc#__ACME_BASE64__START_}; _rc=${_rc%__ACME_BASE64__END_}
                printf '%s' "$_rc" | base64 -d 2>/dev/null ;;
            *) printf '%s' "$_rc" ;;
        esac
        return 0
    done
    return 0
}

ensure_acme() {
    _a=$(find_acme) && { echo "$_a"; return 0; }
    log "acme.sh not found — installing"
    if [ "$PLATFORM" = keenetic ]; then
        opkg update >/dev/null 2>&1; opkg install acme.sh >/dev/null 2>&1
    else
        opkg update >/dev/null 2>&1; opkg install acme >/dev/null 2>&1
    fi
    _a=$(find_acme) && { echo "$_a"; return 0; }
    # last resort: official installer (needs curl + internet)
    if command -v curl >/dev/null 2>&1; then
        curl -s https://get.acme.sh | sh >/dev/null 2>&1
    fi
    _a=$(find_acme) && { echo "$_a"; return 0; }
    return 1
}

# ---- environment detection ------------------------------------------------------
# Which server holds :80 (serves the HTTP-01 challenge).
http80_server() {
    _l=$(netstat -tlnp 2>/dev/null | grep -E '[:.]80[[:space:]]' | head -1)
    case "$_l" in
        *nginx*)    echo nginx ;;
        *uhttpd*)   echo uhttpd ;;
        *lighttpd*) echo lighttpd ;;
        '')         echo none ;;
        *)          echo other ;;
    esac
}

# Where to INSTALL the cert (nginx dir if nginx is here, else the panel's own server).
target_mode() {
    if command -v nginx >/dev/null 2>&1 && [ -d /etc/nginx ]; then echo nginx; return; fi
    [ "$PLATFORM" = keenetic ] && { echo lighttpd; return; }
    echo uhttpd
}

# Best-effort public/WAN address for the UI hint (skips RFC1918 + loopback).
wan_ip() {
    ip addr show 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' \
        | grep -vE '^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -1
}

cert_expiry() {  # $1 = fullchain path → "notAfter" string or empty
    [ -f "$1" ] || return 0
    openssl x509 -enddate -noout -in "$1" 2>/dev/null | sed 's/notAfter=//'
}

# ---- target install helpers -----------------------------------------------------
# Probe a candidate webroot: write a token under .well-known/acme-challenge and
# check the :80 server ACTUALLY serves it (Host-scoped to the domain, via local
# curl). This is the reliable way to pick a webroot — e.g. GL.iNet nginx serves
# /tmp/acme-webroot through a BUILT-IN handler that an added server block can't
# override (verified on GL-BE9300), while generic nginx needs our snippet. The
# probe tells us which actually works before we spend an ACME round-trip.
probe_webroot() {  # $1 domain  $2 webroot  [$3 port=80] → 0 if the token is served
    _port="${3:-80}"
    mkdir -p "$2/.well-known/acme-challenge" 2>/dev/null || return 1
    _tok="detour-probe-$$"
    echo "$_tok" > "$2/.well-known/acme-challenge/$_tok" 2>/dev/null || return 1
    _got=$(curl -s -m 5 -H "Host: $1" "http://127.0.0.1:$_port/.well-known/acme-challenge/$_tok" 2>/dev/null)
    rm -f "$2/.well-known/acme-challenge/$_tok" 2>/dev/null
    [ "$_got" = "$_tok" ]
}

# Apply a changed nginx config. NOT a graceful reload — see the long note on
# nginx_reload() in detour-portmap: on the reference GL-BE9300 the router's own admin
# UI holds long-lived WebSockets, the old workers stay in "shutting down" forever and
# keep answering from the PREVIOUS config. Measured there: a change was still not live
# 60 s after `nginx -s reload` (and after `/etc/init.d/nginx reload`), while a restart
# applied it in ~2 s.
#
# This silently broke certificate RENEWAL: nginx_add_snippet() wrote a correct :80
# challenge server, `nginx -t` passed, the reload reported success — and the block
# never went live, so probe_webroot() kept seeing the router's default :80 server
# (a 302 to the LAN IP, which Let's Encrypt refuses to follow) and every unattended
# renewal failed. The same stale command also went into cert.conf's RELOAD_CMD, so a
# renewal that DID succeed would not have been picked up by the running nginx either.
nginx_reload() {
    /etc/init.d/nginx restart >/dev/null 2>&1 || {
        nginx -s reload >/dev/null 2>&1
        return 0
    }
    # A restart needs a moment to bind :80 again. probe_webroot() runs right after
    # this and a probe that lands in the gap reports a false "webroot not served",
    # which aborts issuance/renewal even though the config is fine. Wait for the
    # listener (any HTTP answer counts — we only care that nginx is back).
    _w=0
    while [ "$_w" -lt 10 ]; do
        curl -s -m 2 -o /dev/null "http://127.0.0.1/" 2>/dev/null && break
        _w=$((_w + 1)); sleep 1
    done
    return 0
}

# Generic-nginx fallback: add a managed, name-based :80 server block serving the
# challenge from ACME_WEBROOT. Kept after issue so unattended renewals keep
# validating. Guarded by `nginx -t`. (No-op win on GL — the probe picks the
# built-in webroot first, so this is only reached on plain nginx.)
nginx_add_snippet() {  # $1 domain  [$2 webroot=ACME_WEBROOT]
    [ -d "$NGINX_CONFD" ] || return 1
    _sw="${2:-$ACME_WEBROOT}"
    mkdir -p "$_sw/.well-known/acme-challenge" 2>/dev/null
    cat > "$NGINX_SNIPPET" <<EOF
# Managed by detour-cert — serves the Let's Encrypt HTTP-01 challenge for $1.
server {
    listen 80;
    listen [::]:80;
    server_name $1;
    location ^~ /.well-known/acme-challenge/ {
        root $_sw;
        default_type "text/plain";
        try_files \$uri =404;
    }
}
EOF
    if nginx -t >/dev/null 2>&1; then
        nginx_reload
        return 0
    fi
    log "nginx -t failed after adding challenge snippet — reverting"
    rm -f "$NGINX_SNIPPET"; nginx_reload
    return 1
}

# What cert does the LOCAL :443 actually hand back for SNI=<domain>? Echoes the served
# CN (empty if openssl s_client is unavailable or nothing answers). Used both to verify
# after issue and to surface "serving the wrong cert" in the panel. Empty ≠ mismatch:
# callers must treat empty as "unknown", never as a failure, so a build without
# `openssl s_client` doesn't trigger a false warning.
serving_cn() {  # $1 domain  [$2 port=443] → served CN or ""
    _sp="${2:-443}"
    echo | openssl s_client -connect "127.0.0.1:$_sp" -servername "$1" 2>/dev/null \
        | openssl x509 -noout -subject 2>/dev/null \
        | sed -n 's/.*CN[[:space:]]*=[[:space:]]*\([^,/]*\).*/\1/p' | head -1 \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Local HTTP backend that serves the Detour panel (nginx-front routers run the panel on
# uhttpd). Derived from uhttpd's listen_http port, default :8080. Echoes host:port.
panel_backend() {
    _lh=$(uci -q get uhttpd.main.listen_http 2>/dev/null | tr ' ' '\n' | grep -v '^$' | head -1)
    case "$_lh" in
        *:*) _pp=${_lh##*:} ;;
        '')  _pp=8080 ;;
        *)   _pp=$_lh ;;
    esac
    case "$_pp" in ''|*[!0-9]*) _pp=8080 ;; esac
    printf '127.0.0.1:%s' "$_pp"
}

# Install the managed name-based :443 vhost so SNI=<domain> serves OUR cert and proxies
# to the panel. Guarded by `nginx -t` (revert on failure). Idempotent — same path each
# time. Called only when the domain doesn't already serve its own cert, so it never
# fights a working user-provided routing block.
nginx_add_panel_vhost() {  # $1 domain  $2 certdir
    [ -d "$NGINX_CONFD" ] || return 1
    _pd="$1"; _pc="$2"; _pb=$(panel_backend)
    cat > "$NGINX_PANEL_VHOST" <<EOF
# Managed by detour-cert — serve the Detour panel over HTTPS for $_pd.
# The zz- filename sorts LAST in conf.d so the router's own default :443 server stays
# the default_server (IP / unknown-SNI unaffected); this named block wins by SNI.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $_pd;

    ssl_certificate     $_pc/fullchain.pem;
    ssl_certificate_key $_pc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://$_pb;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
EOF
    if nginx -t >/dev/null 2>&1; then
        nginx_reload
        log "managed panel vhost written for $_pd → $_pb"
        return 0
    fi
    log "nginx -t failed after panel vhost — reverting"
    rm -f "$NGINX_PANEL_VHOST"; nginx_reload
    return 1
}

# Choose a webroot the :80 server provably serves for this domain. Echoes the path.
prepare_webroot() {  # $1 domain  $2 http80-server → echoes webroot, or fails
    _d="$1"; _srv="$2"
    # Keenetic: :80 is the stock router UI we don't control. The challenge is served
    # by OUR lighttpd on $LIGHTTPD_PORT, reached from the internet via a WAN :80 →
    # :LIGHTTPD_PORT port-forward (set up by the owner). Probe lighttpd directly.
    if [ "$PLATFORM" = keenetic ]; then
        probe_webroot "$_d" "$LIGHTTPD_DOCROOT" "$LIGHTTPD_PORT" && { echo "$LIGHTTPD_DOCROOT"; return 0; }
        return 1
    fi
    case "$_srv" in
        nginx)
            # The webroot acme.sh already has on file for this domain comes FIRST.
            # On a renewal acme writes the token to that recorded path and ignores any
            # -w we pass (--renew reloads the saved parameters), so if we validate and
            # serve a different directory the CA gets a 404 — which is exactly how a
            # working setup rotted into silent renewal failures here.
            _rec=$(acme_webroot "$_d")
            if [ -n "$_rec" ]; then
                # A recorded webroot means this domain has been issued before, so acme
                # will write the token THERE and nowhere else. Validating some other
                # directory that merely happens to be served would "succeed" and then
                # hand the CA a 404 — settle for nothing but the recorded path: probe
                # it, and if the live :80 doesn't serve it, repoint our snippet at it.
                probe_webroot "$_d" "$_rec" && { echo "$_rec"; return 0; }
                nginx_add_snippet "$_d" "$_rec" && probe_webroot "$_d" "$_rec" && { echo "$_rec"; return 0; }
                return 1
            fi
            # First issuance: any webroot the :80 server provably serves will do, and
            # the -w we pass becomes the recorded one.
            for _wr in /tmp/acme-webroot "$ACME_WEBROOT"; do
                probe_webroot "$_d" "$_wr" && { echo "$_wr"; return 0; }
            done
            nginx_add_snippet "$_d" "$ACME_WEBROOT" && probe_webroot "$_d" "$ACME_WEBROOT" && { echo "$ACME_WEBROOT"; return 0; }
            return 1 ;;
        uhttpd)
            _wr=$(uci -q get uhttpd.main.home 2>/dev/null); [ -n "$_wr" ] || _wr=/www
            probe_webroot "$_d" "$_wr" && { echo "$_wr"; return 0; }
            return 1 ;;
        lighttpd)
            probe_webroot "$_d" "$LIGHTTPD_DOCROOT" "$LIGHTTPD_PORT" && { echo "$LIGHTTPD_DOCROOT"; return 0; }
            return 1 ;;
        *) return 1 ;;
    esac
}

# lighttpd reload hook (Keenetic): rebuild the combined pem from the installed
# fullchain+key and restart the panel. Used as acme.sh --reloadcmd so renewals redeploy.
lighttpd_pem() {
    [ -f "$CERT_CONF" ] && . "$CERT_CONF" 2>/dev/null
    [ -n "$CERT_DIR" ] || return 1
    cat "$CERT_DIR/privkey.pem" "$CERT_DIR/fullchain.pem" > "$CERT_DIR/combined.pem" 2>/dev/null
    chmod 0600 "$CERT_DIR/combined.pem" 2>/dev/null
    [ -x /opt/etc/init.d/S51detour-panel ] && /opt/etc/init.d/S51detour-panel restart >/dev/null 2>&1
    return 0
}

# One-time web-server TLS wiring for the uhttpd / lighttpd targets.
configure_uhttpd() {  # $1 = cert dir
    _cd="$1"
    command -v uci >/dev/null 2>&1 || return 1
    uci set uhttpd.main.cert="$_cd/fullchain.pem" 2>/dev/null
    uci set uhttpd.main.key="$_cd/privkey.pem" 2>/dev/null
    # ensure an HTTPS listener exists (LuCI usually already has one)
    if ! uci -q get uhttpd.main.listen_https >/dev/null 2>&1; then
        uci add_list uhttpd.main.listen_https='0.0.0.0:443' 2>/dev/null
        uci add_list uhttpd.main.listen_https='[::]:443' 2>/dev/null
    fi
    uci commit uhttpd 2>/dev/null
    /etc/init.d/uhttpd restart >/dev/null 2>&1
}

configure_lighttpd() {  # $1 = cert dir
    _cd="$1"
    mkdir -p "$(dirname "$LIGHTTPD_SSL_CONF")" 2>/dev/null
    cat "$_cd/privkey.pem" "$_cd/fullchain.pem" > "$_cd/combined.pem" 2>/dev/null
    chmod 0600 "$_cd/combined.pem" 2>/dev/null
    cat > "$LIGHTTPD_SSL_CONF" <<EOF
# Managed by detour-cert — serves the Detour panel over HTTPS on :443.
server.modules += ( "mod_openssl" )
\$SERVER["socket"] == ":443" {
    ssl.engine  = "enable"
    ssl.pemfile = "$_cd/combined.pem"
}
EOF
    [ -x /opt/etc/init.d/S51detour-panel ] && /opt/etc/init.d/S51detour-panel restart >/dev/null 2>&1
}

# ---- state -----------------------------------------------------------------------
write_state() {  # $1 result(ok|error|issuing)  $2 error-msg
    mkdir -p "$(dirname "$STATE")" 2>/dev/null
    _dom=""; _tgt=""; _cd=""
    [ -f "$CERT_CONF" ] && . "$CERT_CONF" 2>/dev/null && { _dom="$DOMAIN"; _tgt="$TARGET_MODE"; _cd="$CERT_DIR"; }
    _exp=$(cert_expiry "$_cd/fullchain.pem")
    printf '{"ok":true,"domain":%s,"target":%s,"expiry":%s,"last_result":%s,"last_error":%s,"last_ts":%s}\n' \
        "$(json_str "$_dom")" "$(json_str "$_tgt")" "$(json_str "$_exp")" \
        "$(json_str "$1")" "$(json_str "$2")" "$NOW" > "$STATE"
}

ensure_renewal() {
    if [ "$PLATFORM" = keenetic ]; then
        return 0   # driven by detour-cron `detour-cert renew`
    fi
    "$ACME" --install-cronjob >/dev/null 2>&1 || true
}

valid_domain() { printf '%s' "$1" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'; }
valid_email()  { printf '%s' "$1" | grep -qE '^[^@ ]+@[^@ ]+\.[^@ ]+$'; }

# One-shot migration for installs that already have the badly-named challenge vhost:
# under the old name it sorted before gl.conf and took over the :80 default_server,
# 404-ing the router's own admin UI (see NGINX_SNIPPET). Runs on every invocation so a
# cron `renew` or the panel's `detect` heals it without waiting for a reissue.
if [ "$PLATFORM" = openwrt ] && [ -f "$NGINX_SNIPPET_LEGACY" ]; then
    if [ -f "$NGINX_SNIPPET" ]; then
        rm -f "$NGINX_SNIPPET_LEGACY"
    else
        mv "$NGINX_SNIPPET_LEGACY" "$NGINX_SNIPPET" 2>/dev/null
    fi
    log "migrated legacy challenge vhost → $NGINX_SNIPPET (it hijacked the :80 default_server)"
    nginx -t >/dev/null 2>&1 && nginx_reload
fi

# ================================ COMMANDS =======================================
CMD="${1:-detect}"

case "$CMD" in
detect)
    _acme=no; find_acme >/dev/null 2>&1 && _acme=yes
    _dom=""; _exp=""; _res=""; _err=""; _ctgt=""
    if [ -f "$CERT_CONF" ]; then
        . "$CERT_CONF" 2>/dev/null
        _dom="$DOMAIN"; _ctgt="$TARGET_MODE"; _exp=$(cert_expiry "$CERT_DIR/fullchain.pem")
    fi
    [ -f "$STATE" ] && { _res=$(sed -n 's/.*"last_result":"\([^"]*\)".*/\1/p' "$STATE"); _err=$(sed -n 's/.*"last_error":"\([^"]*\)".*/\1/p' "$STATE"); }
    # Live check: does the local :443 actually hand back THIS domain's cert? Catches the
    # "valid cert, but SNI served the router's default cert" breakage. Empty served CN =
    # unknown (no openssl s_client / nothing on :443) → report serving_ok:true so we
    # never warn on inability to probe; only a concrete different CN is a mismatch.
    _scn=""; _sok=true
    if [ -n "$_dom" ]; then
        _scn=$(serving_cn "$_dom")
        [ -n "$_scn" ] && [ "$_scn" != "$_dom" ] && _sok=false
    fi
    printf '{"ok":true,"acme_present":%s,"http80":%s,"target":%s,"wan_ip":%s,"platform":%s,"domain":%s,"expiry":%s,"last_result":%s,"last_error":%s,"serving_ok":%s,"serving_cn":%s}\n' \
        "$( [ "$_acme" = yes ] && echo true || echo false )" \
        "$(json_str "$(http80_server)")" "$(json_str "$(target_mode)")" \
        "$(json_str "$(wan_ip)")" "$(json_str "$PLATFORM")" \
        "$(json_str "$_dom")" "$(json_str "$_exp")" "$(json_str "$_res")" "$(json_str "$_err")" \
        "$_sok" "$(json_str "$_scn")"
    ;;

status)
    if [ -f "$STATE" ]; then cat "$STATE"; else printf '{"ok":true,"domain":"","last_result":""}\n'; fi
    ;;

issue)
    DOMAIN_IN="$2"; EMAIL_IN="$3"
    valid_domain "$DOMAIN_IN" || { write_state error "bad domain"; echo "bad domain" >&2; exit 2; }
    valid_email  "$EMAIL_IN"  || { write_state error "bad email";  echo "bad email"  >&2; exit 2; }
    write_state issuing ""
    log "issue $DOMAIN_IN ($EMAIL_IN)${LE_STAGING:+ [staging]}"

    ACME=$(ensure_acme) || { write_state error "acme.sh unavailable (no openssl/curl/opkg?)"; log "acme.sh install failed"; exit 1; }
    mkdir -p "$DETOUR_DIR" 2>/dev/null

    # Register/refresh the ACME account email (idempotent, cheap).
    "$ACME" --register-account -m "$EMAIL_IN" >/dev/null 2>&1 || \
        "$ACME" --update-account -m "$EMAIL_IN" >/dev/null 2>&1 || true

    H80=$(http80_server)
    TGT=$(target_mode)

    # --- pick a webroot the challenge server provably serves (probe-validated) ---
    # On Keenetic the challenge is served by our lighttpd (reached via a WAN :80 →
    # :LIGHTTPD_PORT forward), so a "no local :80 server" is fine there.
    if [ "$H80" = none ] && [ "$PLATFORM" != keenetic ]; then
        write_state error "no web server on :80 — open/forward port 80 to this router"
        log "no :80 server"; exit 1
    fi
    WEBROOT=$(prepare_webroot "$DOMAIN_IN" "$H80") || {
        if [ "$PLATFORM" = keenetic ]; then
            write_state error "panel lighttpd not serving the challenge on :$LIGHTTPD_PORT — is the panel running and WAN :80 forwarded to it?"
        else
            write_state error "could not serve the ACME challenge on :80 for $DOMAIN_IN (is port 80 reachable / the right web server?)"
        fi
        log "webroot prep failed (platform=$PLATFORM http80=$H80 lighttpd_port=$LIGHTTPD_PORT)"; exit 1
    }
    log "webroot for $DOMAIN_IN = $WEBROOT (platform=$PLATFORM http80=$H80)"

    # --- target cert dir + reload command ---
    case "$TGT" in
        # Route the renewal hook back through THIS script so the restart-vs-reload
        # fix lives in one place — acme.sh stores the string verbatim and replays it
        # on every unattended renewal for the life of the cert.
        nginx)    CERT_DIR_V="$NGINX_SSL/$DOMAIN_IN"; RELOAD_V="detour-cert _nginx-reload" ;;
        uhttpd)   CERT_DIR_V="$DETOUR_SSL"; RELOAD_V="/etc/init.d/uhttpd restart" ;;
        lighttpd) CERT_DIR_V="$DETOUR_SSL"; RELOAD_V="detour-cert _lighttpd-pem" ;;
    esac
    mkdir -p "$CERT_DIR_V" 2>/dev/null

    # --- issue (EC-256, Let's Encrypt) ---
    if ! "$ACME" --issue $LE_STAGING --server letsencrypt -d "$DOMAIN_IN" -w "$WEBROOT" \
            --keylength ec-256 >>"$LOG" 2>&1; then
        write_state error "ACME issuance failed — check $LOG (port 80 reachable for $DOMAIN_IN?)"
        log "issue FAILED for $DOMAIN_IN"; exit 1
    fi

    # --- persist config BEFORE install-cert (reloadcmd may read it, e.g. lighttpd) ---
    cat > "$CERT_CONF" <<EOF
DOMAIN='$DOMAIN_IN'
EMAIL='$EMAIL_IN'
TARGET_MODE='$TGT'
CERT_DIR='$CERT_DIR_V'
RELOAD_CMD='$RELOAD_V'
EOF
    chmod 0600 "$CERT_CONF" 2>/dev/null

    # --- install cert into the target + register the reload hook for renewals ---
    "$ACME" --install-cert --ecc -d "$DOMAIN_IN" \
        --fullchain-file "$CERT_DIR_V/fullchain.pem" \
        --key-file "$CERT_DIR_V/privkey.pem" \
        --reloadcmd "$RELOAD_V" >>"$LOG" 2>&1

    # --- one-time web-server TLS wiring for the self-served targets ---
    case "$TGT" in
        uhttpd)   configure_uhttpd  "$CERT_DIR_V" ;;
        lighttpd) configure_lighttpd "$CERT_DIR_V" ;;
        nginx)
            nginx_reload
            # Ensure SNI=<domain> on :443 actually serves this cert. A default :443
            # server (e.g. GL.iNet's) otherwise answers <domain> with its own cert and
            # the panel is unreachable over HTTPS. Add a managed routing vhost unless
            # the domain already serves its own cert (sleep: let workers finish reload).
            sleep 1
            if [ "$(serving_cn "$DOMAIN_IN")" != "$DOMAIN_IN" ]; then
                nginx_add_panel_vhost "$DOMAIN_IN" "$CERT_DIR_V" || \
                    log "could not install managed panel vhost for $DOMAIN_IN"
            fi
            ;;
    esac

    ensure_renewal
    write_state ok ""
    log "issue OK for $DOMAIN_IN (target=$TGT, dir=$CERT_DIR_V)"
    ;;

renew)
    ACME=$(find_acme) || { log "renew: acme.sh not found"; exit 1; }
    # Re-assert the challenge webroot BEFORE renewing. Issuance left one behind, but
    # ACME_WEBROOT lives under /var — a symlink to /tmp on OpenWrt — so a reboot
    # silently deletes it and every later renewal fails the HTTP-01 check with no
    # trace. prepare_webroot re-creates the dir and, if the :80 server still doesn't
    # serve it, reinstalls the managed nginx snippet.
    [ -f "$CERT_CONF" ] && . "$CERT_CONF" 2>/dev/null
    RENEW_RC=0
    WEBROOT=""
    [ -n "$DOMAIN" ] && WEBROOT=$(prepare_webroot "$DOMAIN" "$(http80_server)" 2>/dev/null)
    if [ -n "$WEBROOT" ]; then
        # prepare_webroot has guaranteed the live :80 serves the directory acme will
        # write to; --renew reloads the saved parameters, so -w here is belt-and-braces
        # (acme ignores it on a renewal) — the real work was making the two agree.
        "$ACME" --renew --ecc -d "$DOMAIN" -w "$WEBROOT" >>"$LOG" 2>&1 || RENEW_RC=$?
    else
        [ -n "$DOMAIN" ] && log "renew: no usable ACME webroot for $DOMAIN — falling back to acme cron"
        "$ACME" --cron >>"$LOG" 2>&1 || RENEW_RC=$?
    fi
    # acme.sh exits 2 for "skipped, not due yet" — a healthy no-op, not a failure.
    if [ "$RENEW_RC" = 0 ] || [ "$RENEW_RC" = 2 ]; then
        # Re-register the install hook when it has drifted. --renew replays the
        # reloadcmd saved at issue time and ignores one passed on the command line, so
        # a cert issued before the restart-vs-reload fix keeps running the useless
        # `nginx -s reload` forever; --install-cert is the only call that rewrites it.
        # Gate on an actual mismatch: --install-cert also RE-RUNS the hook, and doing
        # that unconditionally would bounce nginx on every scheduled renew check.
        if [ -n "$RELOAD_CMD" ] && [ -n "$CERT_DIR" ] && \
           [ "$(acme_reloadcmd "$DOMAIN")" != "$RELOAD_CMD" ]; then
            log "renew: refreshing stale install hook for $DOMAIN"
            "$ACME" --install-cert --ecc -d "$DOMAIN" \
                --fullchain-file "$CERT_DIR/fullchain.pem" \
                --key-file "$CERT_DIR/privkey.pem" \
                --reloadcmd "$RELOAD_CMD" >>"$LOG" 2>&1 || \
                log "renew: could not refresh the install hook for $DOMAIN"
        fi
        write_state ok ""
        log "renew run (rc=$RENEW_RC)"
    else
        # Never report success on a failed renewal: the panel's cert chip and the
        # "last_result" in the status modal are the ONLY place a silent expiry would
        # have shown up, and blanket-ok is why this went unnoticed for weeks.
        write_state error "renewal failed — see $LOG"
        log "renew FAILED"
        exit 1
    fi
    ;;

_nginx-reload)
    nginx_reload ;;

_lighttpd-pem)
    lighttpd_pem ;;

*)
    echo "usage: detour-cert {detect | issue <domain> <email> | renew | status}" >&2
    # _nginx-reload / _lighttpd-pem are internal hooks replayed by acme.sh — not
    # advertised here on purpose.
    exit 2 ;;
esac
